<Project>
    <!-- From the package FlowRate.Client.GStreamer.Runtime.@RID@: the GStreamer runtime of the FlowRate
         client for @RID@, put next to the executable as the client has it, in the 'gstreamer' folder
         GstNativeLibraryResolver looks in by default. The package carries no code.

         Generated by src/Scripts/bash/pack.sh from Client.GStreamer/Build/package/runtime.targets, with
         the RID in every name: a host may reference the packages of several RIDs, and each takes only
         the build of its own. A build without a RID is for the system it runs on. -->
    <PropertyGroup>
        <_FlowRateGStreamerRuntimeDir_@RID_NAME@>$(MSBuildThisFileDirectory)..\runtime\</_FlowRateGStreamerRuntimeDir_@RID_NAME@>
        <_FlowRateGStreamerRuntimeUsed_@RID_NAME@ Condition="'$(RuntimeIdentifier)' == '@RID@'">true</_FlowRateGStreamerRuntimeUsed_@RID_NAME@>
        <_FlowRateGStreamerRuntimeUsed_@RID_NAME@ Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('@OS@'))">true</_FlowRateGStreamerRuntimeUsed_@RID_NAME@>
    </PropertyGroup>

    <!-- Never part of a single-file bundle: GStreamer loads its plugins and gst-plugin-scanner from
         these paths -->
    <ItemGroup Condition="'$(_FlowRateGStreamerRuntimeUsed_@RID_NAME@)' == 'true'">
        <None Include="$(_FlowRateGStreamerRuntimeDir_@RID_NAME@)**" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="false"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>

    <!-- A package keeps no file modes, so the plugin scanner, which GStreamer starts as a process,
         comes out of it not executable. Made so after the copy; a build on Windows for Linux or macOS
         cannot, and its output needs chmod +x on the scanner where it runs. -->
    <Target Name="_FlowRateGStreamerScannerToOutput_@RID_NAME@" AfterTargets="CopyFilesToOutputDirectory"
            Condition="'$(_FlowRateGStreamerRuntimeUsed_@RID_NAME@)' == 'true' And '@SCANNER@' != '' And !$([MSBuild]::IsOSPlatform('Windows'))">
        <Exec Command="chmod +x &quot;$(OutDir)@SCANNER@&quot;" />
    </Target>

    <Target Name="_FlowRateGStreamerScannerToPublish_@RID_NAME@" AfterTargets="Publish"
            Condition="'$(_FlowRateGStreamerRuntimeUsed_@RID_NAME@)' == 'true' And '@SCANNER@' != '' And !$([MSBuild]::IsOSPlatform('Windows'))">
        <Exec Command="chmod +x &quot;$(PublishDir)@SCANNER@&quot;" />
    </Target>
</Project>
