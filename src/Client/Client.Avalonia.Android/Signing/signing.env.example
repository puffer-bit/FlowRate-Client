# Copy to signing.env in this folder, next to the keystore (neither goes into git), to sign every build of
# this project with the release key, from the IDE as well. One NAME=value per line, no quotes.
# ANDROID_KEYSTORE is relative to this folder or absolute.
ANDROID_KEYSTORE=release.keystore
ANDROID_KEY_ALIAS=flowrate
ANDROID_KEYSTORE_PASSWORD=
# Only when the key has a password of its own; the keystore password otherwise
#ANDROID_KEY_PASSWORD=
