<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <!-- Not Client.Android: inside the Client namespace that name would hide the Android SDK namespace -->
        <RootNamespace>Client.Droid</RootNamespace>
        <ApplicationId>com.flowrate.client</ApplicationId>
        <ApplicationVersion>2</ApplicationVersion>
        <ApplicationDisplayVersion>0.7.1</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!-- A Release build compiles ahead of time every method, not only those of the profile the SDK
         ships: that profile covers a generic app start, so the views, Avalonia and the rest ran on the
         Mono JIT, whose code is much slower. The .apk grows and the build takes longer.
         Phones only: x86_64 serves the emulator alone, and with the code compiled ahead of time it
         would double the .apk. A Debug build keeps it, for the emulator -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.2" />
        <PackageReference Include="Avalonia.Android" Version="12.1.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
        <PackageReference Include="Xamarin.Firebase.Core" Version="121.1.1.20" />
        <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
        <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" Version="116.1.0.17" />
    </ItemGroup>

    <!-- No Client.GStreamer or Client.OpenAL: they are built for the desktop. What the view models
         need of them is in the Platform folder -->
    <ItemGroup>
        <ProjectReference Include="..\Client.Api\Client.Api.csproj" />
        <ProjectReference Include="..\Client.Application\Client.Application.csproj" />
        <ProjectReference Include="..\Client.Avalonia.Assets\Client.Avalonia.Assets.csproj" />
        <ProjectReference Include="..\Client.Avalonia.Controls\Client.Avalonia.Controls.csproj" />
        <ProjectReference Include="..\Client.Avalonia.Localization\Client.Avalonia.Localization.csproj" />
        <ProjectReference Include="..\Client.Avalonia.Styles\Client.Avalonia.Styles.csproj" />
        <ProjectReference Include="..\Client.Avalonia.ViewModels\Client.Avalonia.ViewModels.csproj" />
        <ProjectReference Include="..\Client.Avalonia.Views.Common\Client.Avalonia.Views.Common.csproj" />
        <ProjectReference Include="..\Client.Avalonia.Views.Mobile\Client.Avalonia.Views.Mobile.csproj" />
        <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
        <ProjectReference Include="..\Client.Infrastructure\Client.Infrastructure.csproj" />
        <ProjectReference Include="..\Client.LibWebRTC\Client.LibWebRTC.csproj" />
        <ProjectReference Include="..\Client.Tools\Client.Tools.csproj" />
        <ProjectReference Include="..\Client.WebRTC\Client.WebRTC.csproj" />
    </ItemGroup>

    <!-- Voice: libwebrtc as Google builds it, unbound. Only the small class of ours in front of it is
         bound, which keeps the bindings clear of its whole API -->
    <ItemGroup>
        <!-- Rider marks AndroidMavenLibrary as an error, but the .NET Android build knows it -->
        <AndroidMavenLibrary Include="io.github.webrtc-sdk:android" Version="144.7559.15" Bind="false" />
        <AndroidJavaSource Include="Platform\Media\WebRTC\*.java" Bind="true" />
    </ItemGroup>

    <ItemGroup>
        <GoogleServicesJson Include="google-services.json" />
    </ItemGroup>

    <ItemGroup>
        <AndroidResource Include="..\Client.Avalonia.Assets\AppIcons\Headphones\Android\**\*">
            <Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </AndroidResource>
    </ItemGroup>
    
    <!-- The release key for any build, from the IDE as well: Signing/signing.env (not in git, see
         Signing/signing.env.example) with the variables publish.sh takes, and the keystore beside it.
         Properties given on the command line, as publish.sh and the CI give them, come before these.
         Without the file the debug key signs. -->
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/Signing/signing.env')">
        <_SigningEnv>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Signing/signing.env'))</_SigningEnv>
        <_SigningKeyStore>$([System.Text.RegularExpressions.Regex]::Match($(_SigningEnv), '(?m)^\s*ANDROID_KEYSTORE\s*=\s*(.*?)\s*$').Groups[1].Value)</_SigningKeyStore>
        <_SigningKeyAlias>$([System.Text.RegularExpressions.Regex]::Match($(_SigningEnv), '(?m)^\s*ANDROID_KEY_ALIAS\s*=\s*(.*?)\s*$').Groups[1].Value)</_SigningKeyAlias>
        <_SigningStorePass>$([System.Text.RegularExpressions.Regex]::Match($(_SigningEnv), '(?m)^\s*ANDROID_KEYSTORE_PASSWORD\s*=\s*(.*?)\s*$').Groups[1].Value)</_SigningStorePass>
        <_SigningKeyPass>$([System.Text.RegularExpressions.Regex]::Match($(_SigningEnv), '(?m)^\s*ANDROID_KEY_PASSWORD\s*=\s*(.*?)\s*$').Groups[1].Value)</_SigningKeyPass>
        <_SigningKeyPass Condition="'$(_SigningKeyPass)' == ''">$(_SigningStorePass)</_SigningKeyPass>

        <AndroidKeyStore>true</AndroidKeyStore>
        <!-- A relative path is from the Signing folder -->
        <AndroidSigningKeyStore>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), 'Signing', $(_SigningKeyStore)))</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>$(_SigningKeyAlias)</AndroidSigningKeyAlias>
        <AndroidSigningStorePass>$(_SigningStorePass)</AndroidSigningStorePass>
        <AndroidSigningKeyPass>$(_SigningKeyPass)</AndroidSigningKeyPass>
    </PropertyGroup>

    <Target Name="CheckSigningEnv" BeforeTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/Signing/signing.env')">
        <Error Condition="'$(_SigningKeyStore)' == '' Or '$(_SigningKeyAlias)' == '' Or '$(_SigningStorePass)' == ''"
               Text="signing.env needs ANDROID_KEYSTORE, ANDROID_KEY_ALIAS and ANDROID_KEYSTORE_PASSWORD (see Signing/signing.env.example)" />
        <Error Condition="!Exists('$(AndroidSigningKeyStore)')" Text="No keystore in $(AndroidSigningKeyStore), named in Signing/signing.env" />
    </Target>

    <!-- The time and the commit of the build, shown after the version -->
    <Import Project="..\BuildNumber.targets" />
</Project>
