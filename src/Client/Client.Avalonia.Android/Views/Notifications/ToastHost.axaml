<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:notificationVm="clr-namespace:Client.ViewModels.Notifications;assembly=Client.Avalonia.ViewModels"
             x:DataType="notificationVm:NotificationCenterVM"
             x:Class="Client.Droid.Views.Notifications.ToastHost">

    <!-- Cards at the top of the screen. A tap closes one, and so does a swipe to either side; one with
         actions waits for them -->
    <ItemsControl ItemsSource="{Binding Notifications}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="notificationVm:ToastVM">
                <Border Classes="toast"
                        MaxWidth="480"
                        Padding="12"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource FlyoutBorderBrush}"
                        Background="{DynamicResource FlyoutBackgroundBrush}"
                        BoxShadow="{DynamicResource FloatingButtonShadow}"
                        anim:Presence.Appear="Rise"
                        anim:Presence.Leave="Fade"
                        anim:Presence.IsLeaving="{Binding IsLeaving}"
                        AttachedToVisualTree="OnToastAttached"
                        Tapped="OnToastTapped">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <!-- The kind of the notification: its icon on a circle of its color -->
                        <Panel Grid.Column="0" Width="36" Height="36" VerticalAlignment="Top">
                            <Ellipse Classes="kind-tint"
                                     Classes.success="{Binding IsSuccess}"
                                     Classes.warning="{Binding IsWarning}"
                                     Classes.error="{Binding IsError}"/>
                            <Panel Width="20" Height="20">
                                <Image Source="{StaticResource IInCircleIcon}" IsVisible="{Binding IsInfo}"/>
                                <Image Source="{StaticResource MarkInCircleIcon}" IsVisible="{Binding IsSuccess}"/>
                                <Image Source="{StaticResource WarningIcon}" IsVisible="{Binding IsWarning}"/>
                                <Image Source="{StaticResource CrossInCircleIcon}" IsVisible="{Binding IsError}"/>
                            </Panel>
                        </Panel>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding Message}"
                                       IsVisible="{Binding HasMessage}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                            <!-- The actions share the width of the card -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0,10,0,0"
                                  IsVisible="{Binding HasActions}" IsEnabled="{Binding AreActionsEnabled}">
                                <Button Grid.Column="0" MinHeight="40"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding SecondaryCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Width="16" Height="16" VerticalAlignment="Center"
                                               IsVisible="{Binding SecondaryIconKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Source="{Binding SecondaryIconKey, Converter={x:Static converters:IconKeyConverter.Instance}}"/>
                                        <TextBlock Text="{Binding SecondaryLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="primary" MinHeight="40"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding PrimaryCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Width="16" Height="16" VerticalAlignment="Center"
                                               IsVisible="{Binding PrimaryIconKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Source="{Binding PrimaryIconKey, Converter={x:Static converters:IconKeyConverter.Instance}}"/>
                                        <TextBlock Text="{Binding PrimaryLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
