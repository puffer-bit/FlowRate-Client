<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             x:Class="Client.Droid.Views.Common.Media.CallAudioDevicePicker">
    <StackPanel Spacing="10">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{l:Text hybrid.audio.device}"/>
        <ComboBox x:Name="Devices" HorizontalAlignment="Stretch" MinHeight="48"
                  SelectionChanged="OnDeviceSelected"/>
        <TextBlock Text="{l:Text hybrid.audio.hint}" TextWrapping="Wrap" FontSize="13"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock x:Name="ActiveDevice" TextWrapping="Wrap" FontSize="13"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock x:Name="Switching" Text="{l:Text hybrid.audio.switching}" TextWrapping="Wrap"
                   FontSize="13" IsVisible="False"/>
        <TextBlock x:Name="Error" Text="{l:Text hybrid.audio.failed}" TextWrapping="Wrap"
                   FontSize="13" Foreground="{DynamicResource ErrorBrush}" IsVisible="False"/>
        <Button x:Name="Retry" Content="{l:Text hybrid.audio.retry}" Click="OnRetryClick"
                MinHeight="44" IsVisible="False"/>
    </StackPanel>
</UserControl>
