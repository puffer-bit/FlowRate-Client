<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:profileVm="clr-namespace:Client.ViewModels.Profile;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Droid.Views.ProfileView"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             x:DataType="profileVm:UserProfileWindowVM"
             Background="{DynamicResource GeneralBrush}">

    <UserControl.Styles>
        <!-- Buttons and the field tall enough for a finger -->
        <Style Selector="StackPanel.actions > Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, 1, *">

        <!-- Header: back to where the profile was opened from -->
        <Grid Grid.Row="0" Margin="4,8,12,8" ColumnDefinitions="Auto, *" ColumnSpacing="8">
            <Button Grid.Column="0" Classes="borderless"
                    Width="44" Height="44" Padding="0" CornerRadius="22"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Command="{Binding CloseCommand}">
                <!-- The arrow of the scroll-down button, turned to point back -->
                <Image Width="22" Height="22" Source="{StaticResource DownArrowIcon}" RenderTransform="rotate(90deg)"/>
            </Button>
            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                       Text="{l:Text main.profile.title}"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource DarkBackgroundBrush}"/>

        <ScrollViewer Grid.Row="2">
            <StackPanel Margin="20,24" Spacing="20">

                <!-- Avatar: our own can be replaced, the one of another user only reset -->
                <StackPanel Spacing="10" IsEnabled="{Binding !IsBusy}">
                    <avatars:UserAvatar Width="96" Height="96" HorizontalAlignment="Center"
                                        UserName="{Binding Username}"
                                        AvatarUrl="{Binding ShownAvatarUrl}"
                                        Source="{Binding AvatarPicker.Avatar}"
                                        Status="{Binding Status}"/>

                    <StackPanel Classes="actions" Spacing="10" IsVisible="{Binding IsEditing}">
                        <Button Command="{Binding AvatarPicker.ChooseAvatarCommand}"
                                IsVisible="{Binding IsCurrentUser}">
                            <TextBlock Text="{l:Text profile.avatar.chooseImage}"/>
                        </Button>

                        <Button Command="{Binding ResetAvatarCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Width="16" Height="16" Source="{StaticResource ResetIcon}" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center" Text="{l:Text profile.avatar.reset}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Classes="hint" TextAlignment="Center" Text="{l:Text profile.avatar.resetsOnSave}"
                               IsVisible="{Binding IsAvatarReset}"/>

                    <TextBlock Classes="fieldError" TextAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding AvatarPicker.AvatarError}"
                               IsVisible="{Binding AvatarPicker.AvatarError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>

                <!-- Name -->
                <StackPanel Spacing="6" IsEnabled="{Binding !IsBusy}">
                    <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.name}"/>

                    <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{Binding Username}"
                               IsVisible="{Binding !IsEditing}"/>

                    <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
                        <TextBox x:Name="NameInput"
                                 PlaceholderText="{l:Text profile.name.short}"
                                 Text="{Binding Name}"
                                 Classes.invalid="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="fieldError" Text="{Binding NameError}"
                                   IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="hint" Text="{Binding NameHint}"
                                   IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNull}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connections -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.firstConnected}"/>
                    <TextBlock Text="{Binding FirstConnected}"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.lastConnected}"/>
                    <TextBlock Text="{Binding LastConnected}"/>
                </StackPanel>

                <!-- Roles: those the user has, and those the current user may give; a tap gives or takes -->
                <StackPanel Spacing="6" IsVisible="{Binding HasRoles}">
                    <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.roles}"/>
                    <ItemsControl ItemsSource="{Binding Roles}" IsEnabled="{Binding !IsChangingRole}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="profileVm:UserRoleVM">
                                <CheckBox IsChecked="{Binding IsAssigned, Mode=OneWay}"
                                          IsEnabled="{Binding CanChange}"
                                          Command="{Binding $parent[ItemsControl].((profileVm:UserProfileWindowVM)DataContext).ToggleRoleCommand}"
                                          CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                                 Fill="{DynamicResource SecondaryTextBrush}"
                                                 IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNull}}"/>
                                        <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={x:Static converters:RoleColorConverter.Instance}}"
                                                 IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="fieldError" TextWrapping="Wrap" Text="{Binding RoleError}"
                               IsVisible="{Binding RoleError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>

                <TextBlock FontSize="14" FontWeight="SemiBold"
                           Text="{Binding UserId, StringFormat='ID: {0}'}"/>

                <!-- Viewing -->
                <StackPanel Classes="actions" Margin="0,4,0,0" IsVisible="{Binding !IsEditing}">
                    <Button Classes="primary" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="16" Height="16" Source="{StaticResource PencilIcon}" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" Text="{l:Text common.edit}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Editing -->
                <StackPanel Classes="actions" Margin="0,4,0,0" Spacing="10" IsVisible="{Binding IsEditing}">
                    <Button Classes="primary" Command="{Binding SaveCommand}">
                        <Panel>
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsBusy}">
                                <Image Width="16" Height="16" Source="{StaticResource DisketteIcon}" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center" Text="{l:Text common.save}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                                <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                                IsIndeterminate="True" BorderThickness="2"
                                                                Foreground="{DynamicResource OnAccentTextBrush}"/>
                                <TextBlock VerticalAlignment="Center" Text="{l:Text common.saving}"/>
                            </StackPanel>
                        </Panel>
                    </Button>

                    <Button Command="{Binding CancelEditCommand}">
                        <TextBlock Text="{l:Text common.cancel}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
