<UserControl xmlns:images="clr-namespace:Client.Avalonia.Controls.Images;assembly=Client.Avalonia.Controls"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:releaseText="clr-namespace:Client.Avalonia.Controls.Text;assembly=Client.Avalonia.Controls"
             xmlns:pagesVm="clr-namespace:Client.ViewModels.Settings.Pages;assembly=Client.Avalonia.ViewModels"
             xmlns:settingsVm="clr-namespace:Client.ViewModels.Settings;assembly=Client.Avalonia.ViewModels"
             xmlns:services="clr-namespace:Client.Services;assembly=Client.Avalonia.ViewModels"
             xmlns:models="clr-namespace:Client.Core.Settings;assembly=Client.Core"
             xmlns:controls="clr-namespace:Client.Avalonia.Controls;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:ui="clr-namespace:Client.Avalonia.Controls.Settings;assembly=Client.Avalonia.Controls"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             xmlns:views="clr-namespace:Client.Droid.Views"
             x:Class="Client.Droid.Views.SettingsView"
             Background="{DynamicResource GeneralBrush}">

    <UserControl.Resources>
        <converters:MaskedIdentityConverter x:Key="MaskedIdentityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- A category of the list: its icon, its name and an arrow into it; tall enough for a finger -->
        <Style Selector="Button.category">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.category TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- A category that cannot be opened reads as secondary text, without the grey fill of Fluent -->
        <Style Selector="Button.category:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.category:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style Selector="Button.category.danger TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        </Style>
        <Style Selector="Border.category-icon">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.category-icon > Image">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <!-- A sub-item of the category above it, which leads to a section of its page: lower, without an
             icon and in secondary text, set in by a line under the icon of the category -->
        <Style Selector="Button.category.sub">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="4,6,12,6"/>
        </Style>
        <Style Selector="Button.category.sub TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <!-- A straight line down the sub-items -->
        <Style Selector="Path.sub-item-guide">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Data" Value="M 32,0 L 32,60"/>
            <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Path.sub-item-guide.last">
            <Setter Property="Data" Value="M 32,0 L 32,44"/>
        </Style>
        <Style Selector="Path.category-arrow">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Data" Value="M0,0 L5,5 L0,10"/>
            <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>

        <!-- The list of categories, with the room a page has around its settings -->
        <Style Selector="StackPanel.page">
            <Setter Property="Margin" Value="12,16,12,24"/>
            <Setter Property="Spacing" Value="12"/>
        </Style>
        <!-- The same room around the settings of a page; its sections fold at a tap on their header, as on the desktop -->
        <Style Selector="ui|SettingsPage /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Margin" Value="12,16,12,24"/>
        </Style>
        <Style Selector="TextBlock.empty">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <!-- The row title is the label of a switch, so it has no words of its own -->
        <Style Selector="ui|SettingsRow ToggleSwitch">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="OnContent" Value="{x:Null}"/>
            <Setter Property="OffContent" Value="{x:Null}"/>
        </Style>
        <Style Selector="ui|SettingsRow > ComboBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ui|SettingsRow > Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- A fact about the application, on the right of what it is -->
        <Style Selector="ui|SettingsRow TextBlock.value">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <!-- Each library is alone in the container of its item, so its row cannot tell that rows stand above it -->
        <Style Selector="ContentPresenter:nth-child(n+2) > ui|SettingsRow /template/ Border#separator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Listens to a sound of the list -->
        <Style Selector="Button.listen">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- A saved server or a trusted certificate -->
        <Style Selector="TextBlock.detail">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.detail.label">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style Selector="Button.forget">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.releaseAction:pointerover /template/ ContentPresenter, Button.releaseAction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
        </Style>
        <Style Selector="Expander.releaseNote /template/ ToggleButton /template/ ContentPresenter, Expander.releaseNote /template/ ToggleButton:checked /template/ ContentPresenter, Expander.releaseNote /template/ ToggleButton:pointerover /template/ ContentPresenter, Expander.releaseNote /template/ ToggleButton:pressed /template/ ContentPresenter, Expander.releaseNote /template/ ToggleButton:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Expander.releaseNote /template/ ToggleButton:pointerover /template/ Border#ToggleButtonBackground, Expander.releaseNote /template/ ToggleButton:checked:pointerover /template/ Border#ToggleButtonBackground, Expander.releaseNote /template/ ToggleButton:pressed /template/ Border#ToggleButtonBackground, Expander.releaseNote /template/ ToggleButton:checked:pressed /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBorderBrush}"/>
        </Style>
        <Style Selector="Expander.releaseNote /template/ ToggleButton:pointerover /template/ Border#ExpandCollapseChevronBorder, Expander.releaseNote /template/ ToggleButton:checked:pointerover /template/ Border#ExpandCollapseChevronBorder, Expander.releaseNote /template/ ToggleButton:pressed /template/ Border#ExpandCollapseChevronBorder, Expander.releaseNote /template/ ToggleButton:checked:pressed /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, 1, *">

        <!-- Header: back to the list of categories, or out of the settings from the list itself -->
        <Grid Grid.Row="0" Margin="4,8,12,8" ColumnDefinitions="Auto, *" ColumnSpacing="8">
            <Button Grid.Column="0" x:Name="BackButton"
                    Classes="borderless"
                    Width="44" Height="44" Padding="0" CornerRadius="22"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnBackClick">
                <!-- The arrow of the scroll-down button, turned to point back -->
                <Image Width="22" Height="22" Source="{StaticResource DownArrowIcon}" RenderTransform="rotate(90deg)"/>
            </Button>

            <Panel Grid.Column="1" x:Name="HeaderArea">
                <!-- "Settings", or the name of the page that is open. It fades away under the search as that widens -->
                <TextBlock x:Name="TitleText"
                           FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                    <TextBlock.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="{anim:Motion Short}" Easing="{anim:Ease Standard}"/>
                        </Transitions>
                    </TextBlock.Transitions>
                </TextBlock>

                <!-- The search of the list of categories: typing swaps the categories for the settings
                     that match, as on the desktop. It stands beside the title until it is focused or
                     typed in, and then grows from the right edge over the whole header; the code
                     sets the width, which is animated here -->
                <TextBox x:Name="SearchBox"
                         Width="150" MinHeight="40"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         PlaceholderText="{l:Text settings.search.placeholder}"
                         TextChanged="OnSearchTextChanged"
                         GotFocus="OnSearchFocusChanged"
                         LostFocus="OnSearchFocusChanged">
                    <TextBox.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="{anim:Motion Medium}" Easing="{anim:Ease Standard}"/>
                        </Transitions>
                    </TextBox.Transitions>
                    <TextBox.InnerLeftContent>
                        <Image Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center"
                               Source="{StaticResource FindIcon}"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Panel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource DarkBackgroundBrush}"/>

        <!-- ====== The list of categories ====== -->
        <ScrollViewer Grid.Row="2" x:Name="Categories" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="page">
                <StackPanel x:Name="CategoryList" Spacing="12">
                    <ui:SettingsCard>
                        <Button Classes="borderless category" Click="OnAppearanceClick">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="category-icon">
                                    <Image Source="{StaticResource PaintRollerIcon}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l:Text settings.appearance.name}"/>
                                <Path Grid.Column="2" Classes="category-arrow"/>
                            </Grid>
                        </Button>

                        <Button Classes="borderless category" Click="OnBehaviorClick">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="category-icon">
                                    <Image Source="{StaticResource LightningIcon}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l:Text settings.behavior.name}"/>
                                <Path Grid.Column="2" Classes="category-arrow"/>
                            </Grid>
                        </Button>

                        <Button Classes="borderless category" Click="OnAudioClick">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="category-icon">
                                    <Image Source="{StaticResource VoiceIcon}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l:Text settings.audio.name}"/>
                                <Path Grid.Column="2" Classes="category-arrow"/>
                            </Grid>
                        </Button>

                        <Button Classes="borderless category" Click="OnStorageClick">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="category-icon">
                                    <Image Source="{StaticResource StorageIcon}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l:Text settings.storage.name}"/>
                                <Path Grid.Column="2" Classes="category-arrow"/>
                            </Grid>
                        </Button>

                        <Button Classes="borderless category" Click="OnAccountingClick">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="category-icon">
                                    <Image Source="{StaticResource ShieldedUser}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l:Text settings.accounting.name}"/>
                                <Path Grid.Column="2" Classes="category-arrow"/>
                            </Grid>
                        </Button>

                        <Button Classes="borderless category" Click="OnDebugClick">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="category-icon">
                                    <Image Source="{StaticResource DebugIcon}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l:Text settings.debug.name}"/>
                                <Path Grid.Column="2" Classes="category-arrow"/>
                            </Grid>
                        </Button>

                        <!-- Its sub-items, as DebugAndLogsControlVM.Anchors: they lead to the sections of its
                             page and are set in by a line under its icon -->
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Grid.Column="0" Classes="sub-item-guide"/>
                                <Button Grid.Column="1" Classes="borderless category sub" Tag="debug.journal" Click="OnDebugAnchorClick">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="{l:Text settings.debug.section.journal}"/>
                                        <Path Grid.Column="1" Classes="category-arrow"/>
                                    </Grid>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Grid.Column="0" Classes="sub-item-guide last"/>
                                <Button Grid.Column="1" Classes="borderless category sub" Tag="debug.mediaOverlay" Click="OnDebugAnchorClick">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="{l:Text settings.debug.anchors.media}"/>
                                        <Path Grid.Column="1" Classes="category-arrow"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Has no settings yet, as on the desktop: listed, but cannot be opened -->
                        <Button Classes="borderless category" IsEnabled="False">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="category-icon">
                                    <Image Source="{StaticResource AndroidIcon}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l:Text settings.platform.name}"/>
                            </Grid>
                        </Button>
                    </ui:SettingsCard>

                    <!-- Red: it cannot be undone -->
                    <ui:SettingsCard>
                        <Button Classes="borderless category danger" Click="OnResetClick">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="category-icon">
                                    <Image Source="{StaticResource ResetIcon}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l:Text settings.reset}"/>
                            </Grid>
                        </Button>
                    </ui:SettingsCard>

                    <!-- Not settings, so it stands apart and closes the list -->
                    <ui:SettingsCard>
                        <Button Classes="borderless category" Click="OnAboutClick">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="category-icon">
                                    <Image Source="{StaticResource IInCircleIcon}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l:Text settings.about.name}"/>
                                <Path Grid.Column="2" Classes="category-arrow"/>
                            </Grid>
                        </Button>
                    </ui:SettingsCard>
                </StackPanel>

                <!-- What the search has found: a tap opens the page of the setting and shows it there -->
                <ItemsControl x:Name="SearchResults" IsVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settingsVm:SettingSearchResultVM">
                            <Button Classes="borderless category" Click="OnSearchResultClick">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="Medium" Text="{Binding Title}"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding Path}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="NothingFound" Classes="empty" IsVisible="False"
                           Text="{l:Text settings.search.nothingFound}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ====== Appearance: without the scale and the colors, which are picked with desktop controls ====== -->
        <ui:SettingsPage Grid.Row="2" x:Name="AppearancePage" IsVisible="False"
                         x:DataType="pagesVm:AppearanceControlVM">
            <controls:SettingsHeader services:SettingText.Section="appearance.language"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="appearance.language" ContentPlacement="Below">
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="pagesVm:LanguageOption">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name^}" VerticalAlignment="Center"/>
                                    <!-- Tells that no speaker of the language has checked the texts -->
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                                IsVisible="{Binding IsMachineTranslated}">
                                        <Image Width="14" Height="14" Source="{StaticResource SparklesIcon}"/>
                                        <TextBlock Text="{l:Text settings.appearance.language.aiTranslated}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ui:SettingsRow>
            </ui:SettingsCard>

            <controls:SettingsHeader services:SettingText.Section="appearance.theme"/>
            <!-- Cards with a miniature of the application in each theme, as on the desktop -->
            <views:ThemePresetPicker ui:SettingsPage.SearchKey="appearance.theme"/>

            <controls:SettingsHeader services:SettingText.Section="appearance.animations"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="appearance.animations">
                    <ToggleSwitch IsChecked="{Binding IsAnimationEnabled}"/>
                </ui:SettingsRow>
                <!-- The speed only matters while there is something to speed up -->
                <ui:SettingsRow services:SettingText.Key="appearance.animationSpeed" ContentPlacement="Below"
                                IsExpanded="{Binding IsAnimationEnabled}">
                    <!-- Items are in the order of AnimationSpeed -->
                    <ComboBox SelectedIndex="{Binding AnimationSpeedIndex}">
                        <ComboBoxItem Content="{l:Text settings.appearance.animationSpeed.slow}"/>
                        <ComboBoxItem Content="{l:Text settings.appearance.animationSpeed.normal}"/>
                        <ComboBoxItem Content="{l:Text settings.appearance.animationSpeed.fast}"/>
                    </ComboBox>
                </ui:SettingsRow>
            </ui:SettingsCard>
        </ui:SettingsPage>

        <!-- ====== Behavior: without the tray, which Android does not have ====== -->
        <ui:SettingsPage Grid.Row="2" x:Name="BehaviorPage" IsVisible="False"
                         x:DataType="pagesVm:BehaviorControlVM">
            <controls:SettingsHeader services:SettingText.Section="behavior.autoConnection"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="behavior.autoConnect">
                    <ToggleSwitch IsChecked="{Binding IsAutoConnectedEnabled}"/>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="behavior.server"
                            IsExpanded="{Binding IsAutoConnectedEnabled}"
                            IsEnabled="{Binding IsAutoConnectedEnabled}">
                <ComboBox Width="180" HorizontalAlignment="Right"
                          PlaceholderText="{l:Text settings.behavior.server.placeholder}"
                          ItemsSource="{Binding SavedServers}"
                          SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                    <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="models:SavedCoordinatorModel">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Image Width="20" Height="20" Source="{StaticResource PlanetIcon}"/>
                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                </Panel>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SavedCoordinatorModel">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                <Image Width="24" Height="24" VerticalAlignment="Center" Source="{StaticResource PlanetIcon}"/>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}"
                                               IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Classes="hint"><Run Text="{Binding Address}"/><Run Text=":"/><Run Text="{Binding Port}"/></TextBlock>
                                    <TextBlock Classes="hint" Text="{Binding CoordinatorId}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="behavior.identity"
                            IsExpanded="{Binding IsAutoConnectedEnabled}"
                            IsEnabled="{Binding IsAutoConnectedEnabled}">
                <ComboBox Width="180" HorizontalAlignment="Right"
                          PlaceholderText="{l:Text settings.behavior.identity.placeholder}"
                          ItemsSource="{Binding Identities}"
                          SelectedItem="{Binding SelectedIdentity, Mode=TwoWay}">
                    <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="models:SavedUserModel">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <avatars:UserAvatar Width="22" Height="22" UserName="{Binding Username}"
                                                    Coordinator="{Binding CoordinatorId}" AvatarUrl="{Binding AvatarUrl}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectionLabel}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SavedUserModel">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                    <avatars:UserAvatar Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center"
                                                        UserName="{Binding Username}"
                                                        Coordinator="{Binding CoordinatorId}"
                                                        AvatarUrl="{Binding AvatarUrl}"/>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Text="{Binding SelectionLabel}"/>
                                        <!-- Show only the edges of the credential to distinguish saved identities. -->
                                        <TextBlock Classes="hint" TextWrapping="NoWrap"
                                                   Text="{Binding UserIdentity, Converter={StaticResource MaskedIdentityConverter}}"
                                                   IsVisible="{Binding UserIdentity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                </ComboBox>
            </ui:SettingsRow>
            </ui:SettingsCard>

            <controls:SettingsHeader services:SettingText.Section="behavior.manualConnection"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="behavior.fallbackServers">
                    <ToggleSwitch IsChecked="{Binding IsAutoConnectedToFallbackServersEnabled}"/>
                </ui:SettingsRow>
                <!-- The warnings only matter while fallback servers are allowed, and are folded away otherwise -->
                <ui:SettingsRow services:SettingText.Key="behavior.fallbackWarning"
                                IsExpanded="{Binding IsAutoConnectedToFallbackServersEnabled}">
                    <ToggleSwitch IsChecked="{Binding IsFallbackConnectionWarningEnabled}"/>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="behavior.propagatedWarning"
                                IsExpanded="{Binding IsAutoConnectedToFallbackServersEnabled}">
                    <ToggleSwitch IsChecked="{Binding IsPropagatedConnectionWarningEnabled}"/>
                </ui:SettingsRow>
            </ui:SettingsCard>
        </ui:SettingsPage>

        <!-- Voice routing and the sounds of the interface. -->
        <ui:SettingsPage Grid.Row="2" x:Name="AudioPage" IsVisible="False"
                         x:DataType="pagesVm:AudioControlVM">
            <ui:SettingsCard>
                <views:CallAudioDevicePicker Margin="12"/>
            </ui:SettingsCard>
            <controls:SettingsHeader services:SettingText.Section="audio.sounds"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="audio.soundsEnabled">
                    <ToggleSwitch IsChecked="{Binding AreSoundsEnabled}"/>
                </ui:SettingsRow>
                <!-- The volume and the list only matter while the sounds are played, and are folded away otherwise -->
                <ui:SettingsRow services:SettingText.Key="audio.soundsVolume" ContentPlacement="Below"
                                IsExpanded="{Binding AreSoundsEnabled}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <Slider Grid.Column="0" VerticalAlignment="Center"
                                Minimum="{Binding MinSoundsVolumePercent}"
                                Maximum="{Binding MaxSoundsVolumePercent}"
                                Value="{Binding SoundsVolumePercent}"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right"
                                   Text="{Binding SoundsVolumePercent, StringFormat={}{0:0}%}"/>
                    </Grid>
                </ui:SettingsRow>
                <!-- Every sound of the desktop, also the ones nothing makes here yet -->
                <ui:SettingsRow services:SettingText.Key="audio.soundEvents" ContentPlacement="Below"
                                IsExpanded="{Binding AreSoundsEnabled}">
                    <ItemsControl ItemsSource="{Binding Sounds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pagesVm:SoundItemVM">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" MinHeight="48">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Text="{Binding Title}"/>
                                    <Button Grid.Column="1" Classes="borderless listen"
                                            Command="{Binding PlayCommand}">
                                        <Image Width="18" Height="18" Source="{StaticResource PlayIcon}"/>
                                    </Button>
                                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:SettingsRow>
            </ui:SettingsCard>
        </ui:SettingsPage>

        <!-- ====== Servers and security: without the database encryption, which is not implemented anywhere yet ====== -->
        <!-- ====== Data and storage: what of the chats is kept on the phone ====== -->
        <ui:SettingsPage Grid.Row="2" x:Name="StoragePage" IsVisible="False"
                         x:DataType="pagesVm:StorageControlVM">
            <controls:SettingsHeader services:SettingText.Section="storage.messages"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="storage.keepMessages">
                    <ToggleSwitch IsChecked="{Binding IsChatCacheEnabled}"/>
                </ui:SettingsRow>
                <!-- How much is kept only matters while messages are kept, and is folded away otherwise -->
                <ui:SettingsRow services:SettingText.Key="storage.messagesPerChat"
                                IsExpanded="{Binding IsChatCacheEnabled}">
                    <ComboBox MinWidth="110" ItemsSource="{Binding ChatCacheMessageChoices}"
                              SelectedIndex="{Binding ChatCacheMessagesIndex}"/>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="storage.clearMessages"
                                IsExpanded="{Binding IsChatCacheEnabled}">
                    <StackPanel Spacing="4" HorizontalAlignment="Right">
                        <Button HorizontalAlignment="Right"
                                Command="{Binding ClearChatCacheCommand}" Content="{l:Text common.clear}"/>
                        <TextBlock FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding ChatCacheUsageText}"/>
                    </StackPanel>
                </ui:SettingsRow>
            </ui:SettingsCard>

            <controls:SettingsHeader services:SettingText.Section="storage.media"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="storage.mediaLimit">
                    <ComboBox MinWidth="110" ItemsSource="{Binding MediaCacheLimitChoices}"
                              SelectedIndex="{Binding MediaCacheLimitIndex}"/>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="storage.clearMedia">
                    <StackPanel Spacing="4" HorizontalAlignment="Right">
                        <Button HorizontalAlignment="Right"
                                Command="{Binding ClearMediaCacheCommand}" Content="{l:Text common.clear}"/>
                        <TextBlock FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding MediaCacheUsageText}"/>
                    </StackPanel>
                </ui:SettingsRow>
            </ui:SettingsCard>

            <controls:SettingsHeader services:SettingText.Section="storage.logs" IsVisible="{Binding HasLogFiles}"/>
            <ui:SettingsCard IsVisible="{Binding HasLogFiles}">
                <ui:SettingsRow services:SettingText.Key="storage.files" IsVisible="{Binding HasLogFiles}">
                    <StackPanel Spacing="4" HorizontalAlignment="Right">
                        <Button HorizontalAlignment="Right"
                                Command="{Binding ClearLogFilesCommand}" Content="{l:Text common.clear}"/>
                        <TextBlock FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding LogFilesText}"/>
                    </StackPanel>
                </ui:SettingsRow>
            </ui:SettingsCard>
        </ui:SettingsPage>

        <!-- ====== Logging and debug: the journal and the log of libwebrtc, then the statistics of the
             media; the phone has no GStreamer, and its folder of the journal is the application's own ====== -->
        <ui:SettingsPage Grid.Row="2" x:Name="DebugPage" IsVisible="False"
                         x:DataType="pagesVm:DebugAndLogsControlVM">
            <controls:SettingsHeader services:SettingText.Section="debug.journal"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="debug.level">
                    <!-- The order of DebugAndLogsControlVM.JournalLevels, after the level of the build -->
                    <ComboBox Width="160" SelectedIndex="{Binding JournalLevelIndex}">
                        <ComboBoxItem Content="{l:Text settings.debug.levels.default}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.verbose}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.debug}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.information}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.warning}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.error}"/>
                    </ComboBox>
                </ui:SettingsRow>
                <!-- The order of NativeLogLevel -->
                <ui:SettingsRow services:SettingText.Key="debug.libwebrtc" IsVisible="{Binding HasLibWebRTCLog}">
                    <ComboBox Width="160" SelectedIndex="{Binding LibWebRTCLogLevelIndex}">
                        <ComboBoxItem Content="{l:Text settings.debug.levels.off}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.error}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.warning}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.information}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.debug}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.levels.verbose}"/>
                    </ComboBox>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="debug.mediaPerfJournal">
                    <!-- The order of MediaPerfJournalMode -->
                    <ComboBox Width="160" SelectedIndex="{Binding MediaPerfJournalIndex}">
                        <ComboBoxItem Content="{l:Text settings.debug.levels.off}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfJournal.summary}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfJournal.detailed}"/>
                    </ComboBox>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="debug.mediaPerfSummary" IsEnabled="{Binding IsMediaJournalOn}">
                    <!-- DebugSettings.MediaPerfSummaryPeriods -->
                    <ComboBox Width="160" SelectedIndex="{Binding MediaPerfSummaryIndex}">
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfSummary.five}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfSummary.ten}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfSummary.thirty}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfSummary.sixty}"/>
                    </ComboBox>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="debug.mediaPerfAnomalies">
                    <ToggleSwitch IsChecked="{Binding LogMediaPerfAnomalies}"/>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="debug.writeToFiles" IsVisible="{Binding HasLogFiles}">
                    <ToggleSwitch IsChecked="{Binding WriteToFiles}"/>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="debug.archive">
                    <StackPanel Spacing="4" HorizontalAlignment="Right">
                        <Button HorizontalAlignment="Right"
                                Command="{Binding SaveArchiveCommand}" Content="{l:Text settings.debug.archive.save}"/>
                        <TextBlock FontSize="12" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="200"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding ArchiveText}"/>
                    </StackPanel>
                </ui:SettingsRow>
            </ui:SettingsCard>

            <controls:SettingsHeader services:SettingText.Section="debug.mediaOverlay"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="debug.mediaPerfOverlay">
                    <!-- The order of MediaPerfOverlayMode -->
                    <ComboBox MinWidth="110" SelectedIndex="{Binding MediaPerfOverlayIndex}">
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfOverlay.off}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfOverlay.all}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfOverlay.expanded}"/>
                    </ComboBox>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="debug.mediaPerfExpanded" IsEnabled="{Binding IsOverlayShown}">
                    <ToggleSwitch IsChecked="{Binding IsMediaPerfExpanded}"/>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="debug.mediaPerfSections" IsEnabled="{Binding IsOverlayShown}">
                    <StackPanel Spacing="2" HorizontalAlignment="Right">
                        <CheckBox IsChecked="{Binding ShowNetworkSection}" Content="{l:Text settings.debug.mediaPerfSections.network}"/>
                        <CheckBox IsChecked="{Binding ShowTransportSection}" Content="{l:Text settings.debug.mediaPerfSections.transport}"/>
                        <CheckBox IsChecked="{Binding ShowCodecSection}" Content="{l:Text settings.debug.mediaPerfSections.codec}"/>
                        <CheckBox IsChecked="{Binding ShowRenderSection}" Content="{l:Text settings.debug.mediaPerfSections.render}"/>
                        <CheckBox IsChecked="{Binding ShowAudioSection}" Content="{l:Text settings.debug.mediaPerfSections.audio}"/>
                    </StackPanel>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="debug.mediaPerfInterval">
                    <!-- DebugSettings.MediaPerfIntervals -->
                    <ComboBox MinWidth="110" SelectedIndex="{Binding MediaPerfIntervalIndex}">
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfInterval.half}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfInterval.one}"/>
                        <ComboBoxItem Content="{l:Text settings.debug.mediaPerfInterval.two}"/>
                    </ComboBox>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="debug.mediaPerfGraphs" IsEnabled="{Binding IsOverlayShown}">
                    <ToggleSwitch IsChecked="{Binding ShowMediaPerfGraphs}"/>
                </ui:SettingsRow>
            </ui:SettingsCard>

        </ui:SettingsPage>

        <ui:SettingsPage Grid.Row="2" x:Name="AccountingPage" IsVisible="False"
                         x:DataType="pagesVm:AccountingControlVM">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
            <controls:SettingsHeader services:SettingText.Section="accounting.savedServers" ui:SettingsPage.SearchKey="accounting.savedServers"/>
            <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,4" CornerRadius="12"
                    Background="{DynamicResource SettingsCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Source="{StaticResource ServerIcon}"/>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding ServersPage.CountText}"/>
                </StackPanel>
            </Border>
            <TextBox Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Classes="search"
                     PlaceholderText="{l:Text settings.accounting.searchServers}" Text="{Binding ServersPage.Filter}"/>
        </Grid>
        <TextBlock Text="{Binding ServersPage.RangeText}" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding ServersPage.HasItems}"/>
        <TextBlock Text="{l:Text settings.accounting.noMatches}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding ServersPage.HasNoMatches}"/>
            <TextBlock Classes="empty"
                       IsVisible="{Binding !CoordinatorSessions.Count}"
                       Text="{l:Text settings.accounting.noServers}"/>
            <ItemsControl ItemsSource="{Binding ServersPage.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SavedCoordinatorModel">
                        <ui:SettingsCard Padding="12">
                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                                <Image Grid.Row="0" Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center"
                                       Source="{StaticResource ServerIcon}"/>

                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name, Converter={x:Static services:TextOrDefaultConverter.Instance}, ConverterParameter=settings.accounting.unnamedServer}"/>
                                    <TextBlock Classes="detail label" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                <Binding Path="Address"/>
                                                <Binding Path="Port"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="2" Classes="borderless forget"
                                        Command="{Binding #AccountingPage.((pagesVm:AccountingControlVM)DataContext).DeleteCoordinatorCommand}"
                                        CommandParameter="{Binding}">
                                    <Image Width="20" Height="20" Source="{StaticResource TrashIcon}"/>
                                </Button>

                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                           Classes="detail label" FontStyle="Italic"
                                           IsVisible="{Binding !Users.Count}"
                                           Text="{l:Text settings.accounting.noAccounts}"/>

                                <!-- Saved accounts, aligned with the server name -->
                                <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                              IsVisible="{Binding !!Users.Count}"
                                              ItemsSource="{Binding Users}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SavedUserModel">
                                            <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="8">
                                                <Image Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                                                       Source="{StaticResource UserIcon}"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Username}"/>
                                                <!-- The identity is a credential: only its edges are shown, to tell accounts apart -->
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding UserIdentity, Converter={StaticResource MaskedIdentityConverter}}"/>
                                            <Button Grid.Column="3" Classes="borderless" VerticalAlignment="Center"
                                                    ToolTip.Tip="{l:Text settings.accounting.identityActions}"
                                                    AutomationProperties.Name="{l:Text settings.accounting.identityActions}">
                                                <Image Width="16" Height="16" Source="{StaticResource MoreIcon}"/>
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedRight">
                                                        <StackPanel Spacing="2" x:DataType="models:SavedUserModel">
                                                            <menus:MenuItemButton Classes="danger" Icon="{StaticResource TrashIcon}"
                                                                                  Content="{l:Text common.delete}"
                                                                                  Command="{Binding #AccountingPage.((pagesVm:AccountingControlVM)DataContext).DeleteIdentityCommand}"
                                                                                  CommandParameter="{Binding}"
                                                                                  menus:FlyoutMenu.CloseOnClick="True"/>
                                                            <menus:MenuItemButton Icon="{StaticResource QrCodeIcon}"
                                                                                  Content="{l:Text settings.accounting.exportIdentityQr}"
                                                                                  IsEnabled="{Binding UserIdentity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <menus:MenuItemButton.Flyout>
                                                                    <Flyout Placement="RightEdgeAlignedTop">
                                                                        <StackPanel Spacing="8" Margin="8" MaxWidth="260">
                                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Username}" TextTrimming="CharacterEllipsis"/>
                                                                            <images:QrCode Width="240" Height="240" Text="{Binding UserIdentity}"/>
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </menus:MenuItemButton.Flyout>
                                                            </menus:MenuItemButton>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ui:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,0"
              IsVisible="{Binding ServersPage.HasMultiplePages}">
            <Button Content="{l:Text serverSettings.users.previousPage}" Command="{Binding ServersPage.PreviousPageCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding ServersPage.PageText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <Button Grid.Column="2" Content="{l:Text serverSettings.users.nextPage}" Command="{Binding ServersPage.NextPageCommand}"/>
        </Grid>

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
            <controls:SettingsHeader services:SettingText.Section="accounting.trustedCertificates" ui:SettingsPage.SearchKey="accounting.trustedCertificates"/>
            <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,4" CornerRadius="12"
                    Background="{DynamicResource SettingsCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Width="14" Height="14" Source="{StaticResource KeyIcon}"/>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding CertificatesPage.CountText}"/>
                </StackPanel>
            </Border>
            <TextBox Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Classes="search"
                     PlaceholderText="{l:Text settings.accounting.searchCertificates}" Text="{Binding CertificatesPage.Filter}"/>
        </Grid>
        <TextBlock Text="{Binding CertificatesPage.RangeText}" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding CertificatesPage.HasItems}"/>
        <TextBlock Text="{l:Text settings.accounting.noMatches}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding CertificatesPage.HasNoMatches}"/>
            <TextBlock Classes="empty"
                       IsVisible="{Binding !TrustedCertificates.Count}"
                       Text="{l:Text settings.accounting.noCertificates}"/>
            <ItemsControl ItemsSource="{Binding CertificatesPage.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pagesVm:TrustedCertificateItem">
                        <ui:SettingsCard Padding="12">
                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                                <Image Grid.Row="0" Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center"
                                       Source="{StaticResource KeyIcon}"/>

                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Address}"/>
                                    <TextBlock Classes="detail label" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Subject}"/>
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="2" Classes="borderless forget"
                                        Command="{Binding #AccountingPage.((pagesVm:AccountingControlVM)DataContext).ForgetCertificateCommand}"
                                        CommandParameter="{Binding}">
                                    <Image Width="20" Height="20" Source="{StaticResource TrashIcon}"/>
                                </Button>

                                <!-- Each fact under its name: a fingerprint does not fit beside one on a phone -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" Spacing="3">
                                    <TextBlock Classes="detail label" Text="{l:Text settings.accounting.certificate.fingerprint}"/>
                                    <TextBlock Classes="detail" Text="{Binding Fingerprint}"/>

                                    <TextBlock Classes="detail label" Margin="0,6,0,0"
                                               Text="{l:Text settings.accounting.certificate.validUntil}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="detail" Text="{Binding ValidUntil}"/>
                                        <Image Width="14" Height="14" IsVisible="{Binding IsExpired}"
                                               Source="{StaticResource WarningIcon}"/>
                                    </StackPanel>

                                    <TextBlock Classes="detail label" Margin="0,6,0,0"
                                               Text="{l:Text settings.accounting.certificate.coordinator}"/>
                                    <TextBlock Classes="detail" Text="{Binding Coordinator}"/>
                                </StackPanel>
                            </Grid>
                        </ui:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,0"
              IsVisible="{Binding CertificatesPage.HasMultiplePages}">
            <Button Content="{l:Text serverSettings.users.previousPage}" Command="{Binding CertificatesPage.PreviousPageCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding CertificatesPage.PageText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <Button Grid.Column="2" Content="{l:Text serverSettings.users.nextPage}" Command="{Binding CertificatesPage.NextPageCommand}"/>
        </Grid>
        </ui:SettingsPage>

        <!-- ====== About the application: the same facts as on the desktop ====== -->
        <ui:SettingsPage Grid.Row="2" x:Name="AboutPage" IsVisible="False"
                         x:DataType="pagesVm:AboutControlVM">
            <controls:SettingsHeader services:SettingText.Section="about.application"/>
            <ui:SettingsCard>
                <ui:SettingsRow services:SettingText.Key="about.version">
                    <TextBlock Classes="value" Text="{Binding Version}"/>
                </ui:SettingsRow>
                <!-- Not by the key: the description is the release of the system and not a text -->
                <ui:SettingsRow Title="{l:Text settings.about.platform.title}"
                                Description="{Binding PlatformDetails}"
                                ui:SettingsPage.SearchKey="about.platform">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Width="20" Height="20" VerticalAlignment="Center"
                               Source="{Binding PlatformIconKey, Converter={x:Static converters:IconKeyConverter.Instance}}"/>
                        <TextBlock Classes="value" Text="{Binding PlatformName}"/>
                    </StackPanel>
                </ui:SettingsRow>
            </ui:SettingsCard>

            <controls:SettingsHeader services:SettingText.Section="about.project"/>
            <ui:SettingsCard>
                <ui:SettingsRow Title="{l:Text settings.about.repository.title}"
                                Description="{Binding RepositoryName}"
                                ui:SettingsPage.SearchKey="about.repository">
                    <Button Click="OnRepositoryClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="18" Height="18" Source="{StaticResource GitHubIcon}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Text settings.about.repository.open}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </ui:SettingsRow>
                <ui:SettingsRow services:SettingText.Key="about.support">
                    <!-- Leads nowhere yet: there is no place to support the project at -->
                    <Button>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="18" Height="18" Source="{StaticResource CoinIcon}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Text settings.about.support.button}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </ui:SettingsRow>
            </ui:SettingsCard>

            <controls:SettingsHeader services:SettingText.Section="about.releaseNotes"/>
            <StackPanel ui:SettingsPage.SearchKey="about.releaseNotes" Spacing="10"
                        DataContext="{Binding ReleaseHistory, DataType={x:Type pagesVm:AboutControlVM}}" x:DataType="pagesVm:ReleaseHistoryVM">
                <TextBlock Text="{l:Text settings.about.releaseNotes.description}"
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                    <Border Background="{DynamicResource SettingsCardBackgroundBrush}"
                            BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="4" MaxWidth="300" HorizontalAlignment="Left">
                        <ListBox SelectedIndex="{Binding ChannelIndex}" Background="Transparent" Padding="0"
                                 BorderThickness="0" MinWidth="190" SelectionMode="Single"
                                 AutomationProperties.Name="{l:Text settings.about.releaseNotes.channel}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerTheme>
                                <ControlTheme TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="18,8"/>
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border Name="ChannelBorder" CornerRadius="6" Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Name="PART_ContentPresenter"
                                                                  Content="{TemplateBinding Content}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                    <Style Selector="^:pointerover /template/ Border#ChannelBorder">
                                        <Setter Property="Background" Value="{DynamicResource SettingsCardBorderBrush}"/>
                                    </Style>
                                    <Style Selector="^:selected /template/ Border#ChannelBorder">
                                        <Setter Property="Background" Value="{DynamicResource ButtonMainBrush}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentTextBrush}"/>
                                    </Style>
                                    <Style Selector="^:focus-visible /template/ Border#ChannelBorder">
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </Style>
                                </ControlTheme>
                            </ListBox.ItemContainerTheme>
                            <ListBoxItem Content="{l:Text settings.about.releaseNotes.stable}"/>
                            <ListBoxItem Content="{l:Text settings.about.releaseNotes.dev}"/>
                        </ListBox>
                    </Border>
                    <Button Classes="releaseAction" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}"
                            VerticalAlignment="Center" Content="{l:Text settings.about.releaseNotes.refresh}"/>
                </WrapPanel>
                <StackPanel Spacing="8" IsVisible="{Binding IsLoading}">
                    <ProgressBar IsIndeterminate="True" Height="3"/>
                    <TextBlock Text="{l:Text settings.about.releaseNotes.loading}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <Border IsVisible="{Binding HasError}" Padding="18" CornerRadius="8"
                        Background="{DynamicResource SettingsCardBackgroundBrush}">
                    <TextBlock Text="{l:Text settings.about.releaseNotes.error}" TextWrapping="Wrap"/>
                </Border>
                <Border IsVisible="{Binding IsEmpty}" Padding="18" CornerRadius="8"
                        Background="{DynamicResource SettingsCardBackgroundBrush}">
                    <TextBlock Text="{l:Text settings.about.releaseNotes.empty}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Releases}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pagesVm:ReleaseNote">
                            <Border Background="{DynamicResource SettingsCardBackgroundBrush}" CornerRadius="10"
                                    BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1">
                                <Expander Classes="releaseNote" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{Binding IsExpanded, Mode=OneTime}"
                                          BorderThickness="0" Background="Transparent" CornerRadius="10" Padding="0">
                                    <Expander.Header>
                                        <StackPanel Spacing="2" Margin="2,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Date}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Margin="8,0,8,12">
                                        <ItemsControl ItemsSource="{Binding Sections}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="pagesVm:ReleaseNoteSection">
                                                    <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding HasHeading}">
                                                        <Image Width="15" Height="15" VerticalAlignment="Center"
                                                               Source="{Binding IconKey, Converter={x:Static converters:IconKeyConverter.Instance}}"/>
                                                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="13"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Blocks}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="pagesVm:ReleaseNoteBlock">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <TextBlock Text="{Binding Marker}" IsVisible="{Binding IsListItem}"
                                                                               Width="16" FontSize="13" LineHeight="18"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <releaseText:ReleaseNoteText Grid.Column="1" Markdown="{Binding Markdown}"
                                                                         TextWrapping="Wrap" FontSize="13" LineHeight="18"
                                                                         Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Classes="releaseAction" Click="OnReleaseClick" Tag="{Binding Url}" HorizontalAlignment="Left"
                                            Padding="8,5" FontSize="12" Background="Transparent"
                                            Foreground="{DynamicResource SecondaryTextBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Source="{StaticResource GitHubIcon}" Width="16" Height="16"/>
                                                <TextBlock Text="{l:Text settings.about.releaseNotes.open}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <controls:SettingsHeader services:SettingText.Section="about.libraries"/>
            <ui:SettingsCard ItemsSource="{Binding Libraries}">
                <ui:SettingsCard.ItemTemplate>
                    <DataTemplate x:DataType="pagesVm:AboutLibrary">
                        <ui:SettingsRow Title="{Binding Name}" Description="{Binding Description^}">
                            <TextBlock Classes="value" Text="{Binding Version}"/>
                        </ui:SettingsRow>
                    </DataTemplate>
                </ui:SettingsCard.ItemTemplate>
            </ui:SettingsCard>
        </ui:SettingsPage>
    </Grid>
</UserControl>
