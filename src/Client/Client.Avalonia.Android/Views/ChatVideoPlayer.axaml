<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:vm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             xmlns:views="clr-namespace:Client.Droid.Views"
             x:Class="Client.Droid.Views.ChatVideoPlayer" x:DataType="vm:ChatFileVM">
    <Border MaxWidth="360" Padding="10" Margin="0,0,0,4" CornerRadius="8"
            Background="{DynamicResource ColorOverlayMedium}">
        <StackPanel Spacing="6">
            <views:AndroidVideoHost x:Name="VideoSurface" Height="200"/>
            <Button Click="OnPlay" HorizontalAlignment="Stretch" ToolTip.Tip="{l:Text chat.video.play}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="{StaticResource PlayIcon}" Width="20" Height="20"/>
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>
            </Button>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="3" IsVisible="{Binding IsDownloading}"/>
            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
            <TextBlock x:Name="PlaybackError" Text="{l:Text chat.video.failed}" IsVisible="False" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
