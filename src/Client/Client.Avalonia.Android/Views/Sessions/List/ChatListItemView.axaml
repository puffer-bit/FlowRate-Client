<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:listVm="clr-namespace:Client.ViewModels.Sessions.List;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Droid.Views.Sessions.List.ChatListItemView"
             x:DataType="listVm:ChatSessionVM">
    <UserControl.Styles>
        <Style Selector="Border.sessionHeader">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </UserControl.Styles>
    <Grid anim:Presence.Leave="Fold"
          anim:Presence.IsLeaving="{Binding IsLeaving}">
        <Border Classes="sessionHeader" Classes.shown="{Binding IsShown}">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                <Panel Grid.Column="0" VerticalAlignment="Center">
                    <Image Width="32" Height="32" Source="{StaticResource HashIcon}" IsVisible="{Binding !IsPrivate}"/>
                    <avatars:UserAvatar Width="44" Height="44"
                                        UserName="{Binding DisplayName}" AvatarUrl="{Binding AvatarUrl}"
                                        Status="{Binding PeerStatus}" IsVisible="{Binding IsDirect}"/>
                    <Image Width="44" Height="44" Source="{StaticResource BaseUsersIcon}" IsVisible="{Binding IsGroup}"/>
                </Panel>

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="sessionName" FontSize="16" Classes.unread="{Binding HasUnread}" Text="{Binding DisplayName}"/>
                    <TextBlock Text="{Binding LastMessagePreview}" IsVisible="{Binding IsPrivate}" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>


                <!-- Mentions take the place of the plain counter; a muted chat shows its bell there -->
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastMessageTime}" IsVisible="{Binding IsPrivate}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Panel>
                        <Image Width="20" Height="20"
                               IsVisible="{Binding ShowsMutedMark}"
                               Source="{StaticResource CrossedBellIcon}"/>
                        <Border Classes="unreadBadge" IsVisible="{Binding ShowsUnreadCount}">
                            <TextBlock Text="{Binding UnreadCountText}"/>
                        </Border>
                        <Border Classes="unreadBadge mention" IsVisible="{Binding ShowsMentionCount}">
                            <TextBlock Text="{Binding MentionCountText}"/>
                        </Border>
                    </Panel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
