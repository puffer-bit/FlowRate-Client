<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:vm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Droid.Views.Sessions.Chat.GlobalChatPlayer"
             x:DataType="vm:ChatFileVM"
             anim:Presence.Appear="Fade" anim:Presence.Leave="Fade" anim:Presence.Duration="Short"
             IsVisible="False">
    <Border Padding="6,3" Margin="4" CornerRadius="6"
            Background="{DynamicResource ColorOverlayMedium}">
        <StackPanel Spacing="0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <TextBlock x:Name="FileNameText" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00 / 0:00" FontSize="10"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Button Grid.Column="2" Classes="ghost" Click="OnClose" Width="28" Height="28" Padding="0"
                        ToolTip.Tip="{l:Text chat.media.close}">
                    <Image Source="{StaticResource CloseIcon}" Width="16" Height="16"/>
                </Button>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                <Button x:Name="PlayButton" Classes="ghost" Click="OnPlay" Width="28" Height="28" Padding="0"
                        ToolTip.Tip="{l:Text chat.audio.play}">
                    <Panel>
                        <Image x:Name="CancelImage" Source="{StaticResource CloseIcon}" Width="16" Height="16" IsVisible="False"/>
                        <Image x:Name="PlayImage" Source="{StaticResource PlayIcon}" Width="16" Height="16"/>
                        <Image x:Name="PauseImage" Source="{StaticResource AudioPauseIcon}" Width="16" Height="16" IsVisible="False"/>
                    </Panel>
                </Button>
                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False"
                        Height="28" VerticalAlignment="Center"
                        ValueChanged="OnSeek" ToolTip.Tip="{l:Text chat.audio.seek}"/>
                <Button x:Name="VolumeButton" Grid.Column="2" Classes="ghost" Width="28" Height="28" Padding="0"
                        ToolTip.Tip="{l:Text peer.volume}">
                    <Image Source="{StaticResource HighVolumeIcon}" Width="16" Height="16"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="menuLabel" Text="{l:Text peer.volume}"/>
                                <Grid Classes="menuRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100"
                                            ValueChanged="OnVolumeChanged" ToolTip.Tip="{l:Text peer.volume}"/>
                                    <TextBlock x:Name="VolumeText" Grid.Column="1" Text="100%" MinWidth="34"
                                               TextAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="3" Classes="ghost" Click="OnStop" Width="28" Height="28" Padding="0"
                        ToolTip.Tip="{l:Text chat.media.stop}">
                    <Image Source="{StaticResource MediaStopIcon}" Width="16" Height="16"/>
                </Button>
            </Grid>
            <TextBlock x:Name="PlaybackError" Text="{l:Text chat.media.failed}" IsVisible="False"
                       Foreground="{DynamicResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
