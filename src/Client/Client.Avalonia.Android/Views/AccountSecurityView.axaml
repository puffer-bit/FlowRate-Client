<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:images="clr-namespace:Client.Avalonia.Controls.Images;assembly=Client.Avalonia.Controls"
             xmlns:profileVm="clr-namespace:Client.ViewModels.Profile;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Droid.Views.AccountSecurityView"
             x:DataType="profileVm:AccountSecurityVM"
             Background="{DynamicResource GeneralBrush}">

    <UserControl.Styles>
        <!-- Buttons and fields tall enough for a finger -->
        <Style Selector="StackPanel.actions > Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, 1, *">

        <!-- Header: back to where it was opened from, or out of a change -->
        <Grid Grid.Row="0" Margin="4,8,12,8" ColumnDefinitions="Auto, *" ColumnSpacing="8">
            <Panel Grid.Column="0">
                <Button Classes="borderless" Width="44" Height="44" Padding="0" CornerRadius="22"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding CloseCommand}" IsVisible="{Binding IsOverview}">
                    <Image Width="22" Height="22" Source="{StaticResource DownArrowIcon}" RenderTransform="rotate(90deg)"/>
                </Button>
                <Button Classes="borderless" Width="44" Height="44" Padding="0" CornerRadius="22"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding BackCommand}" IsVisible="{Binding IsChanging}">
                    <Image Width="22" Height="22" Source="{StaticResource DownArrowIcon}" RenderTransform="rotate(90deg)"/>
                </Button>
            </Panel>
            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                       Text="{l:Text accountSecurity.title}"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource DarkBackgroundBrush}"/>

        <ScrollViewer Grid.Row="2">
            <Panel Margin="20,24">

                <loadingIndicators:ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                IsIndeterminate="True">
                    <loadingIndicators:ProgressRing.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsBusy"/>
                            <Binding Path="Security" Converter="{x:Static ObjectConverters.IsNull}"/>
                        </MultiBinding>
                    </loadingIndicators:ProgressRing.IsVisible>
                </loadingIndicators:ProgressRing>

                <StackPanel Classes="actions" Spacing="12">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsBusy"/>
                            <Binding Path="Security" Converter="{x:Static ObjectConverters.IsNull}"/>
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Classes="fieldError" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding Error}"/>
                    <Button Command="{Binding LoadCommand}">
                        <TextBlock Text="{l:Text accountSecurity.retry}"/>
                    </Button>
                </StackPanel>

                <!-- What the user has -->
                <StackPanel Spacing="20">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsOverview"/>
                            <Binding Path="Security" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                        </MultiBinding>
                    </StackPanel.IsVisible>

                    <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:Text accountSecurity.hint}"/>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.password}"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding PasswordState}"/>
                        <StackPanel Classes="actions" Spacing="10" Margin="0,4,0,0">
                            <Button Command="{Binding SetPasswordCommand}">
                                <Panel>
                                    <TextBlock Text="{l:Text accountSecurity.password.change}" IsVisible="{Binding HasPassword}"/>
                                    <TextBlock Text="{l:Text accountSecurity.password.add}" IsVisible="{Binding !HasPassword}"/>
                                </Panel>
                            </Button>
                            <Button Command="{Binding RemovePasswordCommand}" IsVisible="{Binding HasPassword}">
                                <TextBlock Text="{l:Text accountSecurity.password.remove}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.codes}"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding CodesState}"/>
                        <StackPanel Classes="actions" Margin="0,4,0,0">
                            <Button Command="{Binding DisableCodesCommand}" IsVisible="{Binding IsTwoFactorEnabled}">
                                <TextBlock Text="{l:Text accountSecurity.codes.disable}"/>
                            </Button>
                            <Button Command="{Binding EnableCodesCommand}" IsVisible="{Binding !IsTwoFactorEnabled}">
                                <TextBlock Text="{l:Text accountSecurity.codes.enable}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.passkeys}"/>
                        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding PasskeysState}"/>
                        <ItemsControl ItemsSource="{Binding Passkeys}" IsVisible="{Binding HasPasskeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="profileVm:AccountPasskeyVM">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" Margin="0,6">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Label}"/>
                                            <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding Details}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" MinHeight="44" VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((profileVm:AccountSecurityVM)DataContext).DeletePasskeyCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{l:Text common.delete}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Classes="fieldError" TextWrapping="Wrap" Text="{Binding Error}"
                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>

                <!-- A change -->
                <StackPanel Spacing="14" IsVisible="{Binding IsChanging}">
                    <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ChangeTitle}"/>

                    <StackPanel Spacing="6" IsVisible="{Binding IsProofAsked}" IsEnabled="{Binding !IsBusy}">
                        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:Text accountSecurity.proof.hint}"/>
                        <StackPanel Spacing="6" IsVisible="{Binding IsPasswordProofAsked}">
                            <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.proof.password}"/>
                            <TextBox Classes="password" Text="{Binding ProofPassword}"
                                     RevealPassword="{Binding IsPasswordVisible, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsCodeProofAsked}">
                            <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.proof.code}"/>
                            <TextBox Text="{Binding ProofCode}" MaxLength="12" PlaceholderText="000000"
                                     TextInputOptions.ContentType="Digits"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding IsNewPasswordAsked}" IsEnabled="{Binding !IsBusy}">
                        <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.newPassword}"/>
                        <TextBox Classes="password" Text="{Binding NewPassword}" MaxLength="{Binding PasswordMaxLength}"
                                 RevealPassword="{Binding IsPasswordVisible, Mode=TwoWay}"/>
                        <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.repeatPassword}"/>
                        <TextBox Classes="password" Text="{Binding RepeatPassword}" MaxLength="{Binding PasswordMaxLength}"
                                 RevealPassword="{Binding IsPasswordVisible, Mode=TwoWay}"/>
                        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding NewPasswordHint}"/>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding IsSetupShown}" IsEnabled="{Binding !IsBusy}">
                        <TextBlock TextWrapping="Wrap" Text="{l:Text accountSecurity.codes.setup}"/>
                        <!-- Scanned by the authenticator app; the key below is for typing it in by hand -->
                        <images:QrCode Width="240" Height="240" Margin="0,6" HorizontalAlignment="Center"
                                       Text="{Binding Setup.Uri, FallbackValue={x:Null}}"/>
                        <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.codes.secret}"/>
                        <SelectableTextBlock FontFamily="monospace" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                             Text="{Binding Setup.Secret, FallbackValue=''}"/>
                        <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.codes.uri}"/>
                        <SelectableTextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding Setup.Uri, FallbackValue=''}"/>
                        <TextBlock Classes="fieldLabel" Text="{l:Text accountSecurity.codes.firstCode}"/>
                        <TextBox Text="{Binding SetupCode}" MaxLength="12" PlaceholderText="000000"
                                 TextInputOptions.ContentType="Digits"/>
                    </StackPanel>

                    <TextBlock Classes="fieldError" TextWrapping="Wrap" Text="{Binding Error}"
                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <StackPanel Classes="actions" Spacing="10" Margin="0,4,0,0">
                        <Button Classes="primary" Command="{Binding ConfirmCommand}">
                            <Panel>
                                <TextBlock Text="{Binding ConfirmText}" IsVisible="{Binding !IsBusy}"/>
                                <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                                IsIndeterminate="True" BorderThickness="2"
                                                                Foreground="{DynamicResource OnAccentTextBrush}"
                                                                IsVisible="{Binding IsBusy}"/>
                            </Panel>
                        </Button>
                        <Button Command="{Binding BackCommand}">
                            <TextBlock Text="{l:Text accountSecurity.back}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
