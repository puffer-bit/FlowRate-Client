<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:indicators="clr-namespace:Client.Avalonia.Controls.Indicators;assembly=Client.Avalonia.Controls"
             xmlns:hints="clr-namespace:Client.Avalonia.Controls.Hints;assembly=Client.Avalonia.Controls"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:common="clr-namespace:Client.Views.Common"
             xmlns:dialogs="clr-namespace:Client.Views.Dialogs"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:profileVm="clr-namespace:Client.ViewModels.Profile;assembly=Client.Avalonia.ViewModels"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="640"
             x:Class="Client.Views.Profile.UserProfileView"
             x:DataType="profileVm:UserProfileWindowVM"
             Background="{DynamicResource GeneralBrush}"
             MaxWidth="460"
             HorizontalAlignment="Stretch">

    <UserControl.Styles>
        <!-- The sections of the profile: the info, the roles, the note, and later what the chats with the user hold -->
        <Style Selector="Border.section">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource SettingsCardBackgroundBrush}"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <!-- A line of the info: an icon, the value and what it is under it -->
        <Style Selector="Image.infoIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="SelectableTextBlock.infoValue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.infoCaption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <!-- The buttons under the name, an icon over a word, sharing the width -->
        <Style Selector="Button.profileAction">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <dialogs:DialogLayout>
        <!-- Header follows the create-session dialog and stays visible while the profile scrolls. -->
        <dialogs:DialogHeader Grid.Row="0" Icon="{StaticResource BaseUserIcon}"
                             Title="{l:Text main.profile.title}"/>
        <Border Grid.Row="1" Classes="dialogSeparator"/>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="2" MaxHeight="600" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource DialogBodyMargin}" Spacing="12">

                <!-- Who it is: the avatar, the name and the status in the middle; while editing the name is a field -->
                <StackPanel Spacing="8" Margin="0,4,0,4" IsEnabled="{Binding !IsBusy}">
                    <avatars:UserAvatar Width="96" Height="96" HorizontalAlignment="Center"
                                        UserName="{Binding Name}"
                                        AvatarUrl="{Binding ShownAvatarUrl}"
                                        Source="{Binding AvatarPicker.Avatar}"
                                        Status="{Binding Status}"
                                        IsMobile="{Binding IsMobile}">
                        <avatars:UserAvatar.Overlay>
                            <avatars:AvatarEditButton Command="{Binding ChangeAvatarCommand}" IsVisible="{Binding IsCurrentUser}"/>
                        </avatars:UserAvatar.Overlay>
                    </avatars:UserAvatar>

                    <StackPanel Spacing="2" Margin="0,4,0,0" IsVisible="{Binding !IsEditing}">
                        <SelectableTextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                             TextAlignment="Center" Text="{Binding Username}"/>
                        <indicators:UserKindBadge Kind="{Binding Kind}" IconSize="24" HorizontalAlignment="Center"/>
                        <TextBlock Classes="hint" TextAlignment="Center" Text="{Binding StatusText}"/>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
                        <Button Classes="ghost" HorizontalAlignment="Center" Command="{Binding ResetAvatarCommand}">
                            <common:ActionLabel Icon="{StaticResource ResetIcon}" Text="{l:Text profile.avatar.reset}"/>
                        </Button>
                        <TextBlock Classes="hint" TextAlignment="Center" Text="{l:Text profile.avatar.resetsOnSave}"
                                   IsVisible="{Binding IsAvatarReset}"/>
                        <TextBlock Classes="fieldError" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding AvatarPicker.AvatarError}"
                                   IsVisible="{Binding AvatarPicker.AvatarError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                        <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.name}"/>
                        <TextBox x:Name="NameInput" PlaceholderText="{l:Text profile.name.short}"
                                 Text="{Binding Name}"
                                 Classes.invalid="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="fieldError" Text="{Binding NameError}"
                                   IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="hint" Text="{Binding NameHint}"
                                   IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNull}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- What can be done with the user; a hidden button gives its width to the others -->
                <Panel IsVisible="{Binding HasActions}">
                    <UniformGrid Rows="1" Margin="-4,0" IsVisible="{Binding !IsEditing}">
                        <Button Classes="profileAction" Command="{Binding WriteMessageCommand}"
                                IsVisible="{Binding CanWriteMessage}" AutomationProperties.Name="{l:Text privateChats.write}">
                            <StackPanel Spacing="6">
                                <Image Width="20" Height="20" HorizontalAlignment="Center" Source="{StaticResource SendIcon}"/>
                                <TextBlock FontSize="12" HorizontalAlignment="Center" Text="{l:Text privateChats.write}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="profileAction" Command="{Binding CallCommand}"
                                IsVisible="{Binding CanCall}" AutomationProperties.Name="{l:Text calls.start}">
                            <StackPanel Spacing="6">
                                <Image Width="20" Height="20" HorizontalAlignment="Center" Source="{StaticResource ChatCallStartedIcon}"/>
                                <TextBlock FontSize="12" HorizontalAlignment="Center" Text="{l:Text calls.start}"/>
                            </StackPanel>
                        </Button>
                        <!-- The sound of the direct chat with the user, shown by what a click changes it to -->
                        <Button Classes="profileAction" Command="{Binding ToggleChatMuteCommand}"
                                IsVisible="{Binding CanMuteChat}">
                            <Panel>
                                <StackPanel Spacing="6" IsVisible="{Binding !IsChatMuted}">
                                    <Image Width="20" Height="20" HorizontalAlignment="Center" Source="{StaticResource BellIcon}"/>
                                    <TextBlock FontSize="12" HorizontalAlignment="Center" Text="{l:Text profile.action.mute}"/>
                                </StackPanel>
                                <StackPanel Spacing="6" IsVisible="{Binding IsChatMuted}">
                                    <Image Width="20" Height="20" HorizontalAlignment="Center" Source="{StaticResource CrossedBellIcon}"/>
                                    <TextBlock FontSize="12" HorizontalAlignment="Center" Text="{l:Text profile.action.unmute}"/>
                                </StackPanel>
                            </Panel>
                        </Button>
                        <Button Classes="profileAction" Command="{Binding EditCommand}"
                                IsVisible="{Binding CanEdit}" AutomationProperties.Name="{l:Text common.edit}">
                            <StackPanel Spacing="6">
                                <Image Width="20" Height="20" HorizontalAlignment="Center" Source="{StaticResource PencilIcon}"/>
                                <TextBlock FontSize="12" HorizontalAlignment="Center" Text="{l:Text common.edit}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Panel>

                <!-- The info: each line an icon, the value and what it is -->
                <Border Classes="section">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Image Classes="infoIcon" Source="{StaticResource HashIcon}"/>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <SelectableTextBlock Classes="infoValue" Text="{Binding UserId}"/>
                                <TextBlock Classes="infoCaption" Text="{l:Text profile.field.id}"/>
                            </StackPanel>
                        </Grid>

                        <!-- The device the user is online from: a phone first, otherwise the one connected last -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" IsVisible="{Binding HasDevice}">
                            <Panel VerticalAlignment="Top">
                                <Image Classes="infoIcon"
                                       Source="{Binding DeviceIconKey, Converter={x:Static converters:IconKeyConverter.Instance}, FallbackValue={x:Null}}"
                                       IsVisible="{Binding DeviceIconKey, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <Image Classes="infoIcon" Source="{StaticResource StatusMobileIcon}"
                                       IsVisible="{Binding DeviceIconKey, Converter={x:Static ObjectConverters.IsNull}}"/>
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <SelectableTextBlock Classes="infoValue" Text="{Binding DeviceSystem}"/>
                                <TextBlock Classes="infoCaption" Text="{l:Text profile.field.device}"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" IsVisible="{Binding HasDevice}">
                            <Image Classes="infoIcon" Source="{StaticResource IInCircleIcon}"/>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <SelectableTextBlock Classes="infoValue" Text="{Binding DeviceAppVersion}"/>
                                <TextBlock Classes="infoCaption" Text="{l:Text profile.field.appVersion}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Image Classes="infoIcon" Source="{StaticResource RecentEmojiIcon}"/>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <SelectableTextBlock Classes="infoValue" Text="{Binding LastConnected}"/>
                                <TextBlock Classes="infoCaption" Text="{l:Text profile.field.lastConnected}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Roles: changes are applied immediately, independently of profile editing -->
                <Border Classes="section" IsVisible="{Binding HasRoles}" IsEnabled="{Binding !IsBusy}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="sectionTitle" VerticalAlignment="Center" Text="{l:Text profile.field.roles}"/>
                            <Button Grid.Column="1" Classes="ghost" Margin="0,-6,-8,-6" IsVisible="{Binding CanManageRoles}"
                                    IsEnabled="{Binding !IsChangingRole}" ToolTip.Tip="{l:Text roles.permission.manageRoles}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Width="16" Height="16" Source="{StaticResource PencilIcon}"/>
                                    <TextBlock Text="{l:Text common.edit}"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="2">
                                            <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding ManageableRoles}" IsEnabled="{Binding !IsChangingRole}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="profileVm:UserRoleVM">
                                                            <menus:MenuItemButton
                                                                Command="{Binding $parent[ItemsControl].((profileVm:UserProfileWindowVM)DataContext).ToggleRoleCommand}"
                                                                CommandParameter="{Binding}" IsChecked="{Binding IsAssigned}">

                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                             Fill="{DynamicResource PrimaryTextBrush}"
                                                                             IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                             Fill="{Binding Color, Converter={x:Static converters:RoleColorConverter.Instance}}"
                                                                             IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap" Text="{Binding Name}"/>
                                                                </StackPanel>
                                                            </menus:MenuItemButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock Classes="fieldError" Margin="8,4" MaxWidth="280" Text="{Binding RoleError}"
                                                       IsVisible="{Binding RoleError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AssignedRoles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="profileVm:UserRoleVM">
                                    <Border Padding="10,5" CornerRadius="14" Background="{DynamicResource DarkBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource PrimaryTextBrush}"
                                                     IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNull}}"/>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding Color, Converter={x:Static converters:RoleColorConverter.Instance}}"
                                                     IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="fieldError" TextWrapping="Wrap" Text="{Binding RoleError}"
                                   IsVisible="{Binding RoleError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </Border>

                <!-- The private note, kept on this device only -->
                <Border Classes="section">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="sectionTitle" VerticalAlignment="Center" Text="{l:Text profile.note.title}"/>
                            <loadingIndicators:ProgressRing Grid.Column="1" Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                            IsIndeterminate="True" BorderThickness="2" IsVisible="{Binding Note.IsBusy}"/>
                        </Grid>
                        <TextBox x:Name="NoteInput"
                                 Text="{Binding Note.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="64" MaxHeight="120" VerticalContentAlignment="Top"
                                 IsEnabled="{Binding Note.IsLoaded}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="{l:Text profile.note.placeholder}"/>
                        <hints:HintBlock Text="{l:Text profile.note.hint}"/>
                        <TextBlock Classes="hint" Text="{l:Text profile.note.saved}" IsVisible="{Binding Note.IsSaved}"/>
                        <TextBlock Classes="fieldError" Text="{Binding Note.Error}"
                                   IsVisible="{Binding Note.Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Command="{Binding Note.LoadCommand}" IsVisible="{Binding !Note.IsLoaded}"
                                HorizontalAlignment="Left" Content="{l:Text serverSettings.users.retry}"/>
                    </StackPanel>
                </Border>

                <!-- What the chats with the user hold (photos, videos, files, links) goes here later, as a
                     section of its own with a tab for each kind -->
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Classes="dialogSeparator"/>

        <!-- Footer: closing while viewing, the edit is saved or dropped here -->
        <Grid Grid.Row="4" Classes="dialogFooter" ColumnDefinitions="*">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                <Button Command="{Binding CloseCommand}" IsCancel="{Binding !IsEditing}" HorizontalContentAlignment="Center" AutomationProperties.Name="{l:Text common.close}">
                    <common:ActionLabel Icon="{StaticResource CrossIcon}" Text="{l:Text common.close}"/>
                </Button>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                <Button Command="{Binding CancelEditCommand}" IsCancel="{Binding IsEditing}" HorizontalContentAlignment="Center" AutomationProperties.Name="{l:Text common.cancel}">
                    <common:ActionLabel Icon="{StaticResource CrossIcon}" Text="{l:Text common.cancel}"/>
                </Button>

                <Button Classes="primary" Command="{Binding SaveCommand}" IsDefault="{Binding IsEditing}" MinWidth="110" HorizontalContentAlignment="Center" AutomationProperties.Name="{l:Text common.save}">
                    <Grid>
                        <common:ActionLabel HorizontalAlignment="Center" IsVisible="{Binding !IsBusy}" Icon="{StaticResource DesktopSaveIcon}" Text="{l:Text common.save}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                    IsVisible="{Binding IsBusy}">
                            <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                            IsIndeterminate="True" BorderThickness="2"
                                                            Foreground="{DynamicResource OnAccentTextBrush}"/>
                            <TextBlock Text="{l:Text common.saving}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </dialogs:DialogLayout>
</UserControl>
