<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:Client.Avalonia.Controls;assembly=Client.Avalonia.Controls"
             xmlns:services="clr-namespace:Client.Services;assembly=Client.Avalonia.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pagesVm="clr-namespace:Client.ViewModels.Settings.Pages;assembly=Client.Avalonia.ViewModels"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:ui="clr-namespace:Client.Avalonia.Controls.Settings;assembly=Client.Avalonia.Controls"
             x:Class="Client.Views.Settings.Pages.ExperimentalControl"
             x:DataType="pagesVm:ExperimentalControlVM">
    <ui:SettingsPage>
        <controls:SettingsHeader services:SettingText.Section="experimental.general"/>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="experimental.enable">
                <CheckBox IsChecked="{Binding IsExperimentalEnabled}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <!-- No experimental features at the moment: the free room of the page says so in large -->
        <StackPanel Spacing="10" MaxWidth="460" Margin="24,56,24,24" HorizontalAlignment="Center">
            <Image Width="128" Height="128" Margin="0,0,0,14" Opacity="0.85"
                   Source="{StaticResource RadiationIcon}"/>
            <TextBlock Text="{l:Text settings.experimental.empty.title}"
                       FontSize="28"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextWrapping="WrapWithOverflow"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="{l:Text settings.experimental.empty.text}"
                       FontSize="15"
                       TextAlignment="Center"
                       TextWrapping="WrapWithOverflow"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
    </ui:SettingsPage>
</UserControl>
