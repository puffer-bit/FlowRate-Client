<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:Client.Avalonia.Controls;assembly=Client.Avalonia.Controls"
             xmlns:services="clr-namespace:Client.Services;assembly=Client.Avalonia.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pagesVm="clr-namespace:Client.ViewModels.Settings.Pages;assembly=Client.Avalonia.ViewModels"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:ui="clr-namespace:Client.Avalonia.Controls.Settings;assembly=Client.Avalonia.Controls"
             x:Class="Client.Views.Settings.Pages.ExperimentalControl"
             x:DataType="pagesVm:ExperimentalControlVM">
    <ui:SettingsPage>
        <controls:SettingsHeader services:SettingText.Section="experimental.general"/>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="experimental.enable">
                <CheckBox IsChecked="{Binding IsExperimentalEnabled}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <!-- The features below cannot be changed while the experimental ones are off -->
        <controls:SettingsHeader services:SettingText.Section="experimental.chat"/>
        <ui:SettingsCard IsEnabled="{Binding IsExperimentalEnabled}">
            <ui:SettingsRow services:SettingText.Key="experimental.messageLayout">
                <!-- Items are in the order of ChatMessageLayout -->
                <ComboBox MinWidth="180" SelectedIndex="{Binding MessageLayoutIndex}">
                    <ComboBoxItem Content="{l:Text settings.experimental.messageLayout.list}"/>
                    <ComboBoxItem Content="{l:Text settings.experimental.messageLayout.bubbles}"/>
                </ComboBox>
            </ui:SettingsRow>
        </ui:SettingsCard>
    </ui:SettingsPage>
</UserControl>
