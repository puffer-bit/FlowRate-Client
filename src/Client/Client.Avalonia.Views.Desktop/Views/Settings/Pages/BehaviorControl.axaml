<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:hints="clr-namespace:Client.Avalonia.Controls.Hints;assembly=Client.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pagesVm="clr-namespace:Client.ViewModels.Settings.Pages;assembly=Client.Avalonia.ViewModels"
             xmlns:controls="clr-namespace:Client.Avalonia.Controls;assembly=Client.Avalonia.Controls"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:services="clr-namespace:Client.Services;assembly=Client.Avalonia.ViewModels"
             xmlns:models="clr-namespace:Client.Core.Settings;assembly=Client.Core"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:ui="clr-namespace:Client.Avalonia.Controls.Settings;assembly=Client.Avalonia.Controls"
             xmlns:user="clr-namespace:Shared.Enums.User;assembly=Shared.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.Settings.Pages.BehaviorControl"
             x:DataType="pagesVm:BehaviorControlVM"
             d:DataContext="{d:DesignInstance Type=pagesVm:BehaviorControlVM, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <converters:MaskedIdentityConverter x:Key="MaskedIdentityConverter"/>
    </UserControl.Resources>
    <ui:SettingsPage>
        <controls:SettingsHeader services:SettingText.Section="behavior.playback"/>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="behavior.keepScreenOn">
                <CheckBox IsChecked="{Binding KeepScreenOnWhileWatching}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>
        <controls:SettingsHeader services:SettingText.Section="behavior.status"/>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="behavior.autoIdle">
                <CheckBox IsChecked="{Binding IsAutoIdleEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="behavior.idleAfter"
                            IsExpanded="{Binding IsAutoIdleEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!-- How others see the status; large enough for the snore -->
                    <avatars:UserAvatar Width="32" Height="32" VerticalAlignment="Center"
                                        UserName="{l:Text profile.status.idle}"
                                        Status="{x:Static user:UserStatus.Idle}"
                                        ToolTip.Tip="{l:Text profile.status.idle}"/>
                    <!-- Items are in the order of BehaviorControlVM.IdleAfterChoices -->
                    <ComboBox MinWidth="180" SelectedIndex="{Binding IdleAfterIndex}">
                        <ComboBoxItem Content="{l:Text settings.behavior.minutes5}"/>
                        <ComboBoxItem Content="{l:Text settings.behavior.minutes10}"/>
                        <ComboBoxItem Content="{l:Text settings.behavior.minutes15}"/>
                        <ComboBoxItem Content="{l:Text settings.behavior.minutes30}"/>
                    </ComboBox>
                </StackPanel>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="behavior.sleepAfter"
                            IsExpanded="{Binding IsAutoIdleEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <avatars:UserAvatar Width="32" Height="32" VerticalAlignment="Center"
                                        UserName="{l:Text profile.status.sleeping}"
                                        Status="{x:Static user:UserStatus.Sleeping}"
                                        ToolTip.Tip="{l:Text profile.status.sleeping}"/>
                    <!-- Items are in the order of BehaviorControlVM.SleepAfterChoices -->
                    <ComboBox MinWidth="180" SelectedIndex="{Binding SleepAfterIndex}">
                        <ComboBoxItem Content="{l:Text settings.behavior.hours1}"/>
                        <ComboBoxItem Content="{l:Text settings.behavior.hours2}"/>
                        <ComboBoxItem Content="{l:Text settings.behavior.hours4}"/>
                        <ComboBoxItem Content="{l:Text settings.behavior.never}"/>
                    </ComboBox>
                </StackPanel>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="behavior.keepActiveInCalls"
                            IsExpanded="{Binding IsAutoIdleEnabled}">
                <CheckBox IsChecked="{Binding KeepActiveDuringCalls}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>
        <!-- The microphone button blinks when we talk and nobody hears it -->
        <controls:SettingsHeader services:SettingText.Section="behavior.warnings"/>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="behavior.mutedMicrophoneWarning">
                <CheckBox IsChecked="{Binding IsMutedMicrophoneWarningEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="behavior.pushToTalkWarning">
                <CheckBox IsChecked="{Binding IsPushToTalkWarningEnabled}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>
        <controls:SettingsHeader services:SettingText.Section="behavior.autoConnection"/>
        <ui:SettingsCard IsEnabled="{x:Static services:LaunchSettings.CanAutoConnect}">
            <ui:SettingsRow services:SettingText.Key="behavior.autoConnect">
                <CheckBox IsChecked="{Binding IsAutoConnectedEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="behavior.server"
                            IsExpanded="{Binding IsAutoConnectedEnabled}"
                            IsEnabled="{Binding IsAutoConnectedEnabled}">
                <ComboBox Width="240" HorizontalAlignment="Right"
                          PlaceholderText="{l:Text settings.behavior.server.placeholder}"
                          ItemsSource="{Binding SavedServers}"
                          SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                    <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="models:SavedCoordinatorModel">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <!-- The last server shows a clock in place of the planet -->
                                <Panel>
                                    <Image Width="20" Height="20" Source="{StaticResource PlanetIcon}" IsVisible="{Binding CoordinatorId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <Image Width="20" Height="20" Source="{StaticResource RecentEmojiIcon}" IsVisible="{Binding CoordinatorId, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                </Panel>
                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                </Panel>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SavedCoordinatorModel">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                <Panel VerticalAlignment="Center">
                                    <Image Width="24" Height="24" Source="{StaticResource PlanetIcon}" IsVisible="{Binding CoordinatorId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <Image Width="24" Height="24" Source="{StaticResource RecentEmojiIcon}" IsVisible="{Binding CoordinatorId, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                </Panel>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}"
                                               IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Classes="hint" IsVisible="{Binding CoordinatorId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><Run Text="{Binding Address}"/><Run Text=":"/><Run Text="{Binding Port}"/></TextBlock>
                                    <TextBlock Classes="hint" Text="{Binding CoordinatorId}" IsVisible="{Binding CoordinatorId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="behavior.identity"
                            IsExpanded="{Binding IsAutoConnectedEnabled}"
                            IsEnabled="{Binding IsAutoConnectedEnabled}">
                <ComboBox Width="240" HorizontalAlignment="Right"
                          PlaceholderText="{l:Text settings.behavior.identity.placeholder}"
                          ItemsSource="{Binding Identities}"
                          IsEnabled="{Binding IsIdentitySelectable}"
                          SelectedItem="{Binding SelectedIdentity, Mode=TwoWay}">
                    <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="models:SavedUserModel">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Panel Width="22" Height="22">
                                    <avatars:UserAvatar Width="22" Height="22" UserName="{Binding Username}"
                                                        Coordinator="{Binding CoordinatorId}" AvatarUrl="{Binding AvatarUrl}"
                                                        IsVisible="{Binding EntryIconKey, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <Image Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Source="{Binding EntryIconKey, Converter={x:Static converters:IconKeyConverter.Instance}}"
                                           IsVisible="{Binding EntryIconKey, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding SelectionLabel}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SavedUserModel">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                    <!-- The last account shows an icon in place of the avatar -->
                                    <avatars:UserAvatar Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center"
                                                        UserName="{Binding Username}"
                                                        Coordinator="{Binding CoordinatorId}"
                                                        AvatarUrl="{Binding AvatarUrl}"
                                                        IsVisible="{Binding EntryIconKey, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <Border Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center"
                                            IsVisible="{Binding EntryIconKey, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Image Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Source="{Binding EntryIconKey, Converter={x:Static converters:IconKeyConverter.Instance}}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Text="{Binding SelectionLabel}"/>
                                        <!-- A saved account without a device here has to log in again -->
                                        <TextBlock Classes="hint" TextWrapping="NoWrap" Text="{l:Text connect.identity.needsLogin}">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="CoordinatorId" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                                    <Binding Path="!CanLogIn"/>
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                </ComboBox>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader services:SettingText.Section="behavior.manualConnection" IsEnabled="False"/>
        <ui:SettingsCard IsEnabled="False">
            <ui:SettingsRow services:SettingText.Key="behavior.fallbackServers">
                <CheckBox IsChecked="{Binding IsAutoConnectedToFallbackServersEnabled}"/>
            </ui:SettingsRow>
            <!-- The warnings only matter while fallback servers are allowed, and are folded away otherwise -->
            <ui:SettingsRow services:SettingText.Key="behavior.fallbackWarning"
                            IsExpanded="{Binding IsAutoConnectedToFallbackServersEnabled}">
                <CheckBox IsChecked="{Binding IsFallbackConnectionWarningEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="behavior.propagatedWarning"
                            IsExpanded="{Binding IsAutoConnectedToFallbackServersEnabled}">
                <CheckBox IsChecked="{Binding IsPropagatedConnectionWarningEnabled}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader services:SettingText.Section="behavior.tray"/>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="behavior.closeAction">
                <!-- Items are in the order of CloseButtonAction -->
                <ComboBox MinWidth="180" SelectedIndex="{Binding CloseButtonActionIndex}">
                    <ComboBoxItem Content="{l:Text settings.behavior.closeAction.ask}"/>
                    <ComboBoxItem Content="{l:Text closeApp.minimize}"/>
                    <ComboBoxItem Content="{l:Text settings.behavior.closeAction.exit}"/>
                </ComboBox>
            </ui:SettingsRow>
        </ui:SettingsCard>
        <hints:HintBlock Text="{l:Text settings.behavior.trayHint}"/>

        <controls:SettingsHeader services:SettingText.Section="behavior.updates"/>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="behavior.updateCheck" IsEnabled="{x:Static services:LaunchSettings.CanUpdate}">
                <CheckBox IsChecked="{Binding IsUpdateCheckOnStartupEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="behavior.updateChannel" IsEnabled="{x:Static services:LaunchSettings.CanUpdate}">
                <!-- Items are in the order of UpdateChannel -->
                <ComboBox MinWidth="180" SelectedIndex="{Binding UpdateChannelIndex}">
                    <ComboBoxItem Content="{l:Text settings.behavior.updateChannel.release}"/>
                    <ComboBoxItem Content="{l:Text settings.behavior.updateChannel.dev}"/>
                </ComboBox>
            </ui:SettingsRow>
        </ui:SettingsCard>
        <hints:HintBlock Text="{l:Text settings.behavior.updateChannelHint}"/>
    </ui:SettingsPage>
</UserControl>
