<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="clr-namespace:Client.Views.Common"
             xmlns:dialogs="clr-namespace:Client.Views.Dialogs"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:chatVm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Views.Sessions.Chat.ChatInfoView"
             x:DataType="chatVm:ChatInfoWindowVM"
             Background="{DynamicResource GeneralBrush}"
             MaxWidth="384" HorizontalAlignment="Stretch" MaxHeight="560">
    <dialogs:DialogLayout>
        <dialogs:DialogHeader Icon="{StaticResource HashIcon}" Title="{l:Text chat.info.title}" Subtitle="{l:Text session.type.chat}"/>
        <Border Grid.Row="1" Classes="dialogSeparator"/>
        <common:StableScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,4,16" Spacing="18">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Panel Width="80" Height="80">
                        <Image Source="{StaticResource HashIcon}" IsVisible="{Binding !IsGroup}"/>
                        <avatars:UserAvatar Width="80" Height="80" UserName="{Binding Name}" AvatarUrl="{Binding AvatarUrl}" IsVisible="{Binding IsGroup}"/>
                    </Panel>
                    <SelectableTextBlock Grid.Column="1" FontSize="18" FontWeight="SemiBold"
                                         VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Name}"/>
                </Grid>
                <StackPanel Spacing="6">
                    <TextBlock Classes="fieldLabel" Text="{l:Text createSession.field.description}"/>
                    <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Description}"/>
                </StackPanel>
            </StackPanel>
        </common:StableScrollViewer>
        <Border Grid.Row="3" Classes="dialogSeparator"/>
        <Button Grid.Row="4" Margin="{StaticResource DialogFooterMargin}" HorizontalAlignment="Right" IsCancel="True"
                Command="{Binding CloseCommand}" AutomationProperties.Name="{l:Text common.close}">
            <common:ActionLabel Icon="{StaticResource CrossIcon}" Text="{l:Text common.close}"/>
        </Button>
    </dialogs:DialogLayout>
</UserControl>
