<UserControl xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:indicators="clr-namespace:Client.Avalonia.Controls.Indicators;assembly=Client.Avalonia.Controls"
             xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:text="clr-namespace:Client.Avalonia.Controls.Text;assembly=Client.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:events="clr-namespace:Client.Avalonia.Controls.Chat;assembly=Client.Avalonia.Controls"
             xmlns:icons="clr-namespace:Client.Avalonia.Icons;assembly=Client.Avalonia.Assets"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:chatVm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             xmlns:chatViews="clr-namespace:Client.Views.Sessions.Chat"
             xmlns:sharedChat="clr-namespace:Client.Views.Shared.Chat;assembly=Client.Avalonia.Views.Common"
             xmlns:panels="clr-namespace:Client.Avalonia.Controls.Panels;assembly=Client.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="chatVm:ChatMessageVM"
             x:Class="Client.Views.Sessions.Chat.ChatMessageControl"
             x:Name="MessageView">

    
    <UserControl.Styles>
        <!-- A bubble with an album is as wide as the album with the padding of the bubble, so its text wraps under
             the pictures (ChatMessageViewStyle lets the album meet the edges) -->
        <Style Selector=".bubbles Border.msg-root.has-album Border.msg-bubble" x:DataType="chatVm:ChatMessageVM">
            <Setter Property="MaxWidth" Value="{Binding AlbumBubbleWidth, Converter={x:Static sharedChat:ChatBubble.WidthOfAlbum}}"/>
        </Style>
        <!-- In a bubble the name, the quote and the pictures and files come first, the text under them as their
             caption; the list keeps the order of the markup -->
        <Style Selector=".bubbles :is(Control).msg-top">
            <Setter Property="panels:OrderedStackPanel.Order" Value="-2"/>
        </Style>
        <Style Selector=".bubbles :is(Control).msg-attachments">
            <Setter Property="panels:OrderedStackPanel.Order" Value="-1"/>
        </Style>
    </UserControl.Styles>

    <UserControl.ContextFlyout>
        <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="message-menu"
                Opening="FlyoutBase_OnOpening"
                Opened="FlyoutBase_OnOpened"
                Closed="FlyoutBase_OnClosed"/>
    </UserControl.ContextFlyout>
    
    <!-- The same row draws a list item or a bubble: the list of a chat in bubbles carries the class "bubbles",
         and the styles of ChatMessageViewStyle place the parts from the classes below -->
    <Border Classes="msg-root"
            Classes.pending="{Binding IsOutgoing}"
            Classes.mine="{Binding Message.IsMine}"
            Classes.seq-start="{Binding IsSequenceStart}"
            Classes.seq-end="{Binding IsSequenceEnd}"
            Classes.direct="{Binding IsDirectChat}"
            Classes.has-text="{Binding HasPlainText}"
            Classes.has-opened-flyout="{Binding IsFlyoutOpen}"
            Classes.highlighted="{Binding IsHighlighted}"
            Classes.system="{Binding IsSystem}"
            Classes.mentioned="{Binding IsMentioningMe}"
            Classes.has-album="{Binding HasAlbum}"
            Classes.media-lead="{Binding IsMediaLead}"
            Classes.media-end="{Binding IsMediaEnd}"
            Classes.media-only="{Binding IsMediaOnly}"
            Classes.has-reactions="{Binding HasReactions}"
            Classes.pinned="{Binding IsPinned}">
        <!-- The avatar column also holds the time of continuations, so their text lines up with the first message -->
        <Panel>
            <events:ChatSystemMessageView CenterInlineUsers="True" IsVisible="{Binding IsSystem}" Parts="{Binding SystemParts}" OpenUserCommand="{Binding OpenSystemUserCommand}"
                                          Kind="{Binding SystemEventKind}" Time="{Binding LocalSentTime}"/>
        <Grid ColumnDefinitions="Auto, *, Auto" IsVisible="{Binding !IsSystem}">

            <avatars:UserAvatar Classes="msg-avatar"
                                x:Name="SenderAvatar" Tapped="OnAvatarTapped" Cursor="Hand"
                                UserName="{Binding SenderName}"
                                IsDeleted="{Binding IsSenderDeleted}"
                                AvatarUrl="{Binding SenderAvatarUrl}"/>

            <Panel Grid.Column="1" Classes="msg-bubble-host">
            <Border Classes="msg-bubble">
            <!-- In a bubble the parts of class msg-top and msg-attachments go before the text, as a caption under
                 the pictures and files (ChatMessageViewStyle) -->
            <panels:OrderedStackPanel Classes="msg-content" Spacing="4">

                <StackPanel Classes="msg-header msg-top">
                    <SelectableTextBlock Classes.is-me="{Binding Message.IsMine}" Classes="msg-username"
                                         Classes.deleted-user="{Binding IsSenderDeleted}"
                                         x:Name="NameTextBlock"
                                         Cursor="Hand"
                                         ContextFlyout="{x:Null}"
                                         Text="{Binding SenderName}"
                                         Classes.role-colored="{Binding SenderColor, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <!-- A local value would hide the usual color of the style whenever the author has no colored role -->
                        <SelectableTextBlock.Styles>
                            <Style Selector="SelectableTextBlock.role-colored">
                                <Setter Property="Foreground"
                                        Value="{Binding SenderColor, Converter={x:Static converters:RoleColorConverter.Instance}}"/>
                            </Style>
                        </SelectableTextBlock.Styles>
                    </SelectableTextBlock>
                    <indicators:UserKindBadge Kind="{Binding SenderKind}"/>
                    <TextBlock Classes="msg-time"
                               Text="{Binding LocalSentTime, StringFormat=\{0:HH:mm\}}"/>
                </StackPanel>
                
                <Button Classes="msg-reply msg-top"
                        Classes.deleted="{Binding Reply.IsDeleted, FallbackValue=False}"
                        IsVisible="{Binding HasReply}"
                        Command="{Binding OpenReplyCommand}"
                        ToolTip.Tip="{l:Text chat.goToMessage}">
                    <Border Classes="msg-reply-body">
                        <StackPanel>
                            <TextBlock Classes="msg-reply-username" Text="{Binding Reply.SenderName}"
                                       Classes.deleted-user="{Binding Reply.IsSenderDeleted, FallbackValue=False}"
                                       Classes.role-colored="{Binding Reply.SenderColor, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock.role-colored">
                                        <Setter Property="Foreground"
                                                Value="{Binding Reply.SenderColor, Converter={x:Static converters:RoleColorConverter.Instance}}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !Reply.IsDeleted, FallbackValue=False}">
                                <Image Width="14" Height="14" Margin="0,0,5,0"
                                       Source="{StaticResource ClipIcon}"
                                       IsVisible="{Binding Reply.HasAttachments, FallbackValue=False}"/>
                                <TextBlock Grid.Column="1" Classes="msg-reply-text"
                                           Text="{Binding Reply.Text}"/>
                            </Grid>
                            <TextBlock Classes="msg-deleted-text"
                                       IsVisible="{Binding Reply.IsDeleted, FallbackValue=False}"
                                       Text="{l:Text chat.messageDeleted}"/>
                        </StackPanel>
                    </Border>
                </Button>
                
                <!-- An edited message ends with a pencil, right after its last word -->
                <Border Classes="msg-top" IsVisible="{Binding HasCommandResult}" Background="{DynamicResource MsgReplyBrush}"
                        Padding="6,3" CornerRadius="5" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Panel Width="18" Height="18" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                            <Panel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding CommandResult.TokenScaleX}"/>
                                    <RotateTransform Angle="{Binding CommandResult.TokenAngle}"/>
                                </TransformGroup>
                            </Panel.RenderTransform>
                            <Image Source="{StaticResource CoinIcon}" IsVisible="{Binding CommandResult.IsFlip}"/>
                            <Image Source="{StaticResource DiceIcon}" IsVisible="{Binding CommandResult.IsRoll}"/>
                        </Panel>
                        <TextBlock Text="{Binding CommandResult.Caption}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="→" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding CommandResult.DisplayValue}" FontSize="14" MinWidth="32"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <text:TrailingMarkPanel IsVisible="{Binding HasPlainText}">
                    <Grid>
                        <chatVm:ChatCodeBlockBackground Target="{Binding #MessageTextBlock}" IsHitTestVisible="False"/>
                        <SelectableTextBlock Classes="msg-body" Classes.jumbo="{Binding IsJumboEmoji}"
                                             chatVm:ChatMessageText.Body="{Binding Body}"
                                             chatVm:ChatMessageText.LinkConfirmation="{Binding ConfirmOpenLink}"
                                             x:Name="MessageTextBlock"
                                             ContextFlyout="{x:Null}"/>
                        <chatVm:ChatCodeBlockCopyButtons Target="{Binding #MessageTextBlock}"/>
                    </Grid>
                    <!-- In a list only the pencil of an edited message; in a bubble also its time and mark -->
                    <StackPanel Classes="msg-trailing">
                        <Path Classes="msg-edited" IsVisible="{Binding Message.IsEdited}"
                              ToolTip.Tip="{l:Text chat.edited}"/>
                        <StackPanel Classes="msg-bubble-meta">
                            <TextBlock Classes="msg-bubble-time" Text="{Binding LocalSentTime, StringFormat=\{0:HH:mm\}}"/>
                            <Viewbox Classes="msg-bubble-receipt" IsVisible="{Binding IsDelivered}">
                                <Path Classes="msg-bubble-check" Data="M5 12.5 L9.5 17 L19 7.5"/>
                            </Viewbox>
                            <Viewbox Classes="msg-bubble-receipt" IsVisible="{Binding IsRead}">
                                <Path Classes="msg-bubble-check" Data="M1.5 12.5 L6 17 L15.5 7.5 M10.5 15.5 L12 17 L21.5 7.5"/>
                            </Viewbox>
                            <Button Classes="msg-send-status in-bubble" IsVisible="{Binding IsOutgoing}"
                                    IsHitTestVisible="{Binding IsSendFailed}" Click="OnSendStatusClick"
                                    AutomationProperties.Name="{Binding OutgoingStatusText}">
                                <sharedChat:ChatSendStatus Classes="msg-bubble-status"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </text:TrailingMarkPanel>

                <!-- The preview of the first link, put into the message by the server a moment after it -->
                <ContentControl Content="{Binding LinkPreview}" IsVisible="{Binding HasLinkPreview}"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="chatVm:ChatLinkPreviewVM">
                            <sharedChat:ChatLinkPreviewCard/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- The card of the first flowrate:// link, made on the client -->
                <ContentControl Content="{Binding AppLink}" IsVisible="{Binding HasAppLink}"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="chatVm:ChatAppLinkVM">
                            <sharedChat:ChatAppLinkCard/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- The pictures: an album of tiles (ChatAlbumLayout), a click opens one over the chat. In a bubble
                     the album meets its edges, and with nothing under it carries the time and the mark -->
                <Border Classes="msg-media-frame msg-attachments" IsVisible="{Binding HasAlbum}">
                    <Panel Classes="msg-media" HorizontalAlignment="Left">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"
                                 MaxWidth="{Binding $parent[Grid].Bounds.Width}" IsVisible="{Binding HasImages}">
                            <Border Classes="msg-album">
                                <ItemsControl Classes="msg-images" ItemsSource="{Binding Images}"
                                              Width="{Binding AlbumWidth}" Height="{Binding AlbumHeight}">
                                    <!-- Each tile stands at its place in the album by its margin -->
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Panel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="chatVm:ChatImageVM">
                                            <Button Classes="msg-image"
                                                    Width="{Binding TileWidth}" Height="{Binding TileHeight}"
                                                    Margin="{Binding TileMargin}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    chatVm:ChatImagePresence.Image="{Binding}"
                                                    Command="{Binding OpenCommand}"
                                                    ToolTip.Tip="{Binding Image.FileName}"
                                                    AutomationProperties.Name="{Binding Image.FileName}">
                                                <Panel>
                                                    <Image Classes="msg-image-picture" Source="{Binding Preview}"/>
                                                    <Image Classes="msg-image-failed" Source="{StaticResource WarningIcon}"
                                                           IsVisible="{Binding IsFailed}"/>
                                                </Panel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Viewbox>
                        <!-- The pictures of a message on its way, from the device, with their uploads -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"
                                 MaxWidth="{Binding $parent[Grid].Bounds.Width}" IsVisible="{Binding HasOutgoingImages}">
                            <Border Classes="msg-album">
                                <sharedChat:ChatOutgoingAlbum/>
                            </Border>
                        </Viewbox>
                        <Border Classes="msg-media-meta">
                            <StackPanel Classes="msg-bubble-meta">
                                <TextBlock Classes="msg-bubble-time" Text="{Binding LocalSentTime, StringFormat=\{0:HH:mm\}}"/>
                                <Viewbox Classes="msg-bubble-receipt" IsVisible="{Binding IsDelivered}">
                                    <Path Classes="msg-bubble-check" Data="M5 12.5 L9.5 17 L19 7.5"/>
                                </Viewbox>
                                <Viewbox Classes="msg-bubble-receipt" IsVisible="{Binding IsRead}">
                                    <Path Classes="msg-bubble-check" Data="M1.5 12.5 L6 17 L15.5 7.5 M10.5 15.5 L12 17 L21.5 7.5"/>
                                </Viewbox>
                                <Button Classes="msg-send-status in-bubble" IsVisible="{Binding IsOutgoing}"
                                        IsHitTestVisible="{Binding IsSendFailed}" Click="OnSendStatusClick"
                                        AutomationProperties.Name="{Binding OutgoingStatusText}">
                                    <sharedChat:ChatSendStatus Classes="msg-bubble-status"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Panel>
                </Border>

                <!-- Audio plays inline; other files are downloaded and opened from their cards. -->
                <ItemsControl Classes="msg-files msg-attachments" ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="chatVm:ChatFileVM">
                            <StackPanel>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"
                                         MaxWidth="{Binding $parent[Grid].Bounds.Width}" IsVisible="{Binding IsAudio}">
                                    <chatViews:ChatAudioPlayer/>
                                </Viewbox>
                                <chatViews:ChatVideoPlayer IsVisible="{Binding IsVideo}"/>
                                <Button IsVisible="{Binding !IsMedia}" Classes="msg-file" Classes.error="{Binding HasError}"
                                        MaxWidth="{Binding $parent[Grid].Bounds.Width}"
                                        Command="{Binding OpenCommand}"
                                        ToolTip.Tip="{Binding ActionToolTip}">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                        <Border Grid.Column="0" Classes="msg-file-icon">
                                            <Panel>
                                                <loadingIndicators:ProgressRing Classes="smooth file-ring" Width="36" Height="36"
                                                                                MinWidth="0" MinHeight="0" BorderThickness="2.5"
                                                                                Maximum="1" Value="{Binding Progress}"
                                                                                IsVisible="{Binding IsDownloading}"/>
                                                <Image Source="{StaticResource DownloadIcon}" IsVisible="{Binding ShowDownloadIcon}"/>
                                                <Image Source="{StaticResource MarkIcon}" IsVisible="{Binding ShowDownloadedIcon}"/>
                                                <Image Source="{StaticResource CloseIcon}" IsVisible="{Binding IsDownloading}"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="msg-file-name" Text="{Binding FileName}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !HasError}">
                                                <TextBlock Classes="msg-file-size" Text="{Binding SizeText}"/>
                                                <TextBlock Classes="msg-file-size" Text="{l:Text chat.file.saved}"
                                                           IsVisible="{Binding IsSaved}"/>
                                            </StackPanel>
                                            <TextBlock Classes="msg-file-error" Text="{Binding Error}"
                                                       IsVisible="{Binding HasError}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- The files of a message on its way, from the device, with their uploads -->
                <sharedChat:ChatOutgoingAttachments Classes="msg-attachments" IsVisible="{Binding HasOutgoingFiles}"/>

                <ItemsControl ItemsSource="{Binding Reactions}" IsVisible="{Binding HasReactions}"
                              IsEnabled="{Binding CanReact}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="chatVm:ChatReactionVM">
                            <Button anim:Presence.Appear="None" anim:Presence.Leave="None" Classes="msg-reaction" Classes.mine="{Binding IsMine}"
                                    Command="{Binding Toggle}" ToolTip.Tip="{Binding Details}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emoji}" FontFamily="{x:Static icons:EmojiFont.Family}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Count}" IsVisible="{Binding HasCount}" VerticalAlignment="Center"/>
                                    </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PinError}" IsVisible="{Binding HasPinError}"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <Image Source="{StaticResource PinIcon}" Width="14" Height="14"
                       HorizontalAlignment="Left" IsVisible="{Binding IsPinned}" ToolTip.Tip="{l:Text chat.pinned.title}"/>
                <TextBlock Text="{Binding ReactionError}" IsVisible="{Binding HasReactionError}"
                           Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"/>

                <!-- A bubble without text ends with its time and mark on a line of their own -->
                <StackPanel Classes="msg-bubble-meta msg-meta-row">
                    <TextBlock Classes="msg-bubble-time" Text="{Binding LocalSentTime, StringFormat=\{0:HH:mm\}}"/>
                    <Viewbox Classes="msg-bubble-receipt" IsVisible="{Binding IsDelivered}">
                        <Path Classes="msg-bubble-check" Data="M5 12.5 L9.5 17 L19 7.5"/>
                    </Viewbox>
                    <Viewbox Classes="msg-bubble-receipt" IsVisible="{Binding IsRead}">
                        <Path Classes="msg-bubble-check" Data="M1.5 12.5 L6 17 L15.5 7.5 M10.5 15.5 L12 17 L21.5 7.5"/>
                    </Viewbox>
                    <Button Classes="msg-send-status in-bubble" IsVisible="{Binding IsOutgoing}"
                            IsHitTestVisible="{Binding IsSendFailed}" Click="OnSendStatusClick"
                            AutomationProperties.Name="{Binding OutgoingStatusText}">
                        <sharedChat:ChatSendStatus Classes="msg-bubble-status"/>
                    </Button>
                </StackPanel>
            </panels:OrderedStackPanel>
            </Border>
            <!-- The tail of the last bubble of a run -->
            <Path Classes="msg-tail" Data="M0,0 C0,8 3,12 9,14 L0,14 Z"/>
            </Panel>
            
            <!-- A continuation of a sequence shows its time at the start, on hover only. The hidden text
                 is one line of the message body, so the time is centered on that first line;
                 the panel is as wide as the avatar, so the time sits under the avatar's center. -->
            <!-- Own messages of direct chats and groups: one check when sent, two once someone read it -->
            <Panel Grid.Column="2" Classes="msg-status-column">
            <Panel Classes="msg-receipt" IsVisible="{Binding HasDeliveryStatus}"
                   Background="Transparent" Width="18" Height="18" Margin="8,2,0,0" VerticalAlignment="Top"
                   ToolTip.Tip="{Binding DeliveryTooltip}" PointerEntered="OnReceiptPointerEntered">
                <Image Source="{StaticResource ReceiptSentIcon}" IsVisible="{Binding IsDelivered}"/>
                <Image Source="{StaticResource ReceiptReadIcon}" IsVisible="{Binding IsRead}"/>
            </Panel>

            <!-- A message on its way: a clock instead of the receipt; once it did not go, a red mark that opens
                 what can be done about it -->
            <Button Classes="msg-send-status" IsVisible="{Binding IsOutgoing}"
                    IsHitTestVisible="{Binding IsSendFailed}" Click="OnSendStatusClick"
                    AutomationProperties.Name="{Binding OutgoingStatusText}">
                <sharedChat:ChatSendStatus Classes="msg-status-mark"/>
            </Button>
            </Panel>

            <Panel Grid.Column="0" Classes="msg-continuation-time"
                   HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Classes="msg-body" Text=" " Opacity="0" IsHitTestVisible="False"/>
                <TextBlock Classes="msg-time continuation" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="{Binding LocalSentTime, StringFormat=\{0:HH:mm\}}"/>
            </Panel>
        </Grid>
        </Panel>
    </Border>
</UserControl>
