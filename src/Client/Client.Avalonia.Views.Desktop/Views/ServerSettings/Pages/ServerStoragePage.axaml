<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:serverSettingsVm="clr-namespace:Client.ViewModels.ServerSettings;assembly=Client.Avalonia.ViewModels"
             xmlns:controls="clr-namespace:Client.Avalonia.Controls;assembly=Client.Avalonia.Controls"
             xmlns:ui="clr-namespace:Client.Avalonia.Controls.Settings;assembly=Client.Avalonia.Controls"
             x:Class="Client.Views.ServerSettings.Pages.ServerStoragePage"
             x:DataType="serverSettingsVm:ServerStorageTabVM">
    <ui:SettingsPage>
        <controls:SettingsHeader Text="{l:Text serverSettings.storage.section.limits}"/>
        <ui:SettingsCard>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.maxFileSize}">
                <NumericUpDown MinWidth="140" Minimum="1" Increment="1" FormatString="0"
                               Value="{Binding Form.MaxFileSizeMegabytes}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.quota}"
                            Description="{l:Text serverSettings.storage.quota.description}">
                <NumericUpDown MinWidth="140" Minimum="0" Increment="1" FormatString="0"
                               Value="{Binding Form.StorageQuotaMegabytes}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader Text="{l:Text serverSettings.storage.section.images}"/>
        <ui:SettingsCard>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.imageMaxSide}"
                            Description="{l:Text serverSettings.storage.imageMaxSide.description}">
                <NumericUpDown MinWidth="140" Minimum="320" Maximum="16384" Increment="160" FormatString="0"
                               Value="{Binding Form.ImageMaxSide}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.imageQuality}"
                            Description="{l:Text serverSettings.storage.imageQuality.description}">
                <NumericUpDown MinWidth="140" Minimum="30" Maximum="100" Increment="5" FormatString="0"
                               Value="{Binding Form.ImageQuality}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.allowOriginalImages}"
                            Description="{l:Text serverSettings.storage.allowOriginalImages.description}">
                <CheckBox IsChecked="{Binding Form.AllowOriginalImages}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader Text="{l:Text serverSettings.storage.section.videos}"/>
        <ui:SettingsCard>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.videoMaxSide}"
                            Description="{l:Text serverSettings.storage.videoMaxSide.description}">
                <NumericUpDown MinWidth="140" Minimum="240" Maximum="2160" Increment="120" FormatString="0"
                               Value="{Binding Form.VideoMaxSide}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.allowOriginalVideos}"
                            Description="{l:Text serverSettings.storage.allowOriginalVideos.description}">
                <CheckBox IsChecked="{Binding Form.AllowOriginalVideos}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader Text="{l:Text serverSettings.storage.section.uploads}"/>
        <ui:SettingsCard>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.unattachedUploads}"
                            Description="{l:Text serverSettings.storage.unattachedUploads.description}">
                <NumericUpDown MinWidth="140" Minimum="1" Maximum="1000" Increment="1" FormatString="0"
                               Value="{Binding Form.MaxUnattachedUploadsPerUser}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.unattachedLifetime}"
                            Description="{l:Text serverSettings.storage.unattachedLifetime.description}">
                <NumericUpDown MinWidth="140" Minimum="1" Maximum="720" Increment="1" FormatString="0"
                               Value="{Binding Form.UnattachedUploadLifetimeHours}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.storage.mediaTokenLifetime}"
                            Description="{l:Text serverSettings.storage.mediaTokenLifetime.description}">
                <NumericUpDown MinWidth="140" Minimum="1" Maximum="1440" Increment="1" FormatString="0"
                               Value="{Binding Form.MediaTokenLifetimeMinutes}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>
    </ui:SettingsPage>
</UserControl>
