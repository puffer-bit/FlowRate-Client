<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Client.Application\Client.Application.csproj" />
        <ProjectReference Include="..\Client.Api\Client.Api.csproj" />
        <ProjectReference Include="..\Client.LibWebRTC\Client.LibWebRTC.csproj" />
        <ProjectReference Include="..\Client.Avalonia.ViewModels\Client.Avalonia.ViewModels.csproj" />
    </ItemGroup>

    <!-- Exercise Android route selection without requiring an Android runtime on the test host. -->
    <ItemGroup>
        <Compile Include="../Client.Avalonia.Android/Platform/Media/CallAudioRoutePolicy.cs" Link="Android/CallAudioRoutePolicy.cs" />
        <Compile Include="../Client.Avalonia.Video/VideoFrameQueue.cs" Link="VideoFrameQueue.cs" />
    </ItemGroup>

</Project>
