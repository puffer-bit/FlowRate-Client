                    <Pen Brush="#00B4FF" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Red circle with white bar (stop / forbidden). Source: Icons/BrickInCircleIcon.svg -->
    <DrawingImage x:Key="BrickInCircleIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="#F44336" Geometry="M2.5 12 A9.5 9.5 0 1 0 21.5 12 A9.5 9.5 0 1 0 2.5 12 Z"/>
            <GeometryDrawing Geometry="M7.5 12 H16.5">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FFFFFF" Thickness="2" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Paperclip (attach file). Source: Icons/ClipIcon.svg -->
    <DrawingImage x:Key="ClipIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M20.5 11.5 L12.3 19.7 A5.3 5.3 0 0 1 4.8 12.2 L13 4 A3.54 3.54 0 0 1 18 9 L9.8 17.1 A1.77 1.77 0 0 1 7.3 14.6 L14.9 7.1">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Close cross (gray). Source: Icons/CloseIcon.svg -->
    <DrawingImage x:Key="CloseIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M4,4 L20,20">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource SecondaryTextBrush}" Thickness="1.5"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M20,4 L4,20">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource SecondaryTextBrush}" Thickness="1.5"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Arrows to the middle (bring a picture back to its size). Source: Icons/CollapseIcon.svg -->
    <DrawingImage x:Key="CollapseIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M20 10 H14 V4 M14 10 L20.5 3.5 M4 14 H10 V20 M10 14 L3.5 20.5">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Two sheets, every line of the front one blue (copy all text). Source: Icons/CopyIcon.svg -->
    <DrawingImage x:Key="CopyIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M15.5 8.5 V5.5 A2 2 0 0 0 13.5 3.5 H5.5 A2 2 0 0 0 3.5 5.5 V13.5 A2 2 0 0 0 5.5 15.5 H8.5 M10.5 8.5 H18.5 A2 2 0 0 1 20.5 10.5 V18.5 A2 2 0 0 1 18.5 20.5 H10.5 A2 2 0 0 1 8.5 18.5 V10.5 A2 2 0 0 1 10.5 8.5 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M11.8 12.4 H17.2 M11.8 16.4 H17.2">
                <GeometryDrawing.Pen>
                    <Pen Brush="#00B4FF" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Two sheets with a blue picture on the front one. Source: Icons/ChatView/CopyImageIcon.svg -->
    <DrawingImage x:Key="CopyImageIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M15.5 8.5 V5.5 A2 2 0 0 0 13.5 3.5 H5.5 A2 2 0 0 0 3.5 5.5 V13.5 A2 2 0 0 0 5.5 15.5 H8.5 M10.5 8.5 H18.5 A2 2 0 0 1 20.5 10.5 V18.5 A2 2 0 0 1 18.5 20.5 H10.5 A2 2 0 0 1 8.5 18.5 V10.5 A2 2 0 0 1 10.5 8.5 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="#00B4FF" Geometry="M11 17.5 L13.5 14 L15.2 16 L16.5 14.5 L18.5 17.5 Z M11.2 11.8 A0.8 0.8 0 1 0 12.8 11.8 A0.8 0.8 0 1 0 11.2 11.8 Z"/>
        </DrawingGroup>
    </DrawingImage>

    <!-- Two sheets, a blue selection on the front one (copy the selected text). Source: Icons/CopySelectionIcon.svg -->
    <DrawingImage x:Key="CopySelectionIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M15.5 8.5 V5.5 A2 2 0 0 0 13.5 3.5 H5.5 A2 2 0 0 0 3.5 5.5 V13.5 A2 2 0 0 0 5.5 15.5 H8.5 M10.5 8.5 H18.5 A2 2 0 0 1 20.5 10.5 V18.5 A2 2 0 0 1 18.5 20.5 H10.5 A2 2 0 0 1 8.5 18.5 V10.5 A2 2 0 0 1 10.5 8.5 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M11.8 12.4 H17.2 M16.8 16.4 H17.2">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="#00B4FF" Geometry="M12.3 15.1 H14.4 A1.3 1.3 0 0 1 14.4 17.7 H12.3 A1.3 1.3 0 0 1 12.3 15.1 Z"/>
        </DrawingGroup>
    </DrawingImage>

    <!-- Crossed eye (hide password). Source: Icons/CrossedEyeIcon.svg -->
    <DrawingImage x:Key="CrossedEyeIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
