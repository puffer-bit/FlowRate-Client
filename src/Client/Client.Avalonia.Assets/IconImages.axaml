<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icons converted from Icons/**/*.svg. Use as <Image Source="{StaticResource GearIcon}"/> -->
    <!-- Neutral parts use PrimaryTextBrush / SecondaryTextBrush and follow the app theme -->
    <!-- One style for all of them: a 24 px grid, outlines 1.5 px thick with round caps in the text color,
         and at most one filled accent in a color. Status badges are a filled colored shape with a white
         2 px glyph; colored marks (check, cross, plus, arrows) are 2 px as well -->

    <!-- ===== Common ===== -->

    <!-- Add a reaction: a smile with a plus. Source: Icons/AddReactionIcon.svg -->
    <DrawingImage x:Key="AddReactionIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M21 12 A9 9 0 1 1 12 3 M8 14 Q12 18 16 14 M8 9 H8.01 M15 9 H15.01 M19 2 V8 M16 5 H22">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- QR code. Source: Icons/QrCodeIcon.svg -->
    <DrawingImage x:Key="QrCodeIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="{DynamicResource PrimaryTextBrush}" Geometry="M3 3h6v1h-6Z M3 8h6v1h-6Z M3 4h1v4h-1Z M8 4h1v4h-1Z M5 5h2v2h-2Z M15 3h6v1h-6Z M15 8h6v1h-6Z M15 4h1v4h-1Z M20 4h1v4h-1Z M17 5h2v2h-2Z M3 15h6v1h-6Z M3 20h6v1h-6Z M3 16h1v4h-1Z M8 16h1v4h-1Z M5 17h2v2h-2Z M11 3h2v2h-2Z M11 5h2v2h-2Z M9 9h2v2h-2Z M13 9h2v2h-2Z M17 9h2v2h-2Z M19 9h2v2h-2Z M3 11h2v2h-2Z M5 11h2v2h-2Z M9 11h2v2h-2Z M11 11h2v2h-2Z M15 11h2v2h-2Z M19 11h2v2h-2Z M11 13h2v2h-2Z M13 13h2v2h-2Z M15 13h2v2h-2Z M17 13h2v2h-2Z M9 15h2v2h-2Z M13 15h2v2h-2Z M17 15h2v2h-2Z M19 15h2v2h-2Z M11 17h2v2h-2Z M15 17h2v2h-2Z M19 17h2v2h-2Z M9 19h2v2h-2Z M11 19h2v2h-2Z M15 19h2v2h-2Z M17 19h2v2h-2Z"/>
        </DrawingGroup>
    </DrawingImage>

    <DrawingImage x:Key="MediaStopIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M6 5 H18 Q19 5 19 6 V18 Q19 19 18 19 H6 Q5 19 5 18 V6 Q5 5 6 5 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Session journal. Source: Icons/LogsIcon.svg -->
    <DrawingImage x:Key="LogsIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M6 3 H18 Q20 3 20 5 V19 Q20 21 18 21 H6 Q4 21 4 19 V5 Q4 3 6 3 Z M8 8 H16 M8 12 H16 M8 16 H13">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Single user outline. Source: Icons/BaseUserIcon.svg -->
    <DrawingImage x:Key="BaseUserIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
