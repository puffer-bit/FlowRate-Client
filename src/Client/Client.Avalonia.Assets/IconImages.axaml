        </DrawingGroup>
    </DrawingImage>

    <!-- Light blue snowflake (frozen). Source: Icons/SnowflakeIcon.svg -->
    <DrawingImage x:Key="SnowflakeIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M12 3 L12 21 M19.79 7.5 L4.21 16.5 M19.79 16.5 L4.21 7.5 M9.4 4.6 L12 6.8 L14.6 4.6 M17.11 6.05 L16.5 9.4 L19.71 10.55 M19.71 13.45 L16.5 14.6 L17.11 17.95 M14.6 19.4 L12 17.2 L9.4 19.4 M6.89 17.95 L7.5 14.6 L4.29 13.45 M4.29 10.55 L7.5 9.4 L6.89 6.05">
