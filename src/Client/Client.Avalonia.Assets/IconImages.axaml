                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="#00B4FF" Geometry="M9.4 12 A2.6 2.6 0 1 0 14.6 12 A2.6 2.6 0 1 0 9.4 12 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="#00B4FF" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M4.5 4.5 L19.5 19.5">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F44336" Thickness="2" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

