                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Red hammer on a wooden handle (ban). Source: Icons/HammerIcon.svg -->
    <DrawingImage x:Key="HammerIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M13.2 10.8 L4.5 19.5">
                <GeometryDrawing.Pen>
                    <Pen Brush="#A1887F" Thickness="2.2" LineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="#F44336" Geometry="M13.23 3.69 L20.31 10.77 L16.77 14.31 L9.69 7.23 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F44336" Thickness="1.2" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Yellow crown (owner). Source: Icons/CrownIcon.svg -->
    <DrawingImage x:Key="CrownIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="#F5D501" Geometry="M3.5 8 L8 12 L12 5.5 L16 12 L20.5 8 L19 18.5 H5 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F5D501" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Slashed circle (empty / unavailable). Source: Icons/DashInCircleIcon.svg -->
    <DrawingImage x:Key="DashInCircleIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <!-- Drawn as line icons are, a 2 px round stroke on a 24 grid, so it stays clean at 16-18 px.
                 The slash is a diameter at 45 degrees with its ends on the ring. -->
            <GeometryDrawing Geometry="M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M5.636,5.636 L18.364,18.364">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Diskette (save). Source: Icons/DisketteIcon.svg -->
    <DrawingImage x:Key="DisketteIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource SecondaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M17 3 V8 H7 V3">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource SecondaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M8,13 H16 A1,1 0 0 1 17,14 V18 A1,1 0 0 1 16,19 H8 A1,1 0 0 1 7,18 V14 A1,1 0 0 1 8,13 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource SecondaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- The diskette in the color of the main text, for a button that saves -->
    <DrawingImage x:Key="SaveIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M17 3 V8 H7 V3">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M8,13 H16 A1,1 0 0 1 17,14 V18 A1,1 0 0 1 16,19 H8 A1,1 0 0 1 7,18 V14 A1,1 0 0 1 8,13 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Door with red cross. Source: Icons/DoorWithCrossIcon.svg -->
    <DrawingImage x:Key="DoorWithCrossIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M5 3 H11.5 A1.5 1.5 0 0 1 13 4.5 V19.5 A1.5 1.5 0 0 1 11.5 21 H5 A1.5 1.5 0 0 1 3.5 19.5 V4.5 A1.5 1.5 0 0 1 5 3 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
