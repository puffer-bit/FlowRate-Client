<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icons converted from Icons/**/*.svg. Use as <Image Source="{StaticResource GearIcon}"/> -->
    <!-- Neutral parts use PrimaryTextBrush / SecondaryTextBrush and follow the app theme -->
    <!-- One style for all of them: a 24 px grid, outlines 1.5 px thick with round caps in the text color,
         and at most one filled accent in a color. Status badges are a filled colored shape with a white
         2 px glyph; colored marks (check, cross, plus, arrows) are 2 px as well -->

    <!-- ===== Common ===== -->

    <!-- Single user outline. Source: Icons/BaseUserIcon.svg -->
    <DrawingImage x:Key="BaseUserIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M12 11 C14.2091 11 16 9.20914 16 7 C16 4.79086 14.2091 3 12 3 C9.79086 3 8 4.79086 8 7 C8 9.20914 9.79086 11 12 11 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M6 21 V19 C6 16.7909 7.79086 15 10 15 H14 C16.2091 15 18 16.7909 18 19 V21">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Two users outline. Source: Icons/BaseUsersIcon.svg -->
    <DrawingImage x:Key="BaseUsersIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M7.359644 10.899684 C9.568744 10.899684 11.359644 9.108824 11.359644 6.899684 C11.359644 4.690544 9.568744 2.899684 7.359644 2.899684 C5.150504 2.899684 3.359644 4.690544 3.359644 6.899684 C3.359644 9.108824 5.150504 10.899684 7.359644 10.899684 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M1.334673 21 V19 C1.334673 16.7909 3.125533 15 5.334673 15 H9.334673 C11.543773 15 13.334673 16.7909 13.334673 19 V21">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M18.969361 13.90822 C20.481759 13.90822 21.707848 12.682158 21.707848 11.169733 C21.707848 9.657307 20.481759 8.431245 18.969361 8.431245 C17.456935 8.431245 16.230874 9.657307 16.230874 11.169733 C16.230874 12.682158 17.456935 13.90822 18.969361 13.90822 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M14.86163 21.136972 V19.767728 C14.86163 18.25533 16.087692 17.029241 17.600117 17.029241 H20.338604 C21.851002 17.029241 23.077091 18.25533 23.077091 19.767728 V21.136972">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Blue shield. Source: Icons/BlueShieldIcon.svg -->
    <DrawingImage x:Key="BlueShieldIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="#00B4FF" Geometry="M12 3 L19 5.8 V11.4 C19 15.8 16 19.4 12 20.8 C8 19.4 5 15.8 5 11.4 V5.8 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="#00B4FF" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Red circle with white bar (stop / forbidden). Source: Icons/BrickInCircleIcon.svg -->
    <DrawingImage x:Key="BrickInCircleIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="#F44336" Geometry="M2.5 12 A9.5 9.5 0 1 0 21.5 12 A9.5 9.5 0 1 0 2.5 12 Z"/>
            <GeometryDrawing Geometry="M7.5 12 H16.5">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FFFFFF" Thickness="2" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Paperclip (attach file). Source: Icons/ClipIcon.svg -->
    <DrawingImage x:Key="ClipIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M20.5 11.5 L12.3 19.7 A5.3 5.3 0 0 1 4.8 12.2 L13 4 A3.54 3.54 0 0 1 18 9 L9.8 17.1 A1.77 1.77 0 0 1 7.3 14.6 L14.9 7.1">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Close cross (gray). Source: Icons/CloseIcon.svg -->
    <DrawingImage x:Key="CloseIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M4,4 L20,20">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource SecondaryTextBrush}" Thickness="1.5"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M20,4 L4,20">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource SecondaryTextBrush}" Thickness="1.5"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Arrows to the middle (bring a picture back to its size). Source: Icons/CollapseIcon.svg -->
    <DrawingImage x:Key="CollapseIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M20 10 H14 V4 M14 10 L20.5 3.5 M4 14 H10 V20 M10 14 L3.5 20.5">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Two sheets, every line of the front one blue (copy all text). Source: Icons/CopyIcon.svg -->
    <DrawingImage x:Key="CopyIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M15.5 8.5 V5.5 A2 2 0 0 0 13.5 3.5 H5.5 A2 2 0 0 0 3.5 5.5 V13.5 A2 2 0 0 0 5.5 15.5 H8.5 M10.5 8.5 H18.5 A2 2 0 0 1 20.5 10.5 V18.5 A2 2 0 0 1 18.5 20.5 H10.5 A2 2 0 0 1 8.5 18.5 V10.5 A2 2 0 0 1 10.5 8.5 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M11.8 12.4 H17.2 M11.8 16.4 H17.2">
                <GeometryDrawing.Pen>
                    <Pen Brush="#00B4FF" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Two sheets, a blue selection on the front one (copy the selected text). Source: Icons/CopySelectionIcon.svg -->
    <DrawingImage x:Key="CopySelectionIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M15.5 8.5 V5.5 A2 2 0 0 0 13.5 3.5 H5.5 A2 2 0 0 0 3.5 5.5 V13.5 A2 2 0 0 0 5.5 15.5 H8.5 M10.5 8.5 H18.5 A2 2 0 0 1 20.5 10.5 V18.5 A2 2 0 0 1 18.5 20.5 H10.5 A2 2 0 0 1 8.5 18.5 V10.5 A2 2 0 0 1 10.5 8.5 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M11.8 12.4 H17.2 M16.8 16.4 H17.2">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="#00B4FF" Geometry="M12.3 15.1 H14.4 A1.3 1.3 0 0 1 14.4 17.7 H12.3 A1.3 1.3 0 0 1 12.3 15.1 Z"/>
        </DrawingGroup>
    </DrawingImage>

    <!-- Crossed eye (hide password). Source: Icons/CrossedEyeIcon.svg -->
    <DrawingImage x:Key="CrossedEyeIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
