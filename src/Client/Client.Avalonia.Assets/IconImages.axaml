            <GeometryDrawing Geometry="M4 4 L20 20">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Red cross (no / cancel). Source: Icons/CrossIcon.svg -->
    <DrawingImage x:Key="CrossIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M6,6 L18,18">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F44336" Thickness="2"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M18,6 L6,18">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F44336" Thickness="2"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- White cross in red circle (error). Source: Icons/CrossInCircleIcon.svg -->
    <DrawingImage x:Key="CrossInCircleIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="#F44336" Geometry="M2.5 12 A9.5 9.5 0 1 0 21.5 12 A9.5 9.5 0 1 0 2.5 12 Z"/>
            <GeometryDrawing Geometry="M8.8 8.8 L15.2 15.2 M15.2 8.8 L8.8 15.2">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FFFFFF" Thickness="2" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Light blue snowflake (frozen). Source: Icons/SnowflakeIcon.svg -->
    <DrawingImage x:Key="SnowflakeIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M12 3 L12 21 M19.79 7.5 L4.21 16.5 M19.79 16.5 L4.21 7.5 M9.4 4.6 L12 6.8 L14.6 4.6 M17.11 6.05 L16.5 9.4 L19.71 10.55 M19.71 13.45 L16.5 14.6 L17.11 17.95 M14.6 19.4 L12 17.2 L9.4 19.4 M6.89 17.95 L7.5 14.6 L4.29 13.45 M4.29 10.55 L7.5 9.4 L6.89 6.05">
