            </GeometryDrawing>
            <GeometryDrawing Geometry="M5 11 A7 7 0 0 0 19 11">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M12 18 V21">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
