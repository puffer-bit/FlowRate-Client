                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Red cross (no / cancel). Source: Icons/CrossIcon.svg -->
    <DrawingImage x:Key="CrossIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M6,6 L18,18">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F44336" Thickness="2"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M18,6 L6,18">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F44336" Thickness="2"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- White cross in red circle (error). Source: Icons/CrossInCircleIcon.svg -->
    <DrawingImage x:Key="CrossInCircleIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="#F44336" Geometry="M2.5 12 A9.5 9.5 0 1 0 21.5 12 A9.5 9.5 0 1 0 2.5 12 Z"/>
            <GeometryDrawing Geometry="M8.8 8.8 L15.2 15.2 M15.2 8.8 L8.8 15.2">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FFFFFF" Thickness="2" LineCap="Round" LineJoin="Round"/>
