                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Blue shield. Source: Icons/BlueShieldIcon.svg -->
    <DrawingImage x:Key="BlueShieldIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="#00B4FF" Geometry="M12 3 L19 5.8 V11.4 C19 15.8 16 19.4 12 20.8 C8 19.4 5 15.8 5 11.4 V5.8 Z">
