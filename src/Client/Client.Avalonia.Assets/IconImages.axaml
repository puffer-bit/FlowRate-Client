                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- ===== Video session ===== -->

    <!-- Speaker with red cross (sound off). Source: Icons/VideoSession/CrossedNoVolumeIcon.svg -->
    <DrawingImage x:Key="CrossedNoVolumeIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M11 5 L6 9 H3 V15 H6 L11 19 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M16 9 L22 15">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F44336" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M22 9 L16 15">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F44336" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Speaker with crossed up arrow (overdrive off). Source: Icons/VideoSession/CrossedVolumeUpIcon.svg -->
    <DrawingImage x:Key="CrossedVolumeUpIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M11 5 L6 9 H3 V15 H6 L11 19 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M18.5 16 V8">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M15.5 11 L18.5 8 L21.5 11">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M15 7.5 L22 16.5">
                <GeometryDrawing.Pen>
                    <Pen Brush="#F44336" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Speaker with two waves (high volume). Source: Icons/VideoSession/HighVolumeIcon.svg -->
    <DrawingImage x:Key="HighVolumeIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M11 5 L6 9 H3 V15 H6 L11 19 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M15.5 9 A4 4 0 0 1 15.5 15">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M18.5 6 A8.5 8.5 0 0 1 18.5 18">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Speaker with one wave (low volume). Source: Icons/VideoSession/LowVolumeIcon.svg -->
    <DrawingImage x:Key="LowVolumeIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M11 5 L6 9 H3 V15 H6 L11 19 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M15.5 9 A4 4 0 0 1 15.5 15">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- Speaker with up arrow (overdrive on). Source: Icons/VideoSession/VolumeUpIcon.svg -->
    <DrawingImage x:Key="VolumeUpIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Geometry="M11 5 L6 9 H3 V15 H6 L11 19 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M18.5 16 V8">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M15.5 11 L18.5 8 L21.5 11">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

    <!-- ===== User statuses ===== -->
    <!-- Badges at the corner of an avatar: one filled shape, the cut-outs show what is behind -->

    <!-- Online: a green dot. Source: Icons/Status/StatusOnlineIcon.svg -->
    <DrawingImage x:Key="StatusOnlineIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="{DynamicResource SuccessBrush}" Geometry="M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 Z"/>
        </DrawingGroup>
    </DrawingImage>

    <!-- Away: a yellow crescent moon. Source: Icons/Status/StatusAwayIcon.svg -->
    <DrawingImage x:Key="StatusAwayIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="{DynamicResource WarningBrush}" Geometry="M11.335,2.022 A10,10 0 1 1 2.022,11.335 A7,7 0 0 0 11.335,2.022 Z"/>
        </DrawingGroup>
    </DrawingImage>

    <!-- Do not disturb: a red dot with a bar cut out. Source: Icons/Status/StatusDoNotDisturbIcon.svg -->
    <DrawingImage x:Key="StatusDoNotDisturbIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="{DynamicResource ErrorBrush}" Geometry="F0 M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 Z M7,10.5 H17 A1.5,1.5 0 0 1 17,13.5 H7 A1.5,1.5 0 0 1 7,10.5 Z"/>
        </DrawingGroup>
    </DrawingImage>

    <!-- Offline: a grey ring. Source: Icons/Status/StatusOfflineIcon.svg -->
    <DrawingImage x:Key="StatusOfflineIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="{DynamicResource SecondaryTextBrush}" Geometry="F0 M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 Z M7,12 A5,5 0 1 0 17,12 A5,5 0 1 0 7,12 Z"/>
        </DrawingGroup>
    </DrawingImage>

    <!-- Invisible: the grey ring of offline, as others see it. Source: Icons/Status/StatusInvisibleIcon.svg -->
    <DrawingImage x:Key="StatusInvisibleIcon">
        <DrawingGroup ClipGeometry="M0,0 H24 V24 H0 Z">
            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
            <GeometryDrawing Brush="{DynamicResource SecondaryTextBrush}" Geometry="F0 M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 Z M7,12 A5,5 0 1 0 17,12 A5,5 0 1 0 7,12 Z"/>
        </DrawingGroup>
    </DrawingImage>

    <!-- Selected headphones wordmark. Source: AppIcons/Headphones/svg/wordmark-on-light.svg.
         The symbol follows the accent; the lettering follows the active text color. -->
