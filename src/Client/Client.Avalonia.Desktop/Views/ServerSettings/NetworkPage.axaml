<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:serverSettingsVm="clr-namespace:Client.ViewModels.ServerSettings;assembly=Client.Avalonia.ViewModels"
             xmlns:hints="clr-namespace:Client.Avalonia.Controls.Hints;assembly=Client.Avalonia.Controls"
             xmlns:controls="clr-namespace:Client.Avalonia.Controls;assembly=Client.Avalonia.Controls"
             xmlns:ui="clr-namespace:Client.Avalonia.Controls.Settings;assembly=Client.Avalonia.Controls"
             x:Class="Client.Views.ServerSettings.NetworkPage"
             x:DataType="serverSettingsVm:NetworkTabVM">
    <ui:SettingsPage>
        <!-- Where the coordinator listens; a change restarts it -->
        <controls:SettingsHeader Text="{l:Text serverSettings.network.section.endpoint}"/>
        <ui:SettingsCard>
            <ui:SettingsRow Title="{l:Text serverSettings.network.ip}"
                            Description="{l:Text serverSettings.network.ip.description}">
                <TextBox Width="200" Text="{Binding Form.Ip}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.network.port}">
                <NumericUpDown MinWidth="140" Minimum="1" Maximum="65535" Increment="1" FormatString="0"
                               Value="{Binding Form.Port}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader Text="{l:Text serverSettings.network.section.heartbeat}"/>
        <ui:SettingsCard>
            <ui:SettingsRow Title="{l:Text serverSettings.network.heartbeat.interval}"
                            Description="{l:Text serverSettings.network.heartbeat.interval.description}">
                <NumericUpDown MinWidth="140" Minimum="1" Maximum="3600" Increment="1" FormatString="0"
                               Value="{Binding Form.HeartbeatIntervalSeconds}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.network.heartbeat.timeout}"
                            Description="{l:Text serverSettings.network.heartbeat.timeout.description}">
                <NumericUpDown MinWidth="140" Minimum="1" Maximum="3600" Increment="1" FormatString="0"
                               Value="{Binding Form.HeartbeatTimeoutSeconds}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <!-- The ICE servers clients are given for their media -->
        <controls:SettingsHeader Text="{l:Text serverSettings.network.section.ice}"/>
        <ui:SettingsCard>
            <ui:SettingsRow Title="{l:Text serverSettings.network.stun}"
                            Description="{l:Text serverSettings.network.stun.description}">
                <CheckBox IsChecked="{Binding Form.IsStunEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.network.address}" IndentLevel="1"
                            IsExpanded="{Binding Form.IsStunEnabled}">
                <TextBox Width="200" Text="{Binding Form.StunAddress}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.network.port}" IndentLevel="1"
                            IsExpanded="{Binding Form.IsStunEnabled}">
                <NumericUpDown MinWidth="140" Minimum="1" Maximum="65535" Increment="1" FormatString="0"
                               Value="{Binding Form.StunPort}"/>
            </ui:SettingsRow>

            <ui:SettingsRow Title="{l:Text serverSettings.network.turn}"
                            Description="{l:Text serverSettings.network.turn.description}">
                <CheckBox IsChecked="{Binding Form.IsTurnEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.network.address}" IndentLevel="1"
                            IsExpanded="{Binding Form.IsTurnEnabled}">
                <TextBox Width="200" Text="{Binding Form.TurnAddress}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.network.port}" IndentLevel="1"
                            IsExpanded="{Binding Form.IsTurnEnabled}">
                <NumericUpDown MinWidth="140" Minimum="1" Maximum="65535" Increment="1" FormatString="0"
                               Value="{Binding Form.TurnPort}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.network.turn.username}" IndentLevel="1"
                            IsExpanded="{Binding Form.IsTurnEnabled}">
                <TextBox Width="200" Text="{Binding Form.TurnUsername}"/>
            </ui:SettingsRow>
            <ui:SettingsRow Title="{l:Text serverSettings.network.turn.password}" IndentLevel="1"
                            IsExpanded="{Binding Form.IsTurnEnabled}">
                <TextBox Width="200" Classes="password" Text="{Binding Form.TurnPassword}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>
    </ui:SettingsPage>
</UserControl>
