<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chatVm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             x:DataType="chatVm:ChatComposerVM"
             x:Class="Client.Views.Sessions.Chat.ChatAttachmentList">
    <!-- The empty space around the cards opens what is done to files attached from now on -->
    <StackPanel IsVisible="{Binding HasAttachments}" Margin="10,8,10,0" Background="Transparent">
        <StackPanel.ContextFlyout>
            <Flyout Placement="TopEdgeAlignedLeft">
                <StackPanel Spacing="2" x:DataType="chatVm:ChatComposerVM">
                    <TextBlock Classes="menuLabel" Text="{l:Text chat.attach.defaults}"/>
                    <menus:MenuItemButton Focusable="False" Content="{l:Text chat.attach.compress}"
                                          ToolTip.Tip="{l:Text chat.attach.compress.tooltip}"
                                          Command="{Binding ToggleDefaultCompressionCommand}" IsChecked="{Binding DefaultCompressImages}">

                    </menus:MenuItemButton>
                    <menus:MenuItemButton Focusable="False" Content="{l:Text chat.attach.stripMetadata}"
                                          ToolTip.Tip="{l:Text chat.attach.stripMetadata.tooltip}"
                                          Command="{Binding ToggleDefaultMetadataCommand}" IsChecked="{Binding DefaultStripMetadata}">

                    </menus:MenuItemButton>
                    <TextBlock Classes="menuLabel" Text="{l:Text chat.attach.compressForced}" TextWrapping="Wrap" MaxWidth="260"
                               IsVisible="{Binding IsImageCompressionForced}"/>
                    <StackPanel Spacing="2" IsVisible="{Binding CanChooseVideoDefaults}">
                        <TextBlock Classes="menuLabel" Text="{l:Text chat.attach.video.defaults}"/>
                        <menus:MenuItemButton Focusable="False" Content="{l:Text chat.attach.video.compress}"
                                              ToolTip.Tip="{l:Text chat.attach.video.compress.tooltip}"
                                              Command="{Binding ToggleDefaultVideoCompressionCommand}" IsChecked="{Binding DefaultCompressVideos}">

                        </menus:MenuItemButton>
                        <ItemsControl ItemsSource="{Binding DefaultVideoSides}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="chatVm:ChatVideoSideOptionVM">
                                    <menus:MenuItemButton Focusable="False" Content="{Binding Label}"
                                                          Command="{Binding $parent[ItemsControl].((chatVm:ChatComposerVM)DataContext).ChooseDefaultVideoSideCommand}"
                                                          CommandParameter="{Binding Side}" IsChecked="{Binding IsSelected}">

                                    </menus:MenuItemButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="menuLabel" Text="{l:Text chat.attach.video.compressForced}" TextWrapping="Wrap" MaxWidth="260"
                                   IsVisible="{Binding IsVideoCompressionForced}"/>
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </StackPanel.ContextFlyout>
        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,-6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="chatVm:ChatAttachmentVM">
                    <!-- The card shows how far the file got, and why it did not go -->
                    <!-- A click or a right click opens what is done to this file -->
                    <Border Classes="chat-attachment" Classes.error="{Binding HasError}"
                            ToolTip.Tip="{Binding Key}" Tapped="OnAttachmentTapped">
                        <Border.ContextFlyout>
                            <Flyout Placement="TopEdgeAlignedLeft">
                                <StackPanel Spacing="2" x:DataType="chatVm:ChatAttachmentVM">
                                    <menus:MenuItemButton Focusable="False" Content="{l:Text chat.attach.compress}"
                                                          ToolTip.Tip="{l:Text chat.attach.compress.tooltip}"
                                                          IsVisible="{Binding IsImage}"
                                                          Command="{Binding ToggleCompressionCommand}" IsChecked="{Binding IsCompressed}">

                                    </menus:MenuItemButton>
                                    <menus:MenuItemButton Focusable="False" Content="{l:Text chat.attach.stripMetadata}"
                                                          ToolTip.Tip="{l:Text chat.attach.stripMetadata.tooltip}"
                                                          IsVisible="{Binding IsImage}"
                                                          Command="{Binding ToggleMetadataCommand}" IsChecked="{Binding IsMetadataStripped}">

                                    </menus:MenuItemButton>
                                    <TextBlock Classes="menuLabel" Text="{l:Text chat.attach.compressForced}" TextWrapping="Wrap"
                                               MaxWidth="260" IsVisible="{Binding IsImageCompressionForced}"/>
                                    <TextBlock Classes="menuLabel" Text="{l:Text chat.attach.video.compressForced}" TextWrapping="Wrap"
                                               MaxWidth="260" IsVisible="{Binding IsVideoCompressionForced}"/>
                                    <menus:MenuItemButton Focusable="False" Content="{l:Text chat.attach.video.compress}"
                                                          ToolTip.Tip="{l:Text chat.attach.video.compress.tooltip}"
                                                          IsVisible="{Binding IsVideo}"
                                                          Command="{Binding ToggleCompressionCommand}" IsChecked="{Binding IsCompressed}">

                                    </menus:MenuItemButton>
                                    <menus:MenuItemButton Focusable="False" Content="{l:Text chat.attach.stripMetadata}"
                                                          ToolTip.Tip="{l:Text chat.attach.video.stripMetadata.tooltip}"
                                                          IsVisible="{Binding IsVideo}"
                                                          Command="{Binding ToggleMetadataCommand}" IsChecked="{Binding IsMetadataStripped}">

                                    </menus:MenuItemButton>
                                    <!-- The resolution of a compressed video -->
                                    <ItemsControl ItemsSource="{Binding VideoSides}" IsVisible="{Binding CanChooseVideoSide}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="chatVm:ChatVideoSideOptionVM">
                                                <menus:MenuItemButton Focusable="False" Content="{Binding Label}"
                                                                      Command="{Binding $parent[ItemsControl].((chatVm:ChatAttachmentVM)DataContext).ChooseVideoSideCommand}"
                                                                      CommandParameter="{Binding Side}" IsChecked="{Binding IsSelected}">

                                                </menus:MenuItemButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator IsVisible="{Binding HasMediaOptions}"/>
                                    <menus:MenuItemButton Focusable="False" Classes="danger" Icon="{StaticResource CloseIcon}"
                                                          Content="{l:Text chat.attach.detach}"
                                                          menus:FlyoutMenu.CloseOnClick="True"
                                                          Click="OnDetachClick"/>
                                </StackPanel>
                            </Flyout>
                        </Border.ContextFlyout>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" Classes="chat-attachment-thumbnail">
                                <Panel>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           IsVisible="{Binding IsImage}"/>
                                    <Image Classes="chat-attachment-file" Source="{StaticResource ClipIcon}"
                                           IsVisible="{Binding IsFile}"/>
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="chat-attachment-name" Text="{Binding FileName}"/>
                                <TextBlock Classes="chat-attachment-size" Text="{Binding SizeText}"
                                           IsVisible="{Binding !HasError}"/>
                                <TextBlock Classes="chat-attachment-error" Text="{Binding Error}"
                                           ToolTip.Tip="{Binding Error}"
                                           IsVisible="{Binding HasError}"/>
                                <ProgressBar Value="{Binding Progress}" IsVisible="{Binding IsUploading}"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="borderless composer-icon"
                                    Width="20" Height="20"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="{l:Text common.remove}"
                                    Command="{Binding $parent[ItemsControl].((chatVm:ChatComposerVM)DataContext).RemoveAttachmentCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{l:Text common.remove}">
                                <Image Width="12" Height="12" Source="{StaticResource CloseIcon}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
