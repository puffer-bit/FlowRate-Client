<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             xmlns:chatVm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Views.Sessions.Chat.ChatViewersPanel"
             x:DataType="chatVm:ChatViewersVM">
    <Border Background="{DynamicResource GeneralBrush}" Padding="8,8,8,6">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="14,*" ColumnSpacing="6" Margin="6,0"
                      ToolTip.Tip="{l:Text chat.viewers.title}">
                    <Image Width="14" Height="14" Source="{StaticResource BaseUsersIcon}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Caption}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <TextBlock Text="{l:Text chat.viewers.loading}" IsVisible="{Binding IsLoading}"
                           Margin="6,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{l:Text chat.viewers.error}" IsVisible="{Binding HasError}"
                           Margin="6,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Users}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="chatVm:ChatViewerVM">
                            <Button Classes="borderless" Command="{Binding ViewProfile}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,4">
                                <Button.ContextFlyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="2">
                                            <menus:MenuItemButton Icon="{StaticResource BaseUserIcon}" Content="{l:Text peer.viewProfile}"
                                                                  menus:FlyoutMenu.CloseOnClick="True"
                                                                  Command="{Binding ViewProfile}"/>
                                            <menus:MenuItemButton Icon="{StaticResource MentionIcon}" Content="{l:Text chat.menu.mention}"
                                                                  menus:FlyoutMenu.CloseOnClick="True" IsEnabled="{Binding CanMention}"
                                                                  Command="{Binding Mention}"/>
                                            <Separator IsVisible="{Binding CanBan}"/>
                                            <menus:MenuItemButton Classes="danger" Icon="{StaticResource CrossInCircleIcon}"
                                                                  Content="{l:Text peer.ban}" menus:FlyoutMenu.CloseOnClick="True"
                                                                  IsVisible="{Binding CanBan}" Command="{Binding Ban}"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.ContextFlyout>
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                    <avatars:UserAvatar Width="28" Height="28" UserName="{Binding Username}"
                                                        AvatarUrl="{Binding AvatarUrl}" Status="{Binding Status}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Username}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
