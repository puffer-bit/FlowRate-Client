<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:images="clr-namespace:Client.Avalonia.Controls.Images;assembly=Client.Avalonia.Controls"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chatVm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             KeyboardNavigation.TabNavigation="Cycle"
             x:DataType="chatVm:ChatImageViewerVM"
             x:Class="Client.Views.Sessions.Chat.ChatImageViewer">
    <Grid Classes="image-viewer" RowDefinitions="Auto, *" anim:Presence.Appear="Fade">
        <Button Grid.Row="0" Grid.RowSpan="2" Classes="image-viewer-backdrop"
                Focusable="False" Command="{Binding CloseCommand}"/>

        <images:ZoomableImage Grid.Row="1" Padding="24"
                              Source="{Binding Picture}">
            <images:ZoomableImage.ContextFlyout>
                <Flyout>
                    <StackPanel Spacing="2">
                        <menus:MenuItemButton Icon="{StaticResource DownloadIcon}"
                                              menus:FlyoutMenu.CloseOnClick="True"
                                              Content="{l:Text chat.menu.saveFileAs}"
                                              Command="{Binding SaveCommand}"/>
                        <menus:MenuItemButton Icon="{StaticResource CopyImageIcon}"
                                              menus:FlyoutMenu.CloseOnClick="True"
                                              Content="{l:Text chat.menu.copyImage}"
                                              Command="{Binding CopyCommand}"/>
                    </StackPanel>
                </Flyout>
            </images:ZoomableImage.ContextFlyout>
        </images:ZoomableImage>

        <Border Grid.Row="0" Classes="image-viewer-bar">
            <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="4">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="image-viewer-error" Text="{Binding Error}"
                               IsVisible="{Binding HasError}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="borderless iconButton"

                        Command="{Binding SaveCommand}"
                        ToolTip.Tip="{l:Text common.save}" AutomationProperties.Name="{l:Text common.save}">
                    <Image Width="18" Height="18" Source="{StaticResource DownloadIcon}"/>
                </Button>
                <Button Grid.Column="2" Classes="borderless iconButton"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="{l:Text common.close}"
                        AutomationProperties.Name="{l:Text common.close}">
                    <Image Width="16" Height="16" Source="{StaticResource CloseIcon}"/>
                </Button>
                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,6,0"
                             Value="{Binding Progress}" IsVisible="{Binding IsLoading}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
