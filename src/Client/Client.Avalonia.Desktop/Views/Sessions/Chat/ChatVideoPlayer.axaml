<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:video="clr-namespace:Client.Avalonia.Video;assembly=Client.Avalonia.Video"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:vm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Views.Sessions.Chat.ChatVideoPlayer"
             x:DataType="vm:ChatFileVM">
    <Border x:Name="PlayerBorder" Width="400" Padding="10" Margin="0,0,0,4" CornerRadius="8"
            Background="{DynamicResource ColorOverlayMedium}">
        <Grid x:Name="PlayerLayout" RowDefinitions="225,Auto">
            <video:VideoView x:Name="VideoSurface" />
            <StackPanel Grid.Row="1" Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button x:Name="PlayButton" Click="OnPlay" Width="36" Height="36"
                        ToolTip.Tip="{l:Text chat.video.play}">
                    <Panel>
                        <Image x:Name="CancelImage" Source="{StaticResource CloseIcon}" Width="20" Height="20" IsVisible="False"/>
                        <Image x:Name="PlayImage" Source="{StaticResource PlayIcon}" Width="20" Height="20"/>
                        <Image x:Name="PauseImage" Source="{StaticResource AudioPauseIcon}" Width="20" Height="20" IsVisible="False"/>
                    </Panel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <Button x:Name="VolumeButton" Grid.Column="2" Width="36" Height="36"
                        ToolTip.Tip="{l:Text peer.volume}">
                    <Image Source="{StaticResource HighVolumeIcon}" Width="18" Height="18"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="menuLabel" Text="{l:Text peer.volume}"/>
                                <Grid Classes="menuRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100"
                                            ValueChanged="OnVolumeChanged" ToolTip.Tip="{l:Text peer.volume}"/>
                                    <TextBlock x:Name="VolumeText" Grid.Column="1" Text="100%" MinWidth="34"
                                               TextAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="3" Width="36" Height="36" Click="OnFullscreen"
                        ToolTip.Tip="{l:Text hybrid.fullscreen}">
                    <Image Source="{StaticResource FullscreenIcon}" Width="18" Height="18"/>
                </Button>
            </Grid>
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" IsEnabled="False"
                    ValueChanged="OnSeek" ToolTip.Tip="{l:Text chat.video.seek}"/>
            <TextBlock x:Name="TimeText" Text="0:00 / 0:00" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="{l:Text chat.file.saved}" IsVisible="{Binding IsSaved}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="3"
                         IsVisible="{Binding IsDownloading}"/>
            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" FontSize="11"
                       Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="PlaybackError" Text="{l:Text chat.video.failed}" IsVisible="False"
                       Foreground="{DynamicResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
