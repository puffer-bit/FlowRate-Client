<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:text="clr-namespace:Client.Avalonia.Controls.Text;assembly=Client.Avalonia.Controls"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:hints="clr-namespace:Client.Avalonia.Controls.Hints;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:chatViews="clr-namespace:Client.Views.Sessions.Chat"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chatVm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             xmlns:emoji="clr-namespace:Client.Avalonia.Controls.Emoji;assembly=Client.Avalonia.Controls"
             x:DataType="chatVm:ChatComposerVM"
             x:Class="Client.Views.Sessions.Chat.ChatComposer">

    <UserControl.Styles>
        <StyleInclude Source="/Views/Sessions/Chat/Styles/ChatComposer.axaml"/>
    </UserControl.Styles>

    <Border Background="Transparent"
            Padding="9,7,9,8">
        <StackPanel>
            <!-- Mention and command suggestions; the input keeps the focus -->
            <Popup IsOpen="{Binding MentionPicker.IsOpen}"
                   PlacementTarget="{Binding #ComposerBox}"
                   Placement="TopEdgeAlignedLeft"
                   IsLightDismissEnabled="False"
                   Width="{Binding #ComposerBox.Bounds.Width}">
                <chatViews:ChatMentionSuggestions x:Name="MentionSuggestions"
                                                  DataContext="{Binding MentionPicker}"
                                                  SuggestionPicked="OnMentionPicked"/>
            </Popup>

            <Border x:Name="ComposerBox"
                    Classes="composer-box"
                    Classes.warning="{Binding IsComposerWarning}"
                    Classes.error="{Binding IsComposerError}">
                <StackPanel>
                    <!-- The reply bar unfolds when a reply is attached and folds back when it is
                         detached; the part that is folded is cut off, not drawn over the input -->
                    <chatViews:ChatReplyBar/>

                    <chatViews:ChatAttachmentList/>

                    <!-- The buttons stay on the last line while the input grows -->
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" Margin="4">
                        <Button Grid.Column="0"
                                Classes="borderless composer-icon iconButton"
                                VerticalAlignment="Bottom"
                                Command="{Binding AttachFilesCommand}"
                                ToolTip.Tip="{Binding AttachToolTip}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{Binding AttachToolTip}">
                            <Image Width="20" Height="20" Source="{StaticResource ClipIcon}"/>
                        </Button>

                        <TextBox Grid.Column="1"
                                 x:Name="MessageInput"
                                 text:ChatInputFormatting.Enabled="True"
                                 Classes="composer-input"
                                 PlaceholderText="{Binding InputWatermark}"
                                 Text="{Binding InputtedText}"
                                 MaxLength="{Binding MaxMessageLength}"
                                 IsReadOnly="{Binding IsMessageSending}"
                                 IsEnabled="{Binding CanWrite}">
                            <!-- The app's own menu instead of the theme's MenuFlyout. The items are not focusable,
                                 so a click keeps the focus and the selection in the input -->
                            <TextBox.ContextFlyout>
                                <Flyout Placement="TopEdgeAlignedLeft">
                                    <StackPanel Spacing="2">
                                        <menus:MenuItemButton Icon="{StaticResource CutIcon}" Content="{l:Text chat.input.cut}" Gesture="Ctrl+X"
                                                              Focusable="False" menus:FlyoutMenu.CloseOnClick="True"
                                                              IsEnabled="{Binding $parent[TextBox].CanCut}"
                                                              Command="{Binding $parent[TextBox].Cut}"/>
                                        <menus:MenuItemButton Icon="{StaticResource CopyIcon}" Content="{l:Text chat.input.copy}" Gesture="Ctrl+C"
                                                              Focusable="False" menus:FlyoutMenu.CloseOnClick="True"
                                                              IsEnabled="{Binding $parent[TextBox].CanCopy}"
                                                              Command="{Binding $parent[TextBox].Copy}"/>
                                        <menus:MenuItemButton Icon="{StaticResource PasteIcon}" Content="{l:Text chat.input.paste}" Gesture="Ctrl+V"
                                                              Focusable="False" menus:FlyoutMenu.CloseOnClick="True"
                                                              IsEnabled="{Binding $parent[TextBox].CanPaste}"
                                                              Command="{Binding $parent[TextBox].Paste}"/>
                                        <Separator/>
                                        <menus:MenuItemButton Icon="{StaticResource SelectAllIcon}" Content="{l:Text chat.input.selectAll}" Gesture="Ctrl+A"
                                                              Focusable="False" menus:FlyoutMenu.CloseOnClick="True"
                                                              Command="{Binding $parent[TextBox].SelectAll}"/>
                                        <text:ChatFormattingMenu Target="{Binding $parent[TextBox]}"/>
                                    </StackPanel>
                                </Flyout>
                            </TextBox.ContextFlyout>
                        </TextBox>

                        <!-- Characters left; appears only near the limit -->
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,6,8"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   IsVisible="{Binding IsLengthCounterVisible}"
                                   Text="{Binding RemainingCharacters}"/>

                        <Button Grid.Column="3"
                                x:Name="EmojiButton"
                                Classes="borderless composer-icon iconButton"
                                  VerticalAlignment="Bottom"
                                IsEnabled="{Binding CanWrite}"
                                Click="OnEmojiButtonClick"
                                ToolTip.Tip="{l:Text chat.emoji.open}"
                                AutomationProperties.Name="{l:Text chat.emoji.open}">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M 10,1 A 9,9 0 1 1 10,19 A 9,9 0 1 1 10,1 M 6,11.5 Q 10,16 14,11.5 M 6.5,6.7 L 6.5,7.5 M 13.5,6.7 L 13.5,7.5"/>
                            <FlyoutBase.AttachedFlyout>
                                <Flyout Placement="TopEdgeAlignedRight"
                                        FlyoutPresenterClasses="emoji-popup"/>
                            </FlyoutBase.AttachedFlyout>
                        </Button>

                        <Button Grid.Column="4"
                                Classes="composer-send"
                                Classes.sending="{Binding IsMessageSending}"
                                VerticalAlignment="Bottom"
                                Margin="2"
                                Command="{Binding SendMessageCommand}"
                                ToolTip.Tip="{l:Text chat.send}"
                                AutomationProperties.Name="{l:Text chat.send}">
                            <Panel>
                                <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                                IsIndeterminate="True" BorderThickness="2"
                                                                Foreground="{DynamicResource OnAccentTextBrush}"
                                                                IsVisible="{Binding IsMessageSending}"/>
                                <!-- Paper plane pointing right, drawn on an 18 px grid -->
                                <Path Classes="composer-send-plane"
                                      IsVisible="{Binding !IsMessageSending}"
                                      Width="18" Height="18"
                                      Data="M3,3 L16.5,9 L3,15 L5.25,9 Z M5.25,9 H10.5"/>
                            </Panel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- What keeps the message from going out, in the color of the frame above -->
            <Grid Classes="composer-notice"
                  Classes.warning="{Binding IsComposerWarning}"
                  Classes.error="{Binding IsComposerError}"
                  IsVisible="{Binding HasComposerNotice}"
                  ColumnDefinitions="Auto, *" ColumnSpacing="6"
                  Margin="4,0">
                <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,0,0">
                    <Image Source="{StaticResource WarningIcon}" IsVisible="{Binding IsComposerWarning}"/>
                    <Image Source="{StaticResource CrossInCircleIcon}" IsVisible="{Binding IsComposerError}"/>
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding ComposerNotice}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
