<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:icons="clr-namespace:Client.Avalonia.Icons;assembly=Client.Avalonia.Assets"
             xmlns:text="clr-namespace:Client.Avalonia.Controls.Text;assembly=Client.Avalonia.Controls"
             xmlns:chatViews="clr-namespace:Client.Views.Sessions.Chat"
             xmlns:chatVm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Views.Sessions.Chat.ChatPinnedMessagesPanel"
             x:DataType="chatVm:ActiveChatSessionVM">
    <Border Background="{DynamicResource GeneralBrush}" Padding="8,8,8,6">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="14,*" ColumnSpacing="6" Margin="6,0"
                      ToolTip.Tip="{l:Text chat.pinned.title}">
                    <Image Width="14" Height="14" Source="{StaticResource PinIcon}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PinsCaption}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <TextBlock Text="{l:Text chat.pinned.loading}" IsVisible="{Binding IsLoadingPinnedMessages}"
                           Margin="6,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{l:Text chat.pinned.error}" IsVisible="{Binding HasPinnedMessagesError}"
                           Margin="6,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{l:Text chat.pinned.empty}" IsVisible="{Binding IsPinnedListEmpty}"
                           Margin="6,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisiblePinnedMessages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="chatVm:ChatPinnedMessageVM">
                            <Border Padding="6,6" Background="Transparent">
                                <Border.ContextFlyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="2">
                                            <menus:MenuItemButton Icon="{StaticResource PinIcon}" Content="{l:Text chat.menu.unpin}"
                                                                  IsEnabled="{Binding Content.CanPin}" Command="{Binding Unpin}"
                                                                  menus:FlyoutMenu.CloseOnClick="True"/>
                                            <menus:MenuItemButton Icon="{StaticResource ReplyIcon}" Content="{l:Text chat.goToMessage}"
                                                                  Command="{Binding Open}" menus:FlyoutMenu.CloseOnClick="True"/>
                                        </StackPanel>
                                    </Flyout>
                                </Border.ContextFlyout>
                                <StackPanel Spacing="6">
                                    <Button Classes="borderless" Command="{Binding Open}" Padding="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            ToolTip.Tip="{l:Text chat.goToMessage}">
                                        <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
                                            <avatars:UserAvatar Width="28" Height="28" UserName="{Binding Content.SenderName}"
                                                                AvatarUrl="{Binding Content.SenderAvatarUrl}" Status="{Binding Content.SenderStatus}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Content.SenderName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Content.Message.SentTime, StringFormat=\{0:HH:mm\}}"
                                                       VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Grid>
                                    </Button>
                                    <ContentControl Content="{Binding Content}" HorizontalContentAlignment="Stretch">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate DataType="chatVm:ChatMessageVM">
                                                <StackPanel Spacing="4">
                                                    <Button Classes="msg-reply"
                                                            Classes.deleted="{Binding Reply.IsDeleted, FallbackValue=False}"
                                                            IsVisible="{Binding HasReply}"
                                                            Command="{Binding OpenReplyCommand}"
                                                            ToolTip.Tip="{l:Text chat.goToMessage}">
                                                        <Border Classes="msg-reply-body">
                                                            <StackPanel>
                                                                <TextBlock Classes="msg-reply-username" Text="{Binding Reply.SenderName}"
                                                                           Classes.deleted-user="{Binding Reply.IsSenderDeleted, FallbackValue=False}"/>
                                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !Reply.IsDeleted, FallbackValue=False}">
                                                                    <Image Width="14" Height="14" Margin="0,0,5,0"
                                                                           Source="{StaticResource ClipIcon}"
                                                                           IsVisible="{Binding Reply.HasAttachments, FallbackValue=False}"/>
                                                                    <TextBlock Grid.Column="1" Classes="msg-reply-text"
                                                                               Text="{Binding Reply.Text}"/>
                                                                </Grid>
                                                                <TextBlock Classes="msg-deleted-text"
                                                                           IsVisible="{Binding Reply.IsDeleted, FallbackValue=False}"
                                                                           Text="{l:Text chat.messageDeleted}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>

                                                    <!-- An edited message ends with a pencil, right after its last word -->
                                                    <text:TrailingMarkPanel IsVisible="{Binding HasText}">
                                                        <SelectableTextBlock Classes="msg-body" Classes.jumbo="{Binding IsJumboEmoji}"
                                                                             chatVm:ChatMessageText.Body="{Binding Body}"
                                                                             chatVm:ChatMessageText.LinkConfirmation="{Binding ConfirmOpenLink}"

                                                                             ContextFlyout="{x:Null}"/>
                                                        <Path Classes="msg-edited" IsVisible="{Binding Message.IsEdited}"
                                                              ToolTip.Tip="{l:Text chat.edited}"/>
                                                    </text:TrailingMarkPanel>

                                                    <!-- The reduced copies; a click opens the image itself over the chat -->
                                                    <ItemsControl HorizontalAlignment="Stretch" Classes="msg-images" ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="4"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="chatVm:ChatImageVM">
                                                                <Button Classes="msg-image"
                                                                        HorizontalAlignment="Stretch" Height="180" MinWidth="0"
                                                                        chatVm:ChatImagePresence.Image="{Binding}"
                                                                        Command="{Binding OpenCommand}"
                                                                        ToolTip.Tip="{Binding Image.FileName}">
                                                                    <Panel>
                                                                        <Image Stretch="Uniform" Classes="msg-image-picture" Source="{Binding Preview}"/>
                                                                        <Image Classes="msg-image-failed" Source="{StaticResource WarningIcon}"
                                                                               IsVisible="{Binding IsFailed}"/>
                                                                    </Panel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Audio plays inline; other files are downloaded and opened from their cards. -->
                                                    <ItemsControl HorizontalAlignment="Stretch" Classes="msg-files" ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="chatVm:ChatFileVM">
                                                                <StackPanel>
                                                                    <Viewbox IsVisible="{Binding IsAudio}" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                                        <chatViews:ChatAudioPlayer/>
                                                                    </Viewbox>
                                                                    <Viewbox IsVisible="{Binding IsVideo}" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                                        <chatViews:ChatVideoPlayer/>
                                                                    </Viewbox>
                                                                    <Button Width="NaN" HorizontalAlignment="Stretch" IsVisible="{Binding !IsMedia}" Classes="msg-file" Classes.error="{Binding HasError}"
                                                                            Command="{Binding OpenCommand}"
                                                                            ToolTip.Tip="{Binding ActionToolTip}">
                                                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                                                            <Border Grid.Column="0" Classes="msg-file-icon">
                                                                                <Panel>
                                                                                    <Image Source="{StaticResource DownloadIcon}" IsVisible="{Binding ShowDownloadIcon}"/>
                                                                                    <Image Source="{StaticResource MarkIcon}" IsVisible="{Binding ShowDownloadedIcon}"/>
                                                                                    <Image Source="{StaticResource CloseIcon}" IsVisible="{Binding IsDownloading}"/>
                                                                                </Panel>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                                <TextBlock Classes="msg-file-name" Text="{Binding FileName}"/>
                                                                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !HasError}">
                                                                                    <TextBlock Classes="msg-file-size" Text="{Binding SizeText}"/>
                                                                                    <TextBlock Classes="msg-file-size" Text="{l:Text chat.file.saved}"
                                                                                               IsVisible="{Binding IsSaved}"/>
                                                                                </StackPanel>
                                                                                <TextBlock Classes="msg-file-error" Text="{Binding Error}"
                                                                                           IsVisible="{Binding HasError}"/>
                                                                                <ProgressBar Value="{Binding Progress}" IsVisible="{Binding IsDownloading}"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Reactions}" IsVisible="{Binding HasReactions}"
                                                                  IsEnabled="{Binding CanReact}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="chatVm:ChatReactionVM">
                                                                <Button Classes="msg-reaction" Classes.mine="{Binding IsMine}"
                                                                        Command="{Binding Toggle}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Emoji}" FontFamily="{x:Static icons:EmojiFont.Family}" FontSize="16" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Count}" IsVisible="{Binding HasCount}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding PinError}" IsVisible="{Binding HasPinError}"
                                                               Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ReactionError}" IsVisible="{Binding HasReactionError}"
                                                               Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
