<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Client.Avalonia.Icons;assembly=Client.Avalonia.Assets"
             xmlns:chatVm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             x:Class="Client.Views.Sessions.Chat.ChatMessageFlyout"
             x:DataType="chatVm:ChatMessageVM">

    <!-- The gestures are only shown for now; the hot keys themselves are not implemented yet -->
    <StackPanel Spacing="2">
        <menus:MenuItemButton Icon="{StaticResource ReplyIcon}" Content="{l:Text chat.goToMessage}"
                              IsVisible="{Binding IsPinnedListItem}" Command="{Binding GoToMessage}"/>
        <menus:MenuItemButton Icon="{StaticResource AddReactionIcon}" Content="{l:Text chat.menu.react}"
                              IsVisible="{Binding CanReact}">
            <menus:MenuItemButton.Flyout>
                <Flyout Placement="RightEdgeAlignedTop" FlyoutPresenterClasses="reaction-picker">
                    <ItemsControl ItemsSource="{Binding ReactionChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="chatVm:ChatReactionVM">
                                <menus:MenuItemButton Command="{Binding Choose}" menus:FlyoutMenu.CloseOnClick="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emoji}" FontFamily="{x:Static icons:EmojiFont.Family}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Count}" IsVisible="{Binding HasCount}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <menus:MenuItemButton.IconContent>
                                        <Image Source="{StaticResource MarkIcon}" IsVisible="{Binding IsMine}"/>
                                    </menus:MenuItemButton.IconContent>
                                </menus:MenuItemButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Flyout>
            </menus:MenuItemButton.Flyout>
        </menus:MenuItemButton>

        <!-- Who read an own message and when; only its author sees it -->
        <menus:MenuItemButton Icon="{StaticResource ReceiptReadIcon}" Content="{l:Text chat.menu.readers}"
                              IsVisible="{Binding CanShowReaders}">
            <menus:MenuItemButton.Flyout>
                <Flyout Placement="RightEdgeAlignedTop">
                    <StackPanel MinWidth="240" MaxWidth="320" Spacing="2" Margin="4">
                        <TextBlock Text="{l:Text chat.readers.loading}" Margin="8,6"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   IsVisible="{Binding Readers.IsLoading, FallbackValue=False}"/>
                        <TextBlock Text="{Binding Readers.Error, FallbackValue={x:Null}}" Margin="8,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   IsVisible="{Binding Readers.HasError, FallbackValue=False}"/>
                        <TextBlock Text="{l:Text chat.readers.empty}" Margin="8,6"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   IsVisible="{Binding Readers.IsEmpty, FallbackValue=False}"/>
                        <ScrollViewer MaxHeight="320">
                            <ItemsControl ItemsSource="{Binding Readers.Items, FallbackValue={x:Null}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="chatVm:ChatMessageReaderVM">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="6,4">
                                            <avatars:UserAvatar Width="24" Height="24" UserName="{Binding Name}"
                                                                AvatarUrl="{Binding AvatarUrl}" Status="{Binding Status}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Flyout>
            </menus:MenuItemButton.Flyout>
        </menus:MenuItemButton>

        <menus:MenuItemButton Icon="{StaticResource PinIcon}" Content="{l:Text chat.menu.pin}"
                              IsVisible="{Binding !IsPinned}" IsEnabled="{Binding CanPin}"
                              Command="{Binding TogglePinned}"/>
        <menus:MenuItemButton Icon="{StaticResource PinIcon}" Content="{l:Text chat.menu.unpin}"
                              IsVisible="{Binding IsPinned}" IsEnabled="{Binding CanPin}"
                              Command="{Binding TogglePinned}"/>
        <menus:MenuItemButton Icon="{StaticResource ReplyIcon}" Content="{l:Text chat.menu.reply}" Gesture="R"
                              Command="{Binding StartReply}"/>
        <menus:MenuItemButton Icon="{StaticResource PencilIcon}" Content="{l:Text chat.menu.edit}" Gesture="E"
                              IsVisible="{Binding CanEdit}"
                              Command="{Binding StartEdit}"/>

        <!-- One copy item at a time: the selection when there is one, the whole text otherwise -->
        <menus:MenuItemButton Icon="{StaticResource CopySelectionIcon}" Content="{l:Text chat.menu.copySelected}" Gesture="Ctrl+C"
                              IsVisible="{Binding IsTextSelected}"
                              IsEnabled="{Binding HasCopyText}"
                              Command="{Binding Copy}"/>
        <menus:MenuItemButton Icon="{StaticResource CopyIcon}" Content="{l:Text chat.menu.copyAll}" Gesture="Ctrl+C"
                              IsVisible="{Binding !IsTextSelected}"
                              IsEnabled="{Binding HasCopyText}"
                              Command="{Binding Copy}"/>

        <!-- Only when the menu was opened over an image of the message -->
        <menus:MenuItemButton Icon="{StaticResource CopyImageIcon}" Content="{l:Text chat.menu.copyImage}"
                              IsVisible="{Binding HasCopyImage}"
                              Command="{Binding CopyImage}"/>
        <menus:MenuItemButton Icon="{StaticResource DownloadIcon}" Content="{l:Text chat.menu.saveFileAs}"
                              IsVisible="{Binding HasCopyImage}"
                              Command="{Binding SaveImageAs}"/>

        <!-- Only when the menu was opened over a file of the message -->
        <menus:MenuItemButton Icon="{StaticResource DownloadIcon}" Content="{l:Text chat.menu.saveFileAs}"
                              IsVisible="{Binding HasContextFile}"
                              IsEnabled="{Binding !ContextFile.IsDownloading, FallbackValue=False}"
                              Command="{Binding SaveFileAs}"/>

        <!-- Only when the menu was opened over a link of the message -->
        <menus:MenuItemButton Icon="{StaticResource CopyIcon}" Content="{l:Text chat.menu.copyLink}"
                              IsVisible="{Binding HasCopyLink}"
                              Command="{Binding CopyLink}"/>

        <menus:MenuItemButton Icon="{StaticResource UserIcon}" Content="{l:Text peer.viewProfile}" Gesture="P"
                              IsEnabled="{Binding !IsSenderDeleted}"
                              Command="{Binding ViewProfile}"/>

        <Separator IsVisible="{Binding CanDelete}"/>

        <menus:MenuItemButton Classes="danger" Icon="{StaticResource TrashIcon}" Content="{l:Text common.delete}" Gesture="Delete"
                              IsVisible="{Binding CanDelete}"
                              Command="{Binding Delete}"/>
    </StackPanel>
</UserControl>
