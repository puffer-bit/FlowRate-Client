<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:permissionsVm="clr-namespace:Client.ViewModels.Sessions.Permissions;assembly=Client.Avalonia.ViewModels"
        xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
        xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="560"
        x:Class="Client.Views.Sessions.Permissions.SessionPermissionsView"
        x:DataType="permissionsVm:SessionPermissionsWindowVM"
        Background="{DynamicResource GeneralBrush}"
        Width="780"
        Height="560">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="RadioButton.permissionState">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="StateBorder" Padding="{TemplateBinding Padding}" CornerRadius="5"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.permissionState:pointerover">
            <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="RadioButton.permissionState:checked">
            <Setter Property="Background" Value="{DynamicResource ButtonMainBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}"/>
        </Style>
        <Style Selector="RadioButton.permissionState.deny:checked">
            <Setter Property="Background" Value="{DynamicResource MenuItemDangerHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
        </Style>
        <Style Selector="RadioButton.permissionState.allow:checked">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        </Style>
        <Style Selector="RadioButton.permissionState:pressed">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="RadioButton.permissionState:focus-visible /template/ Border#StateBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="Grid.permissionRow:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Ellipse.roleDot">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, 1, *, 1, Auto">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,16,20,14" Spacing="4">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Image Width="20" Height="20" Source="{StaticResource ShieldedUser}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                           Text="{l:Text sessionPermissions.title}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="hint"
                           Text="{Binding SessionName}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding SessionName}"/>
            </Grid>
            <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:Text sessionPermissions.hint}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource DarkBackgroundBrush}"/>

        <Grid Grid.Row="2" ColumnDefinitions="180,1,*" IsEnabled="{Binding !IsBusy}">
            <Grid Margin="12,16,12,12" RowDefinitions="Auto,*" RowSpacing="10">
                <TextBlock Margin="8,0" Classes="hint" FontSize="12" FontWeight="SemiBold"
                           Text="{l:Text serverSettings.roles.section.roles}"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                         Background="Transparent" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="permissionsVm:SessionRoleOverrideVM">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,7"
                                  ToolTip.Tip="{Binding Name}">
                                <Panel VerticalAlignment="Center">
                                    <Ellipse Classes="roleDot"
                                             IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <Ellipse Classes="roleDot"
                                             Fill="{Binding Color, Converter={x:Static converters:RoleColorConverter.Instance}}"
                                             IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium"
                                           Classes.hint="{Binding !IsEditable}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource SettingsCardBorderBrush}"/>

            <Grid Grid.Column="2" Margin="20,16,20,12" RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SelectedRole.Name}"
                           TextTrimming="CharacterEllipsis"/>
                <Border Grid.Row="1" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource SettingsCardBackgroundBrush}"
                        IsVisible="{Binding !SelectedRole.IsEditable}">
                    <TextBlock Classes="hint" TextWrapping="Wrap" FontSize="12"
                               Text="{l:Text serverSettings.roles.cannotEdit}"/>
                </Border>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedRole.Permissions, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="permissionsVm:SessionPermissionStateVM">
                                <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource SettingsCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource SettingsCardBorderBrush}">
                                    <Grid Classes="permissionRow" RowDefinitions="Auto,Auto" RowSpacing="9"
                                          IsEnabled="{Binding IsEditable}">
                                        <TextBlock FontWeight="Medium" TextWrapping="Wrap" Text="{Binding Title}"/>
                                        <Border Grid.Row="1" Padding="3" CornerRadius="8" HorizontalAlignment="Left"
                                                Background="{DynamicResource GeneralBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <RadioButton Classes="permissionState deny" Content="{l:Text sessionPermissions.deny}" IsChecked="{Binding IsDenied}"/>
                                                <RadioButton Classes="permissionState" Content="{l:Text sessionPermissions.inherit}" IsChecked="{Binding IsInherited}"/>
                                                <RadioButton Classes="permissionState allow" Content="{l:Text sessionPermissions.allow}" IsChecked="{Binding IsAllowed}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SettingsCardBorderBrush}"/>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="24,14" ColumnDefinitions="*, Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource ErrorBrush}" Text="{Binding GeneralError}"
                       IsVisible="{Binding GeneralError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding CloseCommand}" IsCancel="True" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource CrossIcon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Text common.cancel}"/>
                    </StackPanel>
                </Button>

                <Button Classes="primary" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" HorizontalContentAlignment="Left">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsBusy}">
                            <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource DisketteIcon}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Text common.save}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                    IsVisible="{Binding IsBusy}">
                            <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                            IsIndeterminate="True" BorderThickness="2"
                                                            Foreground="{DynamicResource OnAccentTextBrush}"/>
                            <TextBlock Text="{l:Text common.saving}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
