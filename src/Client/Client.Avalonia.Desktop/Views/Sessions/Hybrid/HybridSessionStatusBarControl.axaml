<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:text="clr-namespace:Client.Avalonia.Controls.Text;assembly=Client.Avalonia.Controls"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             xmlns:validation="clr-namespace:Shared.Validation;assembly=Shared.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:indicators="clr-namespace:Client.Avalonia.Controls.Indicators;assembly=Client.Avalonia.Controls"
             xmlns:hybrid="clr-namespace:Client.Views.Sessions.Hybrid"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:hybridVm="clr-namespace:Client.ViewModels.Sessions.Hybrid;assembly=Client.Avalonia.ViewModels"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="56"
             x:DataType="hybridVm:HybridSessionStatusBarVM"
             x:Class="Client.Views.Sessions.Hybrid.HybridSessionStatusBarControl">

    <UserControl.Styles>
        <!-- The same look as the session actions of the main window: flat, lit on hover, and a state
             that matters stays colored -->
        <Style Selector=":is(Button).barAction">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector=":is(Button).barAction /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector=":is(Button).barAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PeerItemHoverBrush}"/>
        </Style>
        <Style Selector="ToggleButton.barAction:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PeerItemSelectedBrush}"/>
        </Style>
        <!-- A screen that is being shared stays visible at a glance -->
        <Style Selector="Button.barAction.sharing /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        </Style>
        <Style Selector=":is(Button).barAction Image">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource GeneralBrush}" ColumnDefinitions="*, Auto" ColumnSpacing="12">

        <!-- The session and the state of its connection -->
        <Grid Grid.Column="0" ColumnDefinitions="Auto, *" ColumnSpacing="6" Margin="8,0,0,0">
            <!-- Opens the statistics of the connection -->
            <Button Grid.Column="0" Classes="ghost" Padding="4" VerticalAlignment="Center"
                    ToolTip.Tip="{l:Text hybrid.stats.open}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <hybrid:HybridSessionStatsFlyout DataContext="{Binding Stats}"/>
                    </Flyout>
                </Button.Flyout>
                <Panel Width="24" Height="24">
                    <loadingIndicators:ProgressRing Width="20" Height="20" MinWidth="20" MinHeight="20"
                                                    IsIndeterminate="True"
                                                    BorderThickness="3"
                                                    Foreground="{DynamicResource ProgressRingBrush}"
                                                    IsVisible="{Binding IsLoading}"/>
                    <indicators:SignalIndicator Width="22" Height="22" Level="{Binding Stats.SignalLevel}"
                                                IsVisible="{Binding IsConnected}"/>
                    <Image Width="20" Height="20" Source="{Binding IconKey, Converter={x:Static converters:IconKeyConverter.Instance}}">
                        <Image.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsLoading"/>
                                <Binding Path="!IsConnected"/>
                            </MultiBinding>
                        </Image.IsVisible>
                    </Image>
                </Panel>
            </Button>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <text:MarqueeTextBlock Text="{Binding SessionName}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                <text:MarqueeTextBlock Text="{Binding ShortStatusText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,10,0" VerticalAlignment="Center">

            <!-- What we send -->
            <Button Classes="barAction"
                    Command="{Binding ToggleMicrophoneCommand}"
                    ToolTip.Tip="{l:Text main.voice.toggleMicrophone}">
                <Panel>
                    <Image Source="{StaticResource MicrophoneIcon}" IsVisible="{Binding IsMicrophoneOn}"/>
                    <Image Source="{StaticResource CrossedMicrophoneIcon}" IsVisible="{Binding !IsMicrophoneOn}"/>
                </Panel>
            </Button>

            <!-- What we hear -->
            <Button Classes="barAction"
                    Command="{Binding ToggleSoundCommand}"
                    ToolTip.Tip="{l:Text main.voice.toggleSound}">
                <Panel>
                    <Image Source="{StaticResource HeadphonesIcon}" IsVisible="{Binding IsSoundOn}"/>
                    <Image Source="{StaticResource CrossedHeadphonesIcon}" IsVisible="{Binding !IsSoundOn}"/>
                </Panel>
            </Button>

            <!-- Away from the keyboard: the reason is asked on the way out, the way back is one press -->
            <Button Classes="barAction"
                    IsVisible="{Binding !IsAfk}"
                    ToolTip.Tip="{l:Text hybrid.afk.go}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="6" Width="240">
                            <TextBox Text="{Binding AfkReasonDraft}"
                                     PlaceholderText="{l:Text hybrid.afk.reason.placeholder}"
                                     MaxLength="{x:Static validation:Limits.ReasonMaxLength}"/>
                            <Button HorizontalAlignment="Right"
                                    Content="{l:Text hybrid.afk.confirm}"
                                    IsDefault="True"
                                    menus:FlyoutMenu.CloseOnClick="True"
                                    Command="{Binding ToggleAfkCommand}"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <Image Source="{StaticResource AfkIcon}"/>
            </Button>
            <Button Classes="barAction sharing"
                    IsVisible="{Binding IsAfk}"
                    Command="{Binding ToggleAfkCommand}"
                    ToolTip.Tip="{Binding AfkHint}">
                <Image Source="{StaticResource AfkIcon}"/>
            </Button>

            <Button Classes="barAction"
                    IsVisible="{Binding !IsScreenShareOn}"
                    Command="{Binding ToggleScreenShareCommand}"
                    ToolTip.Tip="{l:Text main.voice.toggleScreenShare}">
                <Image Source="{StaticResource ScreenShareIcon}"/>
            </Button>

            <!-- A running share is changed or stopped from a menu -->
            <Button Classes="barAction sharing"
                    IsVisible="{Binding IsScreenShareOn}"
                    ToolTip.Tip="{l:Text main.voice.toggleScreenShare}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="2">
                            <menus:MenuItemButton Icon="{StaticResource GearIcon}"
                                                  Content="{l:Text hybrid.screen.change}"
                                                  menus:FlyoutMenu.CloseOnClick="True"
                                                  Command="{Binding ChangeScreenShareCommand}"/>
                            <menus:MenuItemButton Classes="danger" Icon="{StaticResource ScreenShareIcon}"
                                                  Content="{l:Text hybrid.screen.stop}"
                                                  menus:FlyoutMenu.CloseOnClick="True"
                                                  Command="{Binding ToggleScreenShareCommand}"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <Image Source="{StaticResource ScreenShareIcon}"/>
            </Button>

            <Border Width="1" Height="20" Margin="4,0" Background="{DynamicResource SettingsCardBorderBrush}"/>

            <!-- How the session is shown -->
            <Button Classes="barAction"
                    Command="{Binding ToggleFullscreenCommand}"
                    ToolTip.Tip="{l:Text hybrid.fullscreen}">
                <Image Source="{StaticResource FullscreenIcon}"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
