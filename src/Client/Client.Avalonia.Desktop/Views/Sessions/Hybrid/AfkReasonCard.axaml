<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             xmlns:validation="clr-namespace:Shared.Validation;assembly=Shared.Core"
             xmlns:hybridVm="clr-namespace:Client.ViewModels.Sessions.Hybrid;assembly=Client.Avalonia.ViewModels"
             x:DataType="hybridVm:HybridSessionStatusBarVM"
             x:Class="Client.Views.Sessions.Hybrid.AfkReasonCard">

    <!-- Going away from the keyboard: what happens, a reason picked with one press or typed, and the way out -->
    <UserControl.Styles>
        <Style Selector="Button.afkPreset">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsCardBackgroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style Selector="Button.afkPreset:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsCardBackgroundBrush}"/>
        </Style>
        <Style Selector="TextBlock.afkCaption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Width="300" Margin="10" Spacing="14">

        <!-- What happens -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Panel Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{DynamicResource WarningBrush}" Opacity="0.18"/>
                <Ellipse Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" Opacity="0.6"/>
                <Image Width="24" Height="24" Source="{StaticResource AfkIcon}"/>
            </Panel>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{l:Text hybrid.afk.title}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{l:Text hybrid.afk.subtitle}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- One press goes away with a ready reason -->
        <StackPanel Spacing="6">
            <TextBlock Classes="afkCaption" Text="{l:Text hybrid.afk.presets}"/>
            <ItemsControl ItemsSource="{Binding AfkPresets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Classes="afkPreset"
                                Content="{Binding}"
                                menus:FlyoutMenu.CloseOnClick="True"
                                Command="{Binding $parent[ItemsControl].((hybridVm:HybridSessionStatusBarVM)DataContext).GoAfkWithPresetCommand}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Or one's own words -->
        <StackPanel Spacing="4">
            <TextBox Text="{Binding AfkReasonDraft}"
                     PlaceholderText="{l:Text hybrid.afk.reason.placeholder}"
                     MaxLength="{x:Static validation:Limits.ReasonMaxLength}"/>
            <TextBlock Classes="afkCaption" HorizontalAlignment="Right" Text="{Binding AfkReasonCounter}"/>
        </StackPanel>

        <Button Classes="primary"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="10,8"
                IsDefault="True"
                menus:FlyoutMenu.CloseOnClick="True"
                Command="{Binding ToggleAfkCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Width="18" Height="18" Source="{StaticResource AfkIcon}"/>
                <TextBlock Text="{l:Text hybrid.afk.confirm}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
