<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
        xmlns:common="clr-namespace:Client.Views.Common"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hybridVm="clr-namespace:Client.ViewModels.Sessions.Hybrid;assembly=Client.Avalonia.ViewModels"
        xmlns:controls="clr-namespace:Client.Avalonia.Controls;assembly=Client.Avalonia.Controls"
        xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="740"
        x:Class="Client.Views.Sessions.Hybrid.HybridSessionSettingsView"
        x:DataType="hybridVm:HybridSessionSettingsWindowVM"
        Background="{DynamicResource GeneralBrush}"
        MaxWidth="440" HorizontalAlignment="Stretch"
        MaxHeight="760">

    <common:DialogLayout>

        <!-- Header -->
        <common:DialogHeader Grid.Row="0" Icon="{StaticResource GearIcon}"
                             Title="{l:Text sessionSettings.title}" Subtitle="{l:Text sessionSettings.hint}"/>

        <Border Grid.Row="1" Classes="dialogSeparator"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="384" HorizontalAlignment="Stretch" Margin="{StaticResource DialogBodyMargin}" Spacing="18" IsEnabled="{Binding !IsBusy}">

                <!-- Name -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.name}"/>
                    <TextBox x:Name="NameInput"
                             PlaceholderText="{l:Text createSession.name.watermark}"
                             Text="{Binding Name}"
                             Classes.invalid="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TextBlock Classes="fieldError" Text="{Binding NameError}"
                               IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>

                <!-- Capacity -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="fieldLabel" Text="{l:Text createSession.field.participants}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumericUpDown Width="140"
                                       Value="{Binding Capacity}"
                                       Minimum="{Binding CapacityMin}"
                                       Maximum="{Binding CapacityMax}"
                                       Increment="1"
                                       FormatString="0"
                                       ParsingNumberStyle="Integer"
                                       Classes.invalid="{Binding CapacityError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding CapacityHint}"/>
                    </StackPanel>
                    <TextBlock Classes="fieldError" Text="{Binding CapacityError}"
                               IsVisible="{Binding CapacityError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>

                <!-- Approval -->
                <StackPanel Spacing="4">
                    <CheckBox Content="{l:Text sessionSettings.approval}" IsChecked="{Binding IsApprovalRequested}"/>
                    <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:Text sessionSettings.approval.hint}"/>
                </StackPanel>

                <!-- Media: the advanced part, folded until asked for -->
                <controls:ExpandableSection Title="{l:Text sessionSettings.media}"
                                            Description="{l:Text sessionSettings.media.hint}"
                                            Icon="{StaticResource VideoCameraIcon}">
                    <StackPanel Spacing="18">

                        <!-- Codecs -->
                        <Grid ColumnDefinitions="*, 160" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Grid.Row="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{l:Text sessionSettings.media.cameraCodec}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding CameraCodec}"/>
                            <TextBlock Grid.Row="1" Classes="fieldLabel" VerticalAlignment="Center" Text="{l:Text sessionSettings.media.screenCodec}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding ScreenCodec}"/>
                            <TextBlock Grid.Row="2" Classes="fieldLabel" VerticalAlignment="Center" Text="{l:Text sessionSettings.media.audioCodec}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AudioCodecs}" SelectedItem="{Binding AudioCodec}"/>
                        </Grid>

                        <!-- Video losses -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="{l:Text sessionSettings.media.video}"/>
                            <CheckBox Content="{l:Text sessionSettings.media.nack}" IsChecked="{Binding IsVideoNackEnabled}"/>
                            <CheckBox Content="{l:Text sessionSettings.media.videoRtx}"
                                      IsChecked="{Binding IsVideoRtxEnabled}" IsEnabled="{Binding IsVideoNackEnabled}"/>
                            <Grid ColumnDefinitions="*, 160" ColumnSpacing="12">
                                <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:Text sessionSettings.media.keyFrameDelay}"/>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding KeyFrameRequestDelayMs}"
                                               Minimum="{Binding KeyFrameRequestDelayMin}"
                                               Maximum="{Binding KeyFrameRequestDelayMax}"
                                               Increment="100" FormatString="0" ParsingNumberStyle="Integer"/>
                            </Grid>
                        </StackPanel>

                        <!-- Audio losses -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="{l:Text sessionSettings.media.audio}"/>
                            <CheckBox Content="{l:Text sessionSettings.media.opusFec}" IsChecked="{Binding IsOpusFecEnabled}"/>
                            <Grid ColumnDefinitions="*, 160" ColumnSpacing="12" IsEnabled="{Binding IsOpusFecEnabled}">
                                <TextBlock Classes="hint" VerticalAlignment="Center" Text="{l:Text sessionSettings.media.opusLoss}"/>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding OpusPacketLossPercent}"
                                               Minimum="0" Maximum="100"
                                               Increment="5" FormatString="0" ParsingNumberStyle="Integer"/>
                            </Grid>
                            <CheckBox Content="{l:Text sessionSettings.media.nack}" IsChecked="{Binding IsAudioNackEnabled}"/>
                            <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:Text sessionSettings.media.audioNack.hint}"/>
                            <CheckBox Content="{l:Text sessionSettings.media.voiceDtx}" IsChecked="{Binding IsVoiceDtxEnabled}"/>
                        </StackPanel>

                        <!-- Receive buffers -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="{l:Text sessionSettings.media.buffers}"/>
                            <Grid ColumnDefinitions="*, 160" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="8">
                                <TextBlock Grid.Row="0" Classes="hint" VerticalAlignment="Center" Text="{l:Text sessionSettings.media.voiceBuffer}"/>
                                <NumericUpDown Grid.Row="0" Grid.Column="1"
                                               Value="{Binding VoiceJitterBufferMs}"
                                               Minimum="{Binding JitterBufferMin}"
                                               Maximum="{Binding JitterBufferMax}"
                                               Increment="10" FormatString="0" ParsingNumberStyle="Integer"/>
                                <TextBlock Grid.Row="1" Classes="hint" VerticalAlignment="Center" Text="{l:Text sessionSettings.media.videoBuffer}"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1"
                                               Value="{Binding VideoJitterBufferMs}"
                                               Minimum="{Binding JitterBufferMin}"
                                               Maximum="{Binding JitterBufferMax}"
                                               Increment="10" FormatString="0" ParsingNumberStyle="Integer"/>
                            </Grid>
                            <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:Text sessionSettings.media.buffers.hint}"/>
                        </StackPanel>
                    </StackPanel>
                </controls:ExpandableSection>

                <!-- A failure that belongs to no single field -->
                <Border Padding="10,8" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        IsVisible="{Binding GeneralError, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <Image Width="18" Height="18" VerticalAlignment="Top" Source="{StaticResource WarningIcon}"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Text="{Binding GeneralError}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Classes="dialogSeparator"/>

        <!-- Footer -->
        <Grid Grid.Row="4" Classes="dialogFooter" ColumnDefinitions="*, Auto">
            <SelectableTextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                 Text="{Binding SessionId, StringFormat='ID: {0}'}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding CloseCommand}" IsCancel="True" HorizontalContentAlignment="Left" AutomationProperties.Name="{l:Text common.cancel}">
                    <common:ActionLabel Icon="{StaticResource CrossIcon}" Text="{l:Text common.cancel}"/>
                </Button>

                <Button Classes="primary" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" HorizontalContentAlignment="Left" AutomationProperties.Name="{l:Text common.save}">
                    <Grid>
                        <common:ActionLabel HorizontalAlignment="Left" IsVisible="{Binding !IsBusy}" Icon="{StaticResource DisketteIcon}" Text="{l:Text common.save}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                    IsVisible="{Binding IsBusy}">
                            <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                            IsIndeterminate="True" BorderThickness="2"
                                                            Foreground="{DynamicResource OnAccentTextBrush}"/>
                            <TextBlock Text="{l:Text common.saving}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </common:DialogLayout>
</UserControl>
