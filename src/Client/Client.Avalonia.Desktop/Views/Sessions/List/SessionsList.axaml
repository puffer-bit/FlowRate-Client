<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:common="clr-namespace:Client.Views.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:listVm="clr-namespace:Client.ViewModels.Sessions.List;assembly=Client.Avalonia.ViewModels"
             xmlns:listViews="clr-namespace:Client.Views.Sessions.List"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.Sessions.List.SessionsList"
             x:DataType="listVm:SessionsListVM"
             d:DataContext="{d:DesignInstance Type=listVm:SessionsListVM, IsDesignTimeCreatable=True}"
             x:Name="Root">
    
    <UserControl.Styles>
        <!-- The list from before a lost connection stays, but takes no input until it is loaded again -->
        <Style Selector="ListBox.sessionsList:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="ListBox.sessionsList">
            <Setter Property="anim:Presence.Appear" Value="Fade"/>
        </Style>
        <!-- The rows of a collapsed category stay in the list, hidden, and drop in again on expanding -->
        <Style Selector="ListBox.sessionsList > ListBoxItem" x:DataType="listVm:ISessionListRow">
            <Setter Property="IsVisible" Value="{Binding !IsFolded}"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- A right click where there is no session: what can be added to the list. The rows have
             menus of their own, so this one opens only on the empty part -->
        <Flyout x:Key="CreateMenu" Placement="Pointer">
            <StackPanel Spacing="2" x:DataType="listVm:SessionsListVM">
                <menus:MenuItemButton Icon="{StaticResource PlusIcon}" Content="{l:Text main.createSession}"
                                      menus:FlyoutMenu.CloseOnClick="True"
                                      IsVisible="{Binding CanCreateSession}"
                                      Command="{Binding CreateSessionCommand}"/>
                <menus:MenuItemButton Icon="{StaticResource FolderPlusIcon}" Content="{l:Text main.createCategory}"
                                      menus:FlyoutMenu.CloseOnClick="True"
                                      IsVisible="{Binding CanCreateCategory}"
                                      Command="{Binding CreateCategoryCommand}"/>
            </StackPanel>
        </Flyout>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="12,8" IsVisible="{Binding CanCreate}">
            <TextBlock Text="{l:Text privateChats.showPrivate}" IsVisible="{Binding IsPrivateMode}" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="{l:Text privateChats.showChannels}" IsVisible="{Binding !IsPrivateMode}" FontWeight="SemiBold" FontSize="12"/>
        </StackPanel>
    <Grid x:Name="ListArea" Background="{DynamicResource GeneralBrush}">
        <common:StatePanel IsVisible="{Binding IsOffline}" Icon="{StaticResource PlugIcon}"
                           Title="{l:Text sessions.notConnected.title}" Text="{l:Text sessions.notConnected.text}">
            <Button Classes="primary" Command="{Binding ConnectCommand}" HorizontalAlignment="Center"
                    MinWidth="110" Content="{l:Text connect.button}"/>
        </common:StatePanel>
        <common:StatePanel IsVisible="{Binding IsReconnecting}" IsBusy="True" Title="{l:Text sessions.connectionLost.title}" Text="{l:Text sessions.connectionLost.text}"/>
        <common:StatePanel IsVisible="{Binding IsLoading}" IsBusy="True" Text="{l:Text sessions.retrieving}"/>
        <common:StatePanel IsVisible="{Binding IsFailed}" Icon="{StaticResource DashInCircleIcon}" Text="{Binding ErrorMessage}"/>
        <common:StatePanel IsVisible="{Binding IsEmpty}" Icon="{StaticResource TipIcon}">
            <TextBlock>
                <Run x:Name="EmptyHintBeforeIcon"/>
                <InlineUIContainer>
                    <Image Width="24" Height="24"
                         Source="{StaticResource PlusIcon}"/>
                </InlineUIContainer>
                <Run x:Name="EmptyHintAfterIcon"/>
            </TextBlock>
        </common:StatePanel>
        <ListBox x:Name="SessionsListBox"
                 Classes="sessionsList byContent"
                 ItemsSource="{Binding Rows}"
                 IsVisible="{Binding HasSessions}"
                 IsEnabled="{Binding !IsStale}"
                 SelectedItem="{Binding SelectedSession}"
                 Background="Transparent"
                 SelectionMode="Single">

            <ListBox.DataTemplates>
                
                <DataTemplate DataType="listVm:HybridSessionVM">
                    <listViews:SessionListItemHybridView/>
                </DataTemplate>

                <DataTemplate DataType="listVm:ChatSessionVM">
                    <listViews:SessionListChatItemView/>
                </DataTemplate>

                <DataTemplate DataType="listVm:SessionCategoryVM">
                    <listViews:SessionListCategoryView/>
                </DataTemplate>

            </ListBox.DataTemplates>

        </ListBox>

        <!-- The name of a dragged row and the line where it lands; drawn over the list, never hit -->
        <Canvas x:Name="DragLayer" IsHitTestVisible="False" ClipToBounds="False"/>

    </Grid>
    </DockPanel>
</UserControl>
