<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
        xmlns:text="clr-namespace:Client.Avalonia.Controls.Text;assembly=Client.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:listVm="clr-namespace:Client.ViewModels.Sessions.List;assembly=Client.Avalonia.ViewModels"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.Sessions.List.SessionListChatItemView"
             x:DataType="listVm:ChatSessionVM"
             d:DataContext="{d:DesignInstance Type=listVm:ChatSessionVM, IsDesignTimeCreatable=True}"
             x:Name="Root">
    
    <Control.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
    </Control.Resources>
    
    <Grid RowDefinitions="Auto, *" RowSpacing="2" IsVisible="{Binding CanView}"
          anim:Presence.Leave="Fold"
          anim:Presence.IsLeaving="{Binding IsLeaving}">
        <Border Classes="sessionHeader"
            Classes.shown="{Binding IsShown}"
            Classes.dragged="{Binding IsDragged}"
            Tag="{Binding}">
            <Border.ContextFlyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Spacing="2">
                        <menus:MenuItemButton Icon="{StaticResource HashIcon}" Content="{l:Text sessions.openChat}"
                                              menus:FlyoutMenu.CloseOnClick="True"
                                              Command="{Binding DataContext.ShowSessionCommand, ElementName=Root}"
                                              CommandParameter="{Binding DataContext.Model, ElementName=Root}"/>
                        <menus:MenuItemButton Icon="{StaticResource GearIcon}" Content="{l:Text sessionPermissions.title}"
                                              menus:FlyoutMenu.CloseOnClick="True"
                                              IsVisible="{Binding DataContext.CanEditPermissions, ElementName=Root}"
                                              Command="{Binding DataContext.EditPermissionsCommand, ElementName=Root}"
                                              CommandParameter="{Binding DataContext.Model, ElementName=Root}"/>
                        <Separator/>
                        <menus:MenuItemButton Icon="{StaticResource ExpandIcon}" Content="{l:Text sessions.moveTo}"
                                              IsVisible="{Binding DataContext.CanArrange, ElementName=Root}">
                            <menus:MenuItemButton.Flyout>
                                <Flyout Placement="RightEdgeAlignedTop">
                                    <!-- The session goes along as the parameter, the template cannot name the view -->
                                    <ItemsControl ItemsSource="{Binding DataContext.MoveTargets, ElementName=Root}"
                                                  Tag="{Binding DataContext, ElementName=Root}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="listVm:MoveTargetVM">
                                                <menus:MenuItemButton Content="{Binding Name}"
                                                                      menus:FlyoutMenu.CloseOnClick="True"
                                                                      Command="{Binding MoveHereCommand}"
                                                                      CommandParameter="{Binding $parent[ItemsControl].Tag}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </menus:MenuItemButton.Flyout>
                        </menus:MenuItemButton>
                        <!-- One item, shown by the state it would change -->
                        <menus:MenuItemButton Icon="{StaticResource CrossedBellIcon}" Content="{l:Text sessions.muteNotifications}"
                                              menus:FlyoutMenu.CloseOnClick="True"
                                              IsVisible="{Binding !DataContext.IsMuted, ElementName=Root}"
                                              Command="{Binding DataContext.ToggleMuteCommand, ElementName=Root}"
                                              CommandParameter="{Binding DataContext.Model.Id, ElementName=Root}"/>
                        <menus:MenuItemButton Icon="{StaticResource BellIcon}" Content="{l:Text sessions.unmuteNotifications}"
                                              menus:FlyoutMenu.CloseOnClick="True"
                                              IsVisible="{Binding DataContext.IsMuted, ElementName=Root}"
                                              Command="{Binding DataContext.ToggleMuteCommand, ElementName=Root}"
                                              CommandParameter="{Binding DataContext.Model.Id, ElementName=Root}"/>
                        <Separator IsVisible="{Binding DataContext.CanManage, ElementName=Root}"/>
                        <menus:MenuItemButton Classes="danger" Icon="{StaticResource TrashIcon}" Content="{l:Text common.delete}"
                                              menus:FlyoutMenu.CloseOnClick="True"
                                              IsVisible="{Binding DataContext.CanManage, ElementName=Root}"
                                              Command="{Binding DataContext.DeleteSessionCommand, ElementName=Root}"
                                              CommandParameter="{Binding DataContext.Model.Id, ElementName=Root}"/>
                    </StackPanel>
                </Flyout>
            </Border.ContextFlyout>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                <Image Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center"
                       Source="{StaticResource HashIcon}"/>

                <text:MarqueeTextBlock Grid.Column="1" Classes="sessionName" Text="{Binding Model.Name}"
                           Classes.unread="{Binding HasUnread}"
                           ToolTip.Tip="{Binding Model.Name}"/>
                

                <!-- Mentions take the place of the plain counter. A muted chat shows its crossed bell in
                     the same place: it has no plain counter, and a mention outranks the bell -->
                <Panel Grid.Column="2" VerticalAlignment="Center">
                    <Image Width="18" Height="18"
                           IsVisible="{Binding ShowsMutedMark}"
                           ToolTip.Tip="{l:Text sessions.notificationsMuted}"
                           Source="{StaticResource CrossedBellIcon}"/>
                    <Border Classes="unreadBadge" IsVisible="{Binding ShowsUnreadCount}">
                        <TextBlock Text="{Binding UnreadCountText}"/>
                    </Border>
                    <Border Classes="unreadBadge mention" IsVisible="{Binding ShowsMentionCount}">
                        <TextBlock Text="{Binding MentionCountText}"/>
                    </Border>
                </Panel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
