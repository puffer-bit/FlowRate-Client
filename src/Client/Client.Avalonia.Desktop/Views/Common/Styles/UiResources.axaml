<ResourceDictionary xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="DialogHeaderPadding">20,16,20,14</Thickness>
    <Thickness x:Key="DialogBodyMargin">20,16</Thickness>
    <Thickness x:Key="DialogFooterMargin">20,12</Thickness>
    <Thickness x:Key="SettingsHeaderPadding">16,10,10,10</Thickness>
    <Thickness x:Key="SettingsPageMargin">12</Thickness>
    <CornerRadius x:Key="SurfaceCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <x:Double x:Key="DialogTitleFontSize">18</x:Double>
    <x:Double x:Key="SectionTitleFontSize">16</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="IconButtonSize">32</x:Double>
    <x:Double x:Key="SmallIconSize">16</x:Double>
    <x:Double x:Key="NavigationIconSize">32</x:Double>
    <x:Double x:Key="NavigationRowHeight">40</x:Double>
    <x:Double x:Key="SessionHeaderHeight">56</x:Double>
    <x:Double x:Key="ChatSidePanelWidth">260</x:Double>
</ResourceDictionary>
