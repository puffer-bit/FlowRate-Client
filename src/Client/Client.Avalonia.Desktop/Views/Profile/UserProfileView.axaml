<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:profileVm="clr-namespace:Client.ViewModels.Profile;assembly=Client.Avalonia.ViewModels"
             xmlns:menus="clr-namespace:Client.Avalonia.Controls.Menus;assembly=Client.Avalonia.Controls"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="380"
             x:Class="Client.Views.Profile.UserProfileView"
             x:DataType="profileVm:UserProfileWindowVM"
             Background="{DynamicResource GeneralBrush}"
             Width="460">

    <Grid RowDefinitions="Auto,1,Auto,1,Auto">
        <!-- Header follows the create-session dialog and stays visible while the profile scrolls. -->
        <StackPanel Grid.Row="0" Margin="20,16,20,14" Orientation="Horizontal" Spacing="8">
            <Image Width="20" Height="20" Source="{StaticResource BaseUserIcon}" VerticalAlignment="Center"/>
            <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Text="{l:Text main.profile.title}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource DarkBackgroundBrush}"/>

        <ScrollViewer Grid.Row="2" MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16" Spacing="10">
                <Border Padding="12" CornerRadius="8" Background="{DynamicResource SettingsCardBackgroundBrush}">
                    <StackPanel Spacing="10" IsEnabled="{Binding !IsBusy}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <avatars:UserAvatar Width="64" Height="64" VerticalAlignment="Top"
                                                UserName="{Binding Name}"
                                                AvatarUrl="{Binding ShownAvatarUrl}"
                                                Source="{Binding AvatarPicker.Avatar}"
                                                Status="{Binding Status}">
                                <avatars:UserAvatar.Overlay>
                                    <avatars:AvatarEditButton Command="{Binding ChangeAvatarCommand}" IsVisible="{Binding IsCurrentUser}"/>
                                </avatars:UserAvatar.Overlay>
                            </avatars:UserAvatar>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                                     Text="{Binding Username}" IsVisible="{Binding !IsEditing}"/>
                                <TextBlock Classes="hint" Text="{Binding StatusText}"/>
                                <SelectableTextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                                     Text="{Binding UserId, StringFormat='ID: {0}'}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Button Classes="ghost" Command="{Binding ResetAvatarCommand}"
                                        Content="{l:Text profile.avatar.reset}"/>
                            </WrapPanel>
                            <TextBlock Classes="hint" Text="{l:Text profile.avatar.resetsOnSave}"
                                       IsVisible="{Binding IsAvatarReset}"/>
                            <TextBlock Classes="fieldError" Text="{Binding AvatarPicker.AvatarError}"
                                       IsVisible="{Binding AvatarPicker.AvatarError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
                            <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.name}"/>
                            <TextBox x:Name="NameInput" PlaceholderText="{l:Text profile.name.short}"
                                     Text="{Binding Name}"
                                     Classes.invalid="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <TextBlock Classes="fieldError" Text="{Binding NameError}"
                                       IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <TextBlock Classes="hint" Text="{Binding NameHint}"
                                       IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="12" CornerRadius="8" Background="{DynamicResource SettingsCardBackgroundBrush}"
                        IsVisible="{Binding HasRoles}" IsEnabled="{Binding !IsBusy}">
                    <!-- Role changes are applied immediately, independently of profile editing. -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasRoles}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="fieldLabel" VerticalAlignment="Center" Text="{l:Text profile.field.roles}"/>
                            <Button Grid.Column="1" Classes="ghost" IsVisible="{Binding CanManageRoles}"
                                    IsEnabled="{Binding !IsChangingRole}" ToolTip.Tip="{l:Text roles.permission.manageRoles}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Width="16" Height="16" Source="{StaticResource PencilIcon}"/>
                                    <TextBlock Text="{l:Text common.edit}"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="2">
                                            <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding ManageableRoles}" IsEnabled="{Binding !IsChangingRole}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="profileVm:UserRoleVM">
                                                            <menus:MenuItemButton
                                                                Command="{Binding $parent[ItemsControl].((profileVm:UserProfileWindowVM)DataContext).ToggleRoleCommand}"
                                                                CommandParameter="{Binding}">
                                                                <menus:MenuItemButton.IconContent>
                                                                    <Image Source="{StaticResource MarkIcon}" IsVisible="{Binding IsAssigned}"/>
                                                                </menus:MenuItemButton.IconContent>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                             Fill="{DynamicResource PrimaryTextBrush}"
                                                                             IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                             Fill="{Binding Color, Converter={x:Static converters:RoleColorConverter.Instance}}"
                                                                             IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap" Text="{Binding Name}"/>
                                                                </StackPanel>
                                                            </menus:MenuItemButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock Classes="fieldError" Margin="8,4" MaxWidth="280" Text="{Binding RoleError}"
                                                       IsVisible="{Binding RoleError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AssignedRoles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="10" LineSpacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="profileVm:UserRoleVM">
                                    <Grid>
                                        <Border Padding="8,4" CornerRadius="8" Background="{DynamicResource DarkBackgroundBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{DynamicResource PrimaryTextBrush}"
                                                         IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{Binding Color, Converter={x:Static converters:RoleColorConverter.Instance}}"
                                                         IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="fieldError" TextWrapping="Wrap" Text="{Binding RoleError}"
                                   IsVisible="{Binding RoleError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </Border>

                <Border Padding="12" CornerRadius="8" Background="{DynamicResource SettingsCardBackgroundBrush}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="fieldLabel" VerticalAlignment="Center" Text="{l:Text profile.note.title}"/>
                            <loadingIndicators:ProgressRing Grid.Column="1" Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                            IsIndeterminate="True" BorderThickness="2" IsVisible="{Binding Note.IsBusy}"/>
                        </Grid>
                        <TextBlock Classes="hint" Text="{l:Text profile.note.hint}"/>
                        <TextBox Text="{Binding Note.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="64" MaxHeight="120" VerticalContentAlignment="Top"
                                 IsEnabled="{Binding Note.IsLoaded}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="{l:Text profile.note.placeholder}"/>
                        <TextBlock Classes="hint" Text="{l:Text profile.note.saved}" IsVisible="{Binding Note.IsSaved}"/>
                        <TextBlock Classes="fieldError" Text="{Binding Note.Error}"
                                   IsVisible="{Binding Note.Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Command="{Binding Note.LoadCommand}" IsVisible="{Binding !Note.IsLoaded}"
                                HorizontalAlignment="Left" Content="{l:Text serverSettings.users.retry}"/>
                    </StackPanel>
                </Border>

                <Border Padding="12" CornerRadius="8" Background="{DynamicResource SettingsCardBackgroundBrush}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Classes="fieldLabel" MaxWidth="160" TextWrapping="Wrap"
                                   Text="{l:Text profile.field.firstConnected}"/>
                        <SelectableTextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                                             Text="{Binding FirstConnected}"/>
                        <TextBlock Grid.Row="1" Classes="fieldLabel" MaxWidth="160" TextWrapping="Wrap"
                                   Text="{l:Text profile.field.lastConnected}"/>
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                                             Text="{Binding LastConnected}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Background="{DynamicResource DarkBackgroundBrush}"/>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="20,12" ColumnDefinitions="*">
            <!-- Viewing -->
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                <Button Command="{Binding CloseCommand}" IsCancel="{Binding !IsEditing}" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource CrossIcon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Text common.close}"/>
                    </StackPanel>
                </Button>

                <Button Classes="primary" Command="{Binding EditCommand}" MinWidth="110" HorizontalContentAlignment="Left"
                        IsVisible="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource PencilIcon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Text common.edit}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Editing -->
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                <Button Command="{Binding CancelEditCommand}" IsCancel="{Binding IsEditing}" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource CrossIcon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Text common.cancel}"/>
                    </StackPanel>
                </Button>

                <Button Classes="primary" Command="{Binding SaveCommand}" IsDefault="{Binding IsEditing}" MinWidth="110" HorizontalContentAlignment="Left">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsBusy}">
                            <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource DisketteIcon}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Text common.save}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                    IsVisible="{Binding IsBusy}">
                            <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                            IsIndeterminate="True" BorderThickness="2"
                                                            Foreground="{DynamicResource OnAccentTextBrush}"/>
                            <TextBlock Text="{l:Text common.saving}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
