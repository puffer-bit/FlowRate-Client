<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:profileVm="clr-namespace:Client.ViewModels.Profile;assembly=Client.Avalonia.ViewModels"
             xmlns:converters="clr-namespace:Client.Avalonia.Controls.Converters;assembly=Client.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="320"
             x:Class="Client.Views.Profile.UserProfileView"
             x:DataType="profileVm:UserProfileWindowVM"
             Background="{DynamicResource GeneralBrush}"
             Width="460">

    <Grid RowDefinitions="Auto, 1, Auto, 1, Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,16,20,14" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Width="20" Height="20" Source="{StaticResource BaseUserIcon}" VerticalAlignment="Center"/>
                <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Text="{l:Text main.profile.title}"/>
            </StackPanel>
            <TextBlock Classes="hint" Text="{l:Text profile.view.hint}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource DarkBackgroundBrush}"/>

        <!-- Profile -->
        <Grid Grid.Row="2" Margin="20,18" ColumnDefinitions="Auto, *" ColumnSpacing="20" IsEnabled="{Binding !IsBusy}">

            <!-- Avatar -->
            <StackPanel Grid.Column="0" Spacing="8" Width="112">
                <avatars:UserAvatar Width="96" Height="96" HorizontalAlignment="Center"
                                    UserName="{Binding Username}"
                                    AvatarUrl="{Binding ShownAvatarUrl}"
                                    Source="{Binding AvatarPicker.Avatar}"
                                    Status="{Binding Status}"/>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding AvatarPicker.ChooseAvatarCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsEditing"/>
                            <Binding Path="IsCurrentUser"/>
                        </MultiBinding>
                    </Button.IsVisible>
                    <TextBlock Text="{l:Text profile.avatar.chooseImage}" FontSize="12"/>
                </Button>

                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding ResetAvatarCommand}"
                        IsVisible="{Binding IsEditing}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Width="16" Height="16" Source="{StaticResource ResetIcon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Text profile.avatar.reset}" FontSize="12"/>
                    </StackPanel>
                </Button>

                <TextBlock Classes="hint" TextAlignment="Center" Text="{l:Text profile.avatar.resetsOnSave}"
                           IsVisible="{Binding IsAvatarReset}"/>

                <TextBlock Classes="fieldError" TextAlignment="Center" Text="{Binding AvatarPicker.AvatarError}"
                           IsVisible="{Binding AvatarPicker.AvatarError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="14">

                <!-- Name -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.name}"/>

                    <SelectableTextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                         Text="{Binding Username}"
                                         IsVisible="{Binding !IsEditing}"/>

                    <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
                        <TextBox x:Name="NameInput"
                                 PlaceholderText="{l:Text profile.name.short}"
                                 Text="{Binding Name}"
                                 Classes.invalid="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="fieldError" Text="{Binding NameError}"
                                   IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="hint" Text="{Binding NameHint}"
                                   IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNull}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Roles: those the user has, and those the current user may give; a click gives or takes -->
                <StackPanel Spacing="6" IsVisible="{Binding HasRoles}">
                    <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.roles}"/>
                    <ItemsControl ItemsSource="{Binding Roles}" IsEnabled="{Binding !IsChangingRole}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="10" LineSpacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="profileVm:UserRoleVM">
                                <CheckBox IsChecked="{Binding IsAssigned, Mode=OneWay}"
                                          IsEnabled="{Binding CanChange}"
                                          Command="{Binding $parent[ItemsControl].((profileVm:UserProfileWindowVM)DataContext).ToggleRoleCommand}"
                                          CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{DynamicResource SecondaryTextBrush}"
                                                 IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNull}}"/>
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={x:Static converters:RoleColorConverter.Instance}}"
                                                 IsVisible="{Binding Color, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="fieldError" TextWrapping="Wrap" Text="{Binding RoleError}"
                               IsVisible="{Binding RoleError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>

                <!-- Connections -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.firstConnected}"/>
                        <TextBlock Text="{Binding FirstConnected}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.lastConnected}"/>
                        <TextBlock Text="{Binding LastConnected}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource DarkBackgroundBrush}"/>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="20,12" ColumnDefinitions="*, Auto">
            <SelectableTextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                 Text="{Binding UserId, StringFormat='ID: {0}'}"/>

            <!-- Viewing -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsEditing}">
                <Button Command="{Binding CloseCommand}" IsCancel="{Binding !IsEditing}" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource CrossIcon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Text common.close}"/>
                    </StackPanel>
                </Button>

                <Button Classes="primary" Command="{Binding EditCommand}" MinWidth="110" HorizontalContentAlignment="Left"
                        IsVisible="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource PencilIcon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Text common.edit}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Editing -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsEditing}">
                <Button Command="{Binding CancelEditCommand}" IsCancel="{Binding IsEditing}" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource CrossIcon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Text common.cancel}"/>
                    </StackPanel>
                </Button>

                <Button Classes="primary" Command="{Binding SaveCommand}" IsDefault="{Binding IsEditing}" MinWidth="110" HorizontalContentAlignment="Left">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsBusy}">
                            <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource DisketteIcon}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Text common.save}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                    IsVisible="{Binding IsBusy}">
                            <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                            IsIndeterminate="True" BorderThickness="2"
                                                            Foreground="{DynamicResource OnAccentTextBrush}"/>
                            <TextBlock Text="{l:Text common.saving}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
