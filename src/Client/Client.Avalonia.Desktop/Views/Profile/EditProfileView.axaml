<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:profileVm="clr-namespace:Client.ViewModels.Profile;assembly=Client.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="340"
             x:Class="Client.Views.Profile.EditProfileView"
             x:DataType="profileVm:EditProfileWindowVM"
             Background="{DynamicResource GeneralBrush}"
             Width="460">

    <Grid RowDefinitions="Auto, 1, Auto, 1, Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,16,20,14" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Width="20" Height="20" Source="{StaticResource BaseUserIcon}" VerticalAlignment="Center"/>
                <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Text="{l:Text main.profile.title}"/>
            </StackPanel>
            <TextBlock Classes="hint" Text="{l:Text profile.edit.hint}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource DarkBackgroundBrush}"/>

        <ScrollViewer Grid.Row="2" MaxHeight="480" HorizontalScrollBarVisibility="Disabled">
            <Border Margin="20,16" Padding="12" CornerRadius="8"
                    Background="{DynamicResource SettingsCardBackgroundBrush}">
                <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <avatars:UserAvatar Width="64" Height="64"
                                            UserName="{Binding Name}"
                                            AvatarUrl="{Binding ShownAvatarUrl}"
                                            Source="{Binding AvatarPicker.Avatar}">
                            <avatars:UserAvatar.Overlay>
                                <avatars:AvatarEditButton Command="{Binding AvatarPicker.ChooseAvatarCommand}"/>
                            </avatars:UserAvatar.Overlay>
                        </avatars:UserAvatar>

                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <SelectableTextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                                 Text="{Binding UserId, StringFormat='ID: {0}'}"
                                                 IsVisible="{Binding UserId, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Button Classes="ghost" Command="{Binding RemoveAvatarCommand}"
                                        Content="{l:Text common.remove}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="fieldError" Text="{Binding AvatarPicker.AvatarError}"
                               IsVisible="{Binding AvatarPicker.AvatarError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <!-- Name -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="{l:Text profile.field.name}"/>
                        <TextBox x:Name="NameInput"
                                 PlaceholderText="{l:Text profile.name.yours}"
                                 Text="{Binding Name}"
                                 Classes.invalid="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="fieldError" Text="{Binding NameError}"
                                   IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="hint" Text="{Binding NameHint}"
                                   IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNull}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource DarkBackgroundBrush}"/>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="20,12" ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding CloseCommand}" IsCancel="True" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource CrossIcon}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Text common.cancel}"/>
                    </StackPanel>
                </Button>

                <Button Classes="primary" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" HorizontalContentAlignment="Left">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsBusy}">
                            <Image Margin="0,1,0,0" Width="16" Height="16" Source="{StaticResource DisketteIcon}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Text common.save}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                    IsVisible="{Binding IsBusy}">
                            <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                            IsIndeterminate="True" BorderThickness="2"
                                                            Foreground="{DynamicResource OnAccentTextBrush}"/>
                            <TextBlock Text="{l:Text common.saving}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
