<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:avatars="clr-namespace:Client.Avalonia.Controls.Avatars;assembly=Client.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pagesVm="clr-namespace:Client.ViewModels.Settings.Pages;assembly=Client.Avalonia.ViewModels"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             x:DataType="pagesVm:AppearanceControlVM"
             x:Class="Client.Views.Settings.Pages.ChatPreview">

    <UserControl.Styles>
        <!-- The chat of the preview: the window background, and the box and the send button of the composer -->
        <Style Selector="Border.chatPreview">
            <Setter Property="Background" Value="{DynamicResource GeneralBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="MaxWidth" Value="620"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.chatPreview Border.composer">
            <Setter Property="Background" Value="{DynamicResource BackgroundGeneralBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PeerItemHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Border.chatPreview Border.send">
            <Setter Property="Background" Value="{DynamicResource ButtonMainBrush}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="chatPreview">
        <StackPanel>
            <StackPanel Margin="6" Spacing="4">
                <TextBlock Text="{l:Text date.today}" FontSize="12" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,10"/>

                <Border Classes="msg-root">
                    <Grid ColumnDefinitions="46, *">
                        <avatars:UserAvatar Classes="msg-avatar"
                                            UserName="{l:Text settings.appearance.preview.chat.user}"/>
                        <StackPanel Grid.Column="1" Classes="msg-content">
                            <StackPanel Classes="msg-header">
                                <TextBlock Classes="msg-username"
                                           Text="{l:Text settings.appearance.preview.chat.user}"/>
                                <TextBlock Classes="msg-time" Text="12:40"/>
                            </StackPanel>
                            <TextBlock Classes="msg-body"
                                       Text="{l:Text settings.appearance.preview.chat.question}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="msg-root">
                    <Grid ColumnDefinitions="46, *">
                        <avatars:UserAvatar Classes="msg-avatar"
                                            UserName="{l:Text settings.appearance.preview.chat.me}"/>
                        <StackPanel Grid.Column="1" Classes="msg-content">
                            <StackPanel Classes="msg-header">
                                <TextBlock Classes="msg-username"
                                           Text="{l:Text settings.appearance.preview.chat.me}"/>
                                <TextBlock Classes="msg-time" Text="12:41"/>
                            </StackPanel>
                            <Button Classes="msg-reply">
                                <Border Classes="msg-reply-body">
                                    <StackPanel>
                                        <TextBlock Classes="msg-reply-username"
                                                   Text="{l:Text settings.appearance.preview.chat.user}"/>
                                        <TextBlock Classes="msg-reply-text"
                                                   Text="{l:Text settings.appearance.preview.chat.question}"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <TextBlock Classes="msg-body"
                                       Text="{l:Text settings.appearance.preview.chat.answer}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- A continuation: no avatar and no name, the text lines up with the message above -->
                <Border Classes="msg-root">
                    <Grid ColumnDefinitions="46, *">
                        <TextBlock Grid.Column="1" Classes="msg-body"
                                   Text="{l:Text settings.appearance.preview.chat.continuation}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Padding="12">
                <Border Classes="composer">
                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="4">
                        <Image Grid.Column="0" Width="20" Height="20" Margin="8" VerticalAlignment="Center"
                               Source="{StaticResource ClipIcon}"/>
                        <TextBlock Grid.Column="1" Margin="6,0" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{l:Text settings.appearance.preview.chat.input}"/>
                        <Border Grid.Column="2" Classes="send">
                            <!-- Paper plane pointing right, drawn on an 18 px grid -->
                            <Path Width="18" Height="18" Stretch="None"
                                  Stroke="{DynamicResource OnAccentTextBrush}" StrokeThickness="1.75"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M3,3 L16.5,9 L3,15 L5.25,9 Z M5.25,9 H10.5"/>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
