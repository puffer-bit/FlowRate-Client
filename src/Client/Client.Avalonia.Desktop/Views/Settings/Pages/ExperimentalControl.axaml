<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:Client.Avalonia.Controls;assembly=Client.Avalonia.Controls"
             xmlns:services="clr-namespace:Client.Services;assembly=Client.Avalonia.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pagesVm="clr-namespace:Client.ViewModels.Settings.Pages;assembly=Client.Avalonia.ViewModels"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:ui="clr-namespace:Client.Avalonia.Controls.Settings;assembly=Client.Avalonia.Controls"
             x:Class="Client.Views.Settings.Pages.ExperimentalControl"
             x:DataType="pagesVm:ExperimentalControlVM">
    <ui:SettingsPage>
        <StackPanel Spacing="4" Margin="0,0,0,8" IsVisible="{x:Static services:LaunchSettings.HasOverrides}">
            <TextBlock Text="{l:Text settings.launchOverrides}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="{x:Static services:LaunchSettings.ActiveOptions}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="experimental.enable">
                <CheckBox IsChecked="{Binding IsExperimentalEnabled}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader services:SettingText.Section="experimental.window"/>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="experimental.customTitleBar"
                            IsEnabled="{Binding IsExperimentalEnabled}">
                <CheckBox IsChecked="{Binding UseCustomTitleBar}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader services:SettingText.Section="experimental.voice"/>
        <ui:SettingsCard IsEnabled="{Binding IsMediaEnabled}">
            <ui:SettingsRow services:SettingText.Key="experimental.gstreamer"
                            IsEnabled="{Binding IsExperimentalEnabled}">
                <CheckBox IsChecked="{Binding UseGStreamer}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>
        <TextBlock Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                   Text="{Binding LibWebRTCError}"
                   IsVisible="{Binding LibWebRTCError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </ui:SettingsPage>
</UserControl>
