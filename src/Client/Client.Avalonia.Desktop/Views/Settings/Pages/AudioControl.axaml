<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:text="clr-namespace:Client.Avalonia.Controls.Text;assembly=Client.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pagesVm="clr-namespace:Client.ViewModels.Settings.Pages;assembly=Client.Avalonia.ViewModels"
             xmlns:controls="clr-namespace:Client.Avalonia.Controls;assembly=Client.Avalonia.Controls"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:services="clr-namespace:Client.Services;assembly=Client.Avalonia.ViewModels"
             xmlns:banners="clr-namespace:Client.Avalonia.Controls.Banners;assembly=Client.Avalonia.Controls"
             xmlns:ui="clr-namespace:Client.Avalonia.Controls.Settings;assembly=Client.Avalonia.Controls"
             xmlns:indicators="clr-namespace:Client.Avalonia.Controls.Indicators;assembly=Client.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.Settings.Pages.AudioControl"
             x:DataType="pagesVm:AudioControlVM">
    <UserControl.Styles>
        <!-- Saved device that is not connected right now -->
        <Style Selector="TextBlock.unavailable">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="indicators|VoiceGateMeter">
            <Setter Property="LevelBrush" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <!-- The voice gate would send what the microphone hears -->
        <Style Selector="indicators|VoiceGateMeter.voiceDetected">
            <Setter Property="LevelBrush" Value="{DynamicResource SuccessBrush}"/>
        </Style>
    </UserControl.Styles>

    <ui:SettingsPage>
        <StackPanel Spacing="4" Margin="0,0,0,8" IsVisible="{x:Static services:LaunchSettings.HasOverrides}">
            <TextBlock Text="{l:Text settings.launchOverrides}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="{x:Static services:LaunchSettings.ActiveOptions}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        <banners:WarningBanner IsVisible="{Binding !IsMediaEnabled}" Margin="0,0,0,8"
                               Header="{l:Text media.disabled.title}"
                               Message="{l:Text media.disabled.settings}"/>
        <controls:SettingsHeader services:SettingText.Section="audio.microphone"/>
        <ui:SettingsCard IsEnabled="{Binding IsMediaEnabled}">
            <ui:SettingsRow services:SettingText.Key="audio.inputDevice">
                <ComboBox Width="300"
                          ItemsSource="{Binding InputDevices}"
                          SelectedItem="{Binding SelectedInputDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="pagesVm:AudioInputDeviceItem">
                            <text:MarqueeTextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       Classes.unavailable="{Binding !IsAvailable}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.inputVolume">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Width="240" VerticalAlignment="Center"
                            Minimum="{Binding MinInputVolumePercent}"
                            Maximum="{Binding MaxInputVolumePercent}"
                            Value="{Binding InputVolumePercent}"
                            TickFrequency="5" IsSnapToTickEnabled="True"/>
                    <TextBlock VerticalAlignment="Center" MinWidth="48" TextAlignment="Right"
                               Text="{Binding InputVolumePercent, StringFormat={}{0:0}%}"/>
                </StackPanel>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.noiseSuppression">
                <ComboBox MinWidth="180" SelectedIndex="{Binding NoiseSuppressionIndex}">
                    <ComboBoxItem Content="{l:Text settings.audio.noiseSuppression.off}"/>
                    <ComboBoxItem Content="{l:Text settings.audio.noiseSuppression.low}"/>
                    <ComboBoxItem Content="{l:Text settings.audio.noiseSuppression.moderate}"/>
                    <ComboBoxItem Content="{l:Text settings.audio.noiseSuppression.high}"/>
                    <ComboBoxItem Content="{l:Text settings.audio.noiseSuppression.veryHigh}"/>
                    <ComboBoxItem Content="{l:Text settings.audio.noiseSuppression.neural}"/>
                    <ComboBoxItem Content="{l:Text settings.audio.noiseSuppression.neuralAndWebRtc}"/>
                </ComboBox>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.echoCancellation">
                <CheckBox IsChecked="{Binding IsEchoCancellationEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.autoGainControl">
                <CheckBox IsChecked="{Binding IsAutoGainControlEnabled}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader services:SettingText.Section="audio.voiceActivity"/>
        <ui:SettingsCard IsEnabled="{Binding IsMediaEnabled}">
            <ui:SettingsRow services:SettingText.Key="audio.voiceGate">
                <CheckBox IsChecked="{Binding IsVoiceGateEnabled}"
                          AutomationProperties.Name="{l:Text settings.audio.voiceGate.title}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.testMicrophone">
                <Button MinWidth="140" HorizontalContentAlignment="Center"
                        Content="{Binding TestButtonText}"
                        Command="{Binding ToggleTestCommand}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.inputLevel" ContentPlacement="Below">
                <StackPanel Spacing="10">
                    <Border Background="{DynamicResource BackgroundGeneralBrush}" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="12">
                            <StackPanel IsVisible="{Binding !IsTestRunning}" Spacing="4">
                                <TextBlock FontWeight="Medium" TextWrapping="Wrap"
                                           Text="{l:Text settings.audio.gatePreview.idle}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" Text="{l:Text settings.audio.gatePreview.startHint}"/>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsTestRunning}">
                                <StackPanel IsVisible="{Binding IsVoiceGateEnabled}">
                                    <TextBlock IsVisible="{Binding IsVoiceDetected}" FontWeight="Medium"
                                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                                               Text="{l:Text settings.audio.gatePreview.open}"/>
                                    <TextBlock IsVisible="{Binding !IsVoiceDetected}" FontWeight="Medium" TextWrapping="Wrap"
                                               Text="{l:Text settings.audio.gatePreview.closed}"/>
                                </StackPanel>
                                <TextBlock IsVisible="{Binding !IsVoiceGateEnabled}" FontWeight="Medium" TextWrapping="Wrap"
                                           Text="{l:Text settings.audio.gatePreview.disabled}"/>
                            </StackPanel>
                            <indicators:VoiceGateMeter Height="32" Level="{Binding InputLevel}"
                                                      ThresholdDb="{Binding VoiceGateThresholdDb}"
                                                      ShowThreshold="{Binding IsVoiceGateEnabled}"
                                                      Classes.voiceDetected="{Binding IsVoiceDetected}"
                                                      TrackBrush="{DynamicResource SettingsCardBorderBrush}"
                                                      MarkerBrush="{DynamicResource PrimaryTextBrush}"
                                                      AutomationProperties.Name="{l:Text settings.audio.inputLevel.title}"/>
                            <Grid ColumnDefinitions="*,*,*" Margin="10,-4,10,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="−60"/>
                                <TextBlock Grid.Column="1" FontSize="11" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Text="−40"/>
                                <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Text="−20"/>
                                <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Text="{l:Text settings.audio.gatePreview.scaleMax}"/>
                            </Grid>
                            <StackPanel Spacing="6" IsVisible="{Binding IsVoiceGateEnabled}"
                                        ui:SettingsPage.SearchKey="audio.voiceThreshold">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap"
                                               Text="{l:Text settings.audio.voiceThreshold.title}"/>
                                    <Border Grid.Column="1" CornerRadius="5" Padding="8,4" Margin="8,0,0,0"
                                            Background="{DynamicResource SettingsCardBackgroundBrush}">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding VoiceGateThresholdDb, StringFormat={}{0:0} dB}"/>
                                    </Border>
                                </Grid>
                                <Slider Minimum="{Binding MinVoiceGateThresholdDb}"
                                        Maximum="{Binding MaxVoiceGateThresholdDb}"
                                        Value="{Binding VoiceGateThresholdDb}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="{l:Text settings.audio.voiceThreshold.title}"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{l:Text settings.audio.gatePreview.moreSensitive}"/>
                                    <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{l:Text settings.audio.gatePreview.lessSensitive}"/>
                                </Grid>
                                <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{l:Text settings.audio.gatePreview.tuneHint}"/>
                                <TextBlock IsVisible="{Binding IsAdaptiveThresholdEnabled}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{l:Text settings.audio.gatePreview.adaptiveHint}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                               Text="{Binding TestError}"
                               IsVisible="{Binding TestError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.hearMyself">
                <CheckBox IsChecked="{Binding IsLoopbackEnabled}"/>
            </ui:SettingsRow>
            <!-- These options refine the gate and apply while it is enabled. -->
            <ui:SettingsRow services:SettingText.Key="audio.voiceDetection" IsEnabled="{Binding IsVoiceGateEnabled}">
                <CheckBox IsChecked="{Binding IsVoiceDetectionEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.adaptiveThreshold" IsEnabled="{Binding IsVoiceGateEnabled}">
                <CheckBox IsChecked="{Binding IsAdaptiveThresholdEnabled}"/>
            </ui:SettingsRow>
        </ui:SettingsCard>

        <controls:SettingsHeader services:SettingText.Section="audio.sounds"/>
        <ui:SettingsCard>
            <ui:SettingsRow services:SettingText.Key="audio.soundsEnabled">
                <CheckBox IsChecked="{Binding AreSoundsEnabled}"/>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.soundsVolume" IsExpanded="{Binding AreSoundsEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Width="240" VerticalAlignment="Center"
                            Minimum="{Binding MinSoundsVolumePercent}"
                            Maximum="{Binding MaxSoundsVolumePercent}"
                            Value="{Binding SoundsVolumePercent}"
                            TickFrequency="5" IsSnapToTickEnabled="True"/>
                    <TextBlock VerticalAlignment="Center" MinWidth="48" TextAlignment="Right"
                               Text="{Binding SoundsVolumePercent, StringFormat={}{0:0}%}"/>
                </StackPanel>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.soundPack" IsExpanded="{Binding AreSoundsEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox MinWidth="180"
                              ItemsSource="{Binding SoundPacks}"
                              SelectedItem="{Binding SelectedSoundPack}"
                              DropDownOpened="OnSoundPacksOpened">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="pagesVm:SoundPackItem">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{l:Text settings.audio.soundPack.openFolder}"
                            Click="OnOpenSoundPacksFolder"/>
                </StackPanel>
            </ui:SettingsRow>
            <ui:SettingsRow services:SettingText.Key="audio.soundEvents" IsExpanded="{Binding AreSoundsEnabled}">
                <ToggleButton Name="SoundListToggle" Classes="expander"
                              IsCheckedChanged="OnSoundListToggled"/>
            </ui:SettingsRow>
            <!-- Folded and unfolded by the arrow of the row above; the page remembers which it was -->
            <ui:SettingsRow Name="SoundListRow" ContentPlacement="Below"
                            IsExpanded="{Binding AreSoundsEnabled}">
                <ItemsControl ItemsSource="{Binding Sounds}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pagesVm:SoundItemVM">
                            <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="36">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Text="{Binding Title}"/>
                                <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center"
                                        Command="{Binding PlayCommand}"
                                        ToolTip.Tip="{l:Text settings.audio.soundEvents.listen}">
                                    <Image Width="16" Height="16" Source="{StaticResource PlayIcon}"/>
                                </Button>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:SettingsRow>
        </ui:SettingsCard>
    </ui:SettingsPage>
</UserControl>
