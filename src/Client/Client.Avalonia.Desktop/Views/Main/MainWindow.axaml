<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mainVm="clr-namespace:Client.ViewModels.Main;assembly=Client.Avalonia.ViewModels"
        xmlns:mainViews="clr-namespace:Client.Views.Main;assembly=Client.Avalonia.Views.Desktop"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Client.Views.Main.MainWindow"
        x:DataType="mainVm:MainWindowVM"
        MinHeight="560"
        MinWidth="900"
        Width="1300"
        Height="800"
        Title="FlowRate"
        x:Name="Main"
        WindowDecorationsTheme="{DynamicResource BorderlessWindowDecorations}"
        TransparencyLevelHint="Transparent"
        BorderBrush="{DynamicResource DialogBorderBrush}">
    
    <mainViews:MainView x:Name="MainViewControl"/>
</Window>
