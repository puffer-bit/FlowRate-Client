<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:connectVm="clr-namespace:Client.ViewModels.Connections;assembly=Client.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="280"
             x:Class="Client.Views.Dialogs.LoginPromptDialog"
             x:DataType="connectVm:LoginPromptVM"
             MinWidth="380"
             MaxWidth="480">

    <Grid RowDefinitions="Auto, Auto, Auto">
        <!-- Shown inside the main window, so the title is part of the content -->
        <TextBlock Grid.Row="0" Text="{l:Text loginPrompt.title}" FontSize="16" FontWeight="SemiBold" Margin="20,16,20,0"/>

        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="20,12,20,0">
            <Image Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top"
                   Source="{StaticResource KeyQuestionIcon}"/>

            <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="12">
                <TextBlock TextWrapping="Wrap" Text="{Binding Text}"/>

                <StackPanel Spacing="6" IsVisible="{Binding IsPasswordAsked}">
                    <TextBlock Classes="fieldLabel" Text="{l:Text loginPrompt.password}"/>
                    <TextBox x:Name="PasswordInput"
                             Classes="password"
                             Text="{Binding Password}"
                             RevealPassword="{Binding IsPasswordVisible, Mode=TwoWay}"
                             Classes.invalid="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <CheckBox IsChecked="{Binding RememberPassword}" Content="{l:Text loginPrompt.remember}"/>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsCodeAsked}">
                    <TextBlock Classes="fieldLabel" Text="{l:Text loginPrompt.code}"/>
                    <TextBox x:Name="CodeInput"
                             Text="{Binding Code}"
                             MaxLength="12"
                             PlaceholderText="000000"
                             Classes.invalid="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:Text loginPrompt.code.hint}"/>
                </StackPanel>

                <TextBlock Classes="fieldError" TextWrapping="Wrap" Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20,16,20,16">
            <Button Content="{l:Text common.cancel}" Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Classes="primary" Content="{l:Text loginPrompt.confirm}" Command="{Binding ConfirmCommand}"
                    IsDefault="True" MinWidth="110"/>
        </StackPanel>
    </Grid>
</UserControl>
