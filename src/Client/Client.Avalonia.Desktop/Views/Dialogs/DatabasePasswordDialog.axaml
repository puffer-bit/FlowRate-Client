<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:dialogVm="clr-namespace:Client.ViewModels.Dialogs;assembly=Client.Avalonia.ViewModels"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="260"
             x:Class="Client.Views.Dialogs.DatabasePasswordDialog"
             x:DataType="dialogVm:DatabasePasswordVM"
             MinWidth="380"
             MaxWidth="480">

    <Grid RowDefinitions="Auto, Auto, Auto">
        <!-- Shown inside the main window, so the title is part of the content -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="20,16,20,0"/>

        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="20,12,20,0">
            <Image Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top"
                   Source="{StaticResource KeyQuestionIcon}"/>

            <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="12" IsEnabled="{Binding !IsBusy}">
                <TextBlock TextWrapping="Wrap" Text="{Binding Text}"/>

                <StackPanel Spacing="6">
                    <TextBlock Classes="fieldLabel" Text="{l:Text databasePassword.password}"/>
                    <TextBox Classes="password"
                             Text="{Binding Password}"
                             RevealPassword="{Binding IsPasswordVisible, Mode=TwoWay}"
                             Classes.invalid="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsConfirmationNeeded}">
                    <TextBlock Classes="fieldLabel" Text="{l:Text databasePassword.confirmation}"/>
                    <!-- Revealed together with the first one -->
                    <TextBox Classes="password"
                             Text="{Binding Confirmation}"
                             RevealPassword="{Binding IsPasswordVisible, Mode=TwoWay}"
                             Classes.invalid="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>

                <TextBlock Classes="fieldError" TextWrapping="Wrap" Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20,16,20,16">
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Classes="primary" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="110">
                <Panel>
                    <TextBlock Text="{Binding ConfirmText}" HorizontalAlignment="Center"
                               IsVisible="{Binding !IsBusy}"/>
                    <!-- Encrypting rewrites the whole file, which takes a moment on a large one -->
                    <loadingIndicators:ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                    IsIndeterminate="True" BorderThickness="2"
                                                    Foreground="{DynamicResource OnAccentTextBrush}"
                                                    IsVisible="{Binding IsBusy}"/>
                </Panel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
