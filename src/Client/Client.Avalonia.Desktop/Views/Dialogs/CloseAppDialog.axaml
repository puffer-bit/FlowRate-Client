<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:hints="clr-namespace:Client.Avalonia.Controls.Hints;assembly=Client.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="200"
             x:Class="Client.Views.Dialogs.CloseAppDialog"
             MinWidth="380"
             MaxWidth="520">

    <Grid RowDefinitions="Auto, Auto, Auto">
        <!-- Shown inside the main window, so the title is part of the content -->
        <TextBlock Grid.Row="0" Text="{l:Text closeApp.title}" FontSize="16" FontWeight="SemiBold" Margin="20,16,20,0"/>

        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="20,12,20,0">
            <Image Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top"
                   Source="{StaticResource QuestionInCurcleIcon}"/>
            <!-- The choice sits right under the question, not under the taller icon -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="8">
                <TextBlock TextWrapping="Wrap" Text="{l:Text closeApp.question}"/>
                <StackPanel Spacing="4">
                    <CheckBox x:Name="RememberChoiceCheckBox" Content="{l:Text closeApp.remember}"/>
                    <hints:HintBlock Text="{l:Text closeApp.hint}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20,16,20,16">
            <Button Content="{l:Text common.cancel}" IsCancel="True" Click="OnCancelClick"/>
            <Button Content="{l:Text tray.exit}" Classes="danger" Click="OnExitClick"/>
            <Button Classes="primary" Content="{l:Text closeApp.minimize}" IsDefault="True" Click="OnMinimizeToTrayClick"/>
        </StackPanel>
    </Grid>
</UserControl>
