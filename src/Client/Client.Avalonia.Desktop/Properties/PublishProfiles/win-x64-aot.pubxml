<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained release for win-x64 compiled ahead of time (NativeAOT): one native executable with
     no .NET runtime and no IL inside, which starts at once. The GStreamer runtime from
     Client.GStreamer/Build/artifacts/win-x64 ships with the application. The same release on the
     .NET runtime is win-x64-jit.
     dotnet publish Client.Avalonia.Desktop.csproj -p:PublishProfile=win-x64-aot -r win-x64

     Only on Windows: NativeAOT does not compile for another system. Needs the C++ build tools of Visual Studio. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Every assembly is compiled into the executable, the GStreamer binding (GstSharp.Net, LGPL)
         too: it is no longer a file the user can replace, they rebuild the client from its source
         instead. The native libraries and the GStreamer runtime stay next to the executable. -->
    <PublishAot>true</PublishAot>
    <!-- No debug symbols in a release, neither in the executable nor next to it -->
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>bin\publish\win-x64-aot\</PublishDir>
  </PropertyGroup>
</Project>
