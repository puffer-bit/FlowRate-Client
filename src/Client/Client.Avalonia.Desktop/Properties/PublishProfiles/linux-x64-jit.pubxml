<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained release for linux-x64 that runs on the .NET runtime (JIT): the runtime and the GStreamer
     runtime from Client.GStreamer/Build/artifacts/linux-x64 ship with the application. The same release
     compiled ahead of time is linux-x64-aot.
     dotnet publish Client.Avalonia.Desktop.csproj -p:PublishProfile=linux-x64-jit -r linux-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- One executable with the managed assemblies and the .NET runtime inside. The native libraries
         stay next to it instead of being extracted to a cache folder on every new version, as do the
         LGPL libraries (ExcludeLgplFromSingleFile in the project) and the GStreamer runtime. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Partial trimming: only assemblies marked trimmable lose unused code (.NET itself, Avalonia,
         ReactiveUI, Skia, ...). Ours and the reflection-heavy ones (EF Core, the GLib/GStreamer bindings,
         Tmds.DBus) stay whole. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- No debug symbols in a release: they were a third of its size -->
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>bin\publish\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
