<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hints="clr-namespace:Client.Avalonia.Controls.Hints">
    <Design.PreviewWith>
        <hints:HintBlock Width="300" Text="Ending a session signs that device out of the account"/>
    </Design.PreviewWith>

    <!-- A hint is a quiet note: a small grey "i" drawn in the color of its text, and plain text -->
    <Style Selector="hints|HintBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6">
                    <Panel x:Name="PART_Icon" Grid.Column="0" Width="16" Height="16" Margin="0,1,0,0"
                           VerticalAlignment="Top">
                        <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"/>
                        <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineCap="Round"
                              Data="M8,7.2 L8,11.6"/>
                        <Ellipse Fill="{TemplateBinding Foreground}" Width="2" Height="2"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,4,0,0"/>
                    </Panel>
                    <TextBlock x:Name="PART_Text"
                               Grid.Column="1"
                               FontSize="13"
                               Foreground="{TemplateBinding Foreground}"
                               TextWrapping="Wrap"
                               Text="{TemplateBinding Text}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- A hint of a disabled setting fades with it -->
    <Style Selector="hints|HintBlock:disabled /template/ Panel#PART_Icon">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="hints|HintBlock:disabled /template/ TextBlock#PART_Text">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
</Styles>
