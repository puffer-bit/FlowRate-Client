<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Avalonia.Controls.LoadingIndicators.PulseLoadingIndicator"
             ClipToBounds="False"
             Color="{DynamicResource ButtonMainBrush}">
    
    <Grid ClipToBounds="False">
        <Ellipse Name="GlowRing"
                 Fill="{Binding #Root.Color}"
                 Width="32" Height="32"
                 anim:ShownState.Track="True">
            <Ellipse.Styles>
                <Style Selector="Ellipse:shown">
                    <Style.Animations>
                        <Animation Duration="0:0:2" IterationCount="Infinite" Easing="LinearEasing">
                            <KeyFrame KeyTime="0:0:0">
                                <Setter Property="ScaleTransform.ScaleX" Value="0.6"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="0.6"/>
                                <Setter Property="Opacity" Value="0.4"/>
                            </KeyFrame>
                            <KeyFrame KeyTime="0:0:2">
                                <Setter Property="ScaleTransform.ScaleX" Value="1.4"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="1.4"/>
                                <Setter Property="Opacity" Value="0.0"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Ellipse.Styles>
        </Ellipse>

        <Ellipse Fill="{Binding #Root.Color}" 
                 Width="10" Height="10" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center"/>
    </Grid>
</UserControl>
