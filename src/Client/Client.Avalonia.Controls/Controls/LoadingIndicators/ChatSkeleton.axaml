<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Client.Avalonia.Controls.LoadingIndicators"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             x:Class="Client.Avalonia.Controls.LoadingIndicators.ChatSkeleton"
             x:Name="Root"
             IsHitTestVisible="False"
             Focusable="False"
             ClipToBounds="True">
    <UserControl.Styles>
        <Style Selector="Border.placeholder">
            <Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <!-- A row of the list, or a bubble once the chat draws them -->
        <Style Selector="local|ChatSkeleton Panel.bubble-row">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="local|ChatSkeleton.bubbles Panel.bubble-row">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="local|ChatSkeleton.bubbles Grid.list-row">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="StackPanel.pulse.animated:shown">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.12"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.24"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.12"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="SkeletonScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden"
                  ScrollChanged="OnScrollChanged">
    <StackPanel x:Name="Pulse" Classes="pulse"
                Opacity="0.18" anim:ShownState.Track="True">
        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ChatSkeletonRow">
                    <Panel>
                    <Grid Classes="list-row" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="6,8,12,8">
                        <Border Classes="placeholder" Width="36" Height="36" CornerRadius="18"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <Border Classes="placeholder" Width="{Binding NameWidth}" HorizontalAlignment="Left"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding MessageWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Classes="placeholder"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <!-- Others on the left with their avatar, the user's own on the right -->
                    <Panel Classes="bubble-row" Margin="6,3,12,3">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsMine}">
                            <Border Classes="placeholder" Width="32" Height="32" CornerRadius="16"
                                    VerticalAlignment="Bottom"/>
                            <Border Classes="placeholder" Width="{Binding BubbleWidth}" Height="{Binding BubbleHeight}"
                                    CornerRadius="16,16,16,6"/>
                        </StackPanel>
                        <Border Classes="placeholder" Width="{Binding BubbleWidth}" Height="{Binding BubbleHeight}"
                                CornerRadius="16,16,6,16" HorizontalAlignment="Right"
                                IsVisible="{Binding IsMine}"/>
                    </Panel>
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
    </ScrollViewer>
</UserControl>
