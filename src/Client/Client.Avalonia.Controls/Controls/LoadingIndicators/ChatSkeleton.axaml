<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Client.Avalonia.Controls.LoadingIndicators"
             xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
             x:Class="Client.Avalonia.Controls.LoadingIndicators.ChatSkeleton"
             x:Name="Root"
             IsHitTestVisible="False"
             Focusable="False"
             ClipToBounds="True">
    <UserControl.Styles>
        <Style Selector="Border.placeholder">
            <Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Height" Value="10"/>
        </Style>
        <Style Selector="StackPanel.pulse.animated:shown">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.12"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.24"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.12"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <StackPanel x:Name="Pulse" Classes="pulse"
                Opacity="0.18" anim:ShownState.Track="True">
        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ChatSkeletonRow">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="6,8,12,8">
                        <Border Classes="placeholder" Width="36" Height="36" CornerRadius="18"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <Border Classes="placeholder" Width="{Binding NameWidth}" HorizontalAlignment="Left"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding FirstLineWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Classes="placeholder"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding LastLineWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Classes="placeholder"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,2*" IsVisible="{Binding HasThirdLine}">
                                <Border Classes="placeholder"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
