<!-- The card of a flowrate:// link, under the text of a message and above the input of the composer: what the link
     asks for, the server it names and a button to do it. An approval of a device shows a warning and no button. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:buttons="clr-namespace:Client.Avalonia.Controls.Buttons;assembly=Client.Avalonia.Controls"
             xmlns:vm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Views.Shared.Chat.ChatAppLinkCard"
             x:CompileBindings="True" x:DataType="vm:ChatAppLinkVM"
             HorizontalAlignment="Left">
    <Border Classes="msg-link msg-app-link" Classes.warning="{Binding IsWarning}"
            ToolTip.Tip="{Binding Address}">
        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
            <Image Grid.Column="0" Classes="msg-app-link-icon"
                   Source="{StaticResource ServerIcon}" IsVisible="{Binding !IsWarning}"/>
            <Image Grid.Column="0" Classes="msg-app-link-icon"
                   Source="{StaticResource WarningIcon}" IsVisible="{Binding IsWarning}"/>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock Classes="msg-link-site" Text="{Binding Title}"/>
                <TextBlock Classes="msg-link-title" Text="{Binding Server}" IsVisible="{Binding HasServer}"/>
                <!-- The code of a device approval, to be typed in by hand -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,2" IsVisible="{Binding HasCode}">
                    <TextBlock Classes="msg-link-description" VerticalAlignment="Center" Text="{Binding CodeLabel}"/>
                    <SelectableTextBlock Classes="msg-app-link-code" Text="{Binding Code}"/>
                    <buttons:CopyButton Text="{Binding Code}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Classes="msg-link-description" Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"/>
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="1" Classes="primary msg-app-link-action"
                    Content="{Binding ActionText}" IsVisible="{Binding CanOpen}"
                    Click="OnOpenClick"/>
        </Grid>
    </Border>
</UserControl>
