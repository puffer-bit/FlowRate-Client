<!-- The files of an own message on its way, shown from the device until the server has them: pictures and videos
     as tiles, other files as rows. Each shows its compression and upload on a ring, which gives the message up
     when pressed -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             xmlns:l="clr-namespace:Client.Avalonia.Localization;assembly=Client.Avalonia.Localization"
             xmlns:loadingIndicators="clr-namespace:Client.Avalonia.Controls.LoadingIndicators;assembly=Client.Avalonia.Controls"
             x:Class="Client.Views.Shared.Chat.ChatOutgoingAttachments"
             x:CompileBindings="True" x:DataType="vm:ChatMessageVM"
             x:Name="Root"
             HorizontalAlignment="Left">
    <UserControl.Styles>
        <Style Selector="Button.outgoing-ring">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.outgoing-ring.on-picture">
            <Setter Property="Background" Value="#8C000000"/>
        </Style>
        <Style Selector="Button.outgoing-ring.on-picture:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B3000000"/>
        </Style>
        <Style Selector="Button.outgoing-ring.on-file">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="Button.outgoing-ring.on-file:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
        </Style>
        <Style Selector="Path.outgoing-cross">
            <Setter Property="Data" Value="M7,7 L17,17 M17,7 L7,17"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="2.4"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="4">
        <ItemsControl ItemsSource="{Binding OutgoingImages}" IsVisible="{Binding HasOutgoingImages}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ChatAttachmentVM">
                    <Border Width="200" Height="140" Margin="0,4,6,0" CornerRadius="8" ClipToBounds="True"
                            Background="{DynamicResource MsgReplyBrush}"
                            ToolTip.Tip="{Binding FileName}">
                        <Panel>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            <!-- A video has no picture of its own until the server has a frame of it -->
                            <Path IsVisible="{Binding IsVideo}" Width="28" Height="28" Margin="0,0,0,64"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
                                  Data="M4,5 H15 V19 H4 Z M15,10 L20,7 V17 L15,14"
                                  Stroke="#B3FFFFFF" StrokeThickness="1.6" StrokeJoin="Round"/>
                            <Border Background="#40000000"/>
                            <Button Classes="outgoing-ring on-picture" Width="48" Height="48"
                                    Command="{Binding $parent[ItemsControl].((vm:ChatMessageVM)DataContext).Delete}"
                                    ToolTip.Tip="{l:Text chat.outgoing.cancel}"
                                    AutomationProperties.Name="{l:Text chat.outgoing.cancel}">
                                <Panel>
                                    <loadingIndicators:ProgressRing Classes="smooth" Width="44" Height="44"
                                                                    MinWidth="0" MinHeight="0"
                                                                    Maximum="1" Value="{Binding Progress}"
                                                                    IsIndeterminate="{Binding IsPreparing}"
                                                                    BorderThickness="3" Foreground="White"
                                                                    Background="#33FFFFFF"/>
                                    <Path Classes="outgoing-cross" Width="14" Height="14"/>
                                </Panel>
                            </Button>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                    Padding="7,2,7,3" CornerRadius="9" Background="#8C000000">
                                <TextBlock Text="{Binding OutgoingStatusText}" FontSize="11" Foreground="White"/>
                            </Border>
                            <Image Source="{StaticResource WarningIcon}" Width="20" Height="20" Margin="8"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   IsVisible="{Binding HasError}" ToolTip.Tip="{Binding Error}"/>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding OutgoingFiles}" IsVisible="{Binding HasOutgoingFiles}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ChatAttachmentVM">
                    <Border Margin="0,4,0,0" Padding="8" CornerRadius="8" MinWidth="240" MaxWidth="360"
                            HorizontalAlignment="Left" Background="{DynamicResource MsgReplyBrush}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Button Classes="outgoing-ring on-file" Width="40" Height="40" CornerRadius="20"
                                    Command="{Binding $parent[ItemsControl].((vm:ChatMessageVM)DataContext).Delete}"
                                    ToolTip.Tip="{l:Text chat.outgoing.cancel}"
                                    AutomationProperties.Name="{l:Text chat.outgoing.cancel}">
                                <Panel>
                                    <loadingIndicators:ProgressRing Classes="smooth" Width="36" Height="36"
                                                                    MinWidth="0" MinHeight="0"
                                                                    Maximum="1" Value="{Binding Progress}"
                                                                    IsIndeterminate="{Binding IsPreparing}"
                                                                    BorderThickness="2.5" Foreground="White"
                                                                    Background="#40FFFFFF"/>
                                    <Path Classes="outgoing-cross" Width="12" Height="12"/>
                                </Panel>
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding OutgoingStatusText}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           IsVisible="{Binding !HasError}"/>
                                <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           IsVisible="{Binding HasError}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
