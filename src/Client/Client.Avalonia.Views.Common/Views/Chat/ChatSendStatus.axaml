<!-- The mark of an own message on its way, in place of its receipt: a clock while it goes, a red mark once it
     did not. The clock takes the Foreground of the control, so a bubble can draw it in its own colors -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Client.ViewModels.Sessions.Chat;assembly=Client.Avalonia.ViewModels"
             x:Class="Client.Views.Shared.Chat.ChatSendStatus"
             x:CompileBindings="True" x:DataType="vm:ChatMessageVM"
             x:Name="Root"
             Width="16" Height="16"
             Foreground="{DynamicResource SecondaryTextBrush}"
             ToolTip.Tip="{Binding OutgoingStatusText}">
    <Panel>
        <Viewbox IsVisible="{Binding IsSending}">
            <Path Width="24" Height="24"
                  Data="M12,3 A9,9 0 1 1 11.99,3 Z M12,7 V12 L15,14"
                  Stroke="{Binding #Root.Foreground}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round"/>
        </Viewbox>
        <Viewbox IsVisible="{Binding IsSendFailed}">
            <Panel Width="24" Height="24">
                <Ellipse Fill="{DynamicResource ErrorBrush}"/>
                <Path Data="M12,6.5 V13.5 M12,17.4 V17.5"
                      Stroke="White" StrokeThickness="2.8" StrokeLineCap="Round"/>
            </Panel>
        </Viewbox>
    </Panel>
</UserControl>
