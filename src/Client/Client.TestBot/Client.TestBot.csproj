<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <RootNamespace>Client.TestBot</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Client.Api\Client.Api.csproj" />
        <ProjectReference Include="..\Client.Application\Client.Application.csproj" />
        <ProjectReference Include="..\Client.GStreamer\Client.GStreamer.csproj" />
        <ProjectReference Include="..\Client.LibWebRTC\Client.LibWebRTC.csproj" />
        <ProjectReference Include="..\Client.Tools\Client.Tools.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="ProgramLog.cs">
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <None Update="Assets\Audio\test_audio_simplicity.mp3">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Assets\Audio\1.mp3">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Assets\Audio\2.mp3">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <!-- libwebrtc for the libwebrtc option, when Client.LibWebRTC/Native/build.sh made it -->
    <Import Project="..\Client.LibWebRTC\Build\LibWebRTCRuntime.targets" />

</Project>
