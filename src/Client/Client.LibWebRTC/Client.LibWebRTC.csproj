<Project Sdk="Microsoft.NET.Sdk">

    <!-- The voice of hybrid sessions over libwebrtc. Voice/ is the transport every platform shares, over
         a peer of its own: Native/ is the desktop one, over webrtc-sdk/libwebrtc through the C interface
         of Native/flowrate_webrtc.h; Android has one over the libwebrtc of its Java bindings -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Client.Application\Client.Application.csproj" />
      <ProjectReference Include="..\Client.WebRTC\Client.WebRTC.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Client.Application.Tests" />
    </ItemGroup>

</Project>
