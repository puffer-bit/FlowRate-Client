<Project Sdk="Microsoft.NET.Sdk">

    <!-- The voice of hybrid sessions over libwebrtc. Voice/ is the transport every platform shares, over
         a peer of its own: Native/ is the desktop one, over webrtc-sdk/libwebrtc through the C interface
         of Native/flowrate_webrtc.h; Android has one over the libwebrtc of its Java bindings -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Client.Application\Client.Application.csproj" />
      <ProjectReference Include="..\Client.Platform\Client.Platform.csproj" />
      <ProjectReference Include="..\Client.WebRTC\Client.WebRTC.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Client.Application.Tests" />
      <InternalsVisibleTo Include="Client.Audio.SmokeChecks" />
    </ItemGroup>

    <!-- The package carries the committed libwebrtc of every platform as runtimes/<rid>/native, which a
         consumer gets next to its executable on publish and through deps.json on a plain build. Inside
         this repository the executables copy it themselves, see Build/LibWebRTCRuntime.targets -->
    <ItemGroup>
      <None Include="Build/prebuilt/linux-x64/libflowrate_webrtc.so" Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false" />
      <None Include="Build/prebuilt/win-x64/flowrate_webrtc.dll" Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" />
      <None Include="Build/prebuilt/osx-arm64/libflowrate_webrtc.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false" />
      <None Include="Build/prebuilt/linux-x64/LICENSE.libwebrtc" Pack="true" PackagePath="licenses/libwebrtc/" Visible="false" />
    </ItemGroup>

</Project>
