+  // FlowRate: a device whose mix format has more than two channels (a virtual 7.1 one) or another
+  // rate takes none of the formats above, and the stream would never start. Windows converts to
+  // the mix format itself with AUTOCONVERTPCM, as Chromium has it
+  DWORD playConvertFlags = 0;
+  if (hr != S_OK) {
+    Wfx.nChannels = _playChannelsPrioList[0];
+    Wfx.nSamplesPerSec = 48000;
+    Wfx.nBlockAlign = Wfx.nChannels * Wfx.wBitsPerSample / 8;
+    Wfx.nAvgBytesPerSec = Wfx.nSamplesPerSec * Wfx.nBlockAlign;
+    playConvertFlags = AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM | AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY;
+    RTC_LOG(LS_WARNING) << "No rendering format matches the mix format, converted to it from "
+                        << Wfx.nChannels << " channels at " << Wfx.nSamplesPerSec << " Hz";
+    hr = S_OK;
+  }
+
   // TODO(andrew): what happens in the event of failure in the above loop?
