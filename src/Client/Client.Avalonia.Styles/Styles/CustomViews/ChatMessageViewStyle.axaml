<Styles xmlns="https://github.com/avaloniaui"
        xmlns:anim="clr-namespace:Client.Avalonia.Styles.Animation;assembly=Client.Avalonia.Styles"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Client.Avalonia.Icons;assembly=Client.Avalonia.Assets">

    <Styles.Resources>
        <SolidColorBrush x:Key="MsgReplyBrush" Color="{DynamicResource ColorPrimary}" Opacity="0.10"/>
        <SolidColorBrush x:Key="MsgReplyHoverBrush" Color="{DynamicResource ColorPrimary}" Opacity="0.18"/>
        <SolidColorBrush x:Key="MsgReplyPressedBrush" Color="{DynamicResource ColorPrimary}" Opacity="0.26"/>
        <SolidColorBrush x:Key="MsgHighlightBrush" Color="{DynamicResource ColorPrimary}" Opacity="0.22"/>
        <!-- Bubbles: the user's own in a deep accent with white text, dimmed while on their way; the others in
             the color of raised surfaces -->
        <SolidColorBrush x:Key="MsgBubbleMineBrush" Color="{DynamicResource SystemAccentColorDark2}"/>
        <SolidColorBrush x:Key="MsgBubbleMinePendingBrush" Color="{DynamicResource SystemAccentColorDark2}" Opacity="0.55"/>
        <SolidColorBrush x:Key="MsgBubbleMineMetaBrush" Color="White" Opacity="0.75"/>
    </Styles.Resources>
    
    <Style Selector="Button.msg-reaction">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource MsgReplyBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style Selector="Button.msg-reaction.mine">
        <Setter Property="Background" Value="{DynamicResource MsgReplyPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.msg-reaction:pointerover, Button.msg-reaction:focus-visible">
        <Setter Property="Background" Value="{DynamicResource MsgReplyHoverBrush}"/>
    </Style>
    <Style Selector="Button.msg-reaction:pressed">
        <Setter Property="Background" Value="{DynamicResource MsgReplyPressedBrush}"/>
    </Style>

    <Style Selector="Border.msg-root">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6,6,12,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Transitions">
            <Transitions>
                <anim:SmoothBrushTransition Property="Background" Duration="{anim:Motion Medium}" />
            </Transitions>
        </Setter>
    </Style>
    <!-- A message that calls the current user: a yellow background and a bar on the left -->
    <Style Selector="Border.msg-root.mentioned">
        <Setter Property="Background" Value="{DynamicResource MessageMentionedBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MessageMentionedBarBrush}"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Padding" Value="4,6,12,6"/>
    </Style>
    <Style Selector="Border.msg-root:pointerover, Border.msg-root:pressed">
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/> 
    </Style>
    <Style Selector="Border.msg-root.has-opened-flyout">
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/> 
    </Style>
    <Style Selector="Border.msg-root.system, Border.msg-root.system:pointerover, Border.msg-root.system:pressed">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- A message calling the current user stays yellow under the pointer and the menu -->
    <Style Selector="Border.msg-root.mentioned:pointerover, Border.msg-root.mentioned:pressed, Border.msg-root.mentioned.has-opened-flyout">
        <Setter Property="Background" Value="{DynamicResource MessageMentionedHoverBrush}"/>
    </Style>
    <Style Selector="Border.msg-root.highlighted">
        <Setter Property="Background" Value="{DynamicResource MsgHighlightBrush}"/>
    </Style>

    <Style Selector=":is(Control).msg-avatar">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <!-- Top-aligned with the username, which starts at the top of the content -->
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="StackPanel.msg-content">
        <Setter Property="Spacing" Value="4"/>
    </Style>

    <Style Selector="StackPanel.msg-header">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector=":is(TextBlock).msg-username">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <!-- A deleted author keeps a placeholder name, set apart in italics -->
    <Style Selector=":is(TextBlock).msg-username.deleted-user">
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    <Style Selector="TextBlock.msg-time">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorOverlayGray}"/>
    </Style>

    <!-- The pencil at the end of an edited message, drawn like the time -->
    <Style Selector="Path.msg-edited">
        <Setter Property="Data" Value="M16.5 3.5 A2.12 2.12 0 0 1 19.5 6.5 L7.5 18.5 L3 20 L4.5 15.5 Z M14 6 L17 9"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorOverlayGray}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <!-- Filled so that the whole icon answers the pointer, not only its outline -->
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <!-- The time of a continuation shows up only while the message is hovered or its menu is open -->
    <Style Selector="Border.msg-root TextBlock.msg-time.continuation">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border.msg-root:pointerover TextBlock.msg-time.continuation, Border.msg-root.has-opened-flyout TextBlock.msg-time.continuation">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- :is() so it reaches the SelectableTextBlock of the message: a plain TextBlock selector
         matches the exact type only. Wrap (not WrapWithOverflow) also breaks a word longer than
         the line, such as a link, instead of letting it run out of the message -->
    <Style Selector=":is(TextBlock).msg-body">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- A message of a few emoji alone is a picture: large, and all of it in the emoji font, so that
         ☺ or ✔ written without the variation selector are in color too -->
    <Style Selector=":is(TextBlock).msg-body.jumbo">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontFamily" Value="{x:Static icons:EmojiFont.Family}"/>
    </Style>
    <StyleInclude Source="avares://Client.Avalonia.Styles/Styles/CustomViews/ChatMessageTextStyle.axaml"/>

    <!-- Reply quote: a tinted card with an accent bar, clickable to jump to the original -->
    <Style Selector="Button.msg-reply">
        <Setter Property="Background" Value="{DynamicResource MsgReplyBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MaxWidth" Value="520"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- The shared Button styles give the presenter a 1px border on hover and press;
         the quote must keep its size, or the whole list shifts under the cursor -->
    <Style Selector="Button.msg-reply /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MsgReplyBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <anim:SmoothBrushTransition Property="Background" Duration="{anim:Motion Brief}"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.msg-reply:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MsgReplyHoverBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.msg-reply:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MsgReplyPressedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.msg-reply.deleted, Button.msg-reply:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.msg-reply.deleted /template/ ContentPresenter#PART_ContentPresenter, Button.msg-reply:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
    </Style>

    <Style Selector="Border.msg-reply-body">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4,10,5"/>
    </Style>
    <Style Selector="Button.msg-reply.deleted Border.msg-reply-body">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorOverlayGray}"/>
    </Style>

    <Style Selector="TextBlock.msg-reply-username">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryLight}"/>
        <Setter Property="MaxLines" Value="1"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.msg-reply-username.deleted-user">
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    <!-- In a quote the name is drawn as above the author's own messages: the color of their role, or the usual one -->
    <Style Selector="Button.msg-reply TextBlock.msg-reply-username">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style Selector="Button.msg-reply.deleted TextBlock.msg-reply-username">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.msg-reply-text">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="MaxLines" Value="1"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- The text of a quote in a message reads as the message itself; the reply bar keeps it dim -->
    <Style Selector="Button.msg-reply TextBlock.msg-reply-text">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.msg-deleted-text">
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="MaxLines" Value="1"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ====== Images of a message ====== -->
    <Style Selector="ItemsControl.msg-images">
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- A tile shows the reduced copy cut to its shape; until it is loaded the tile is a plain plate
         of the size the image will take, so the messages below do not jump -->
    <Style Selector="Button.msg-image">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <ContentPresenter Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- The global Button:pointerover style outlines the presenter of every button; on a tile the outline
         would draw inside it and make it taller under the pointer, moving the messages below -->
    <Style Selector="Button.msg-image /template/ ContentPresenter, Button.msg-file /template/ ContentPresenter">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.msg-image Image.msg-image-picture">
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <Style Selector="Button.msg-image Image.msg-image-failed">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>

    <!-- The album of a message (ChatAlbumLayout): its tiles meet with a thin gap, and only its outer corners
         are rounded -->
    <Style Selector="Border.msg-media-frame">
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style Selector="Border.msg-album">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.msg-album ItemsControl.msg-images">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Border.msg-album Button.msg-image">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <!-- The time and mark lying on the pictures, in a bubble only -->
    <Style Selector="Border.msg-media-meta">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- The plates of the inline players; in a bubble the bubble is their plate -->
    <Style Selector="Border.msg-audio-card, Border.msg-video-card">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
    </Style>

    <!-- ====== The preview of a link: a tinted card with an accent bar, as a reply quote ====== -->
    <Style Selector="Border.msg-link">
        <Setter Property="Background" Value="{DynamicResource MsgReplyBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,5,10,7"/>
        <Setter Property="Margin" Value="0,4,0,2"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Transitions">
            <Transitions>
                <anim:SmoothBrushTransition Property="Background" Duration="{anim:Motion Brief}"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(UserControl).openable Border.msg-link:pointerover">
        <Setter Property="Background" Value="{DynamicResource MsgReplyHoverBrush}"/>
    </Style>
    <Style Selector="TextBlock.msg-link-site, TextBlock.msg-link-title, TextBlock.msg-link-description">
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="TextBlock.msg-link-site">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryLight}"/>
        <Setter Property="MaxLines" Value="1"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.msg-link-title">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxLines" Value="2"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.msg-link-description">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxLines" Value="4"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Until the picture is loaded its place is a plain plate of its size, so the card does not jump -->
    <Style Selector="Border.msg-link-thumbnail">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Margin" Value="10,2,0,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
    </Style>
    <Style Selector="Border.msg-link-picture">
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
    </Style>

    <!-- ====== The card of a flowrate:// link: a link card with an icon and a button ====== -->
    <Style Selector="Border.msg-app-link.warning">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarning}"/>
    </Style>
    <Style Selector="Border.msg-app-link.warning TextBlock.msg-link-site">
        <Setter Property="Foreground" Value="{DynamicResource ColorWarning}"/>
    </Style>
    <Style Selector="Image.msg-app-link-icon">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="0,2,10,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="SelectableTextBlock.msg-app-link-code">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="monospace"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.msg-app-link-action">
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ====== Files of a message, saved rather than shown ====== -->
    <Style Selector="ItemsControl.msg-files">
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.msg-file">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Width" Value="260"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorOverlayMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Stretch"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.msg-file:pointerover">
        <Setter Property="Background" Value="{DynamicResource ColorOverlay}"/>
    </Style>
    <Style Selector="Button.msg-file.error">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="Button.msg-file Border.msg-file-icon">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
    </Style>
    <Style Selector="Button.msg-file Border.msg-file-icon Image">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.msg-file TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxLines" Value="1"/>
    </Style>
    <Style Selector="Button.msg-file TextBlock.msg-file-size">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="Button.msg-file TextBlock.msg-file-error">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="Button.msg-file ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="MinHeight" Value="3"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
    </Style>

    <!-- ====== A file attached to the message being typed ====== -->
    <!-- Darker than the composer box the cards sit in -->
    <Style Selector="Border.chat-attachment">
        <Setter Property="Background" Value="{DynamicResource GeneralBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorOverlayMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Width" Value="220"/>
    </Style>
    <Style Selector="Border.chat-attachment.error">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="Border.chat-attachment Border.chat-attachment-thumbnail">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
    </Style>
    <!-- A file that is not an image has no picture: the clip stands for it -->
    <Style Selector="Border.chat-attachment Border.chat-attachment-thumbnail Image.chat-attachment-file">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="Border.chat-attachment TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxLines" Value="1"/>
    </Style>
    <Style Selector="Border.chat-attachment TextBlock.chat-attachment-name">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.chat-attachment TextBlock.chat-attachment-size">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="Border.chat-attachment TextBlock.chat-attachment-error">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="Border.chat-attachment ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="MinHeight" Value="3"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
    </Style>

    <!-- ====== An image opened over the chat ====== -->
    <Style Selector="Grid.image-viewer">
        <Setter Property="Background" Value="{DynamicResource DialogBackdropBrush}"/>
    </Style>
    <!-- The whole backdrop is a button that closes the viewer; it shows nothing of its own -->
    <Style Selector="Button.image-viewer-backdrop">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent"/>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.image-viewer-bar">
        <Setter Property="Background" Value="{DynamicResource BackgroundGeneralBrush}"/>
        <Setter Property="Padding" Value="12,6,6,6"/>
    </Style>
    <Style Selector="Border.image-viewer-bar ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="MinHeight" Value="3"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ColorOverlayMedium}"/>
    </Style>
    <Style Selector="Border.image-viewer-bar TextBlock.image-viewer-error">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <!-- An own message on its way is dimmed until the server has it; the rings of its files stay clear -->
    <Style Selector="Border.msg-root.pending :is(TextBlock).msg-body">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="Border.msg-root.pending Button.msg-reply, Border.msg-root.pending Border.msg-link">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <!-- Its mark in place of the receipt: a clock, or a red mark that opens the menu once it did not go -->
    <Style Selector=":is(UserControl).msg-status-mark">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style Selector="Button.msg-send-status">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="8,2,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="9"/>
        <!-- Only the mark itself: the plate, border and states of the global button styles would draw a square
             around the round mark, and a frame under the pointer -->
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  Background="Transparent"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
            </ControlTemplate>
        </Setter>
    </Style>


    <!-- ===== Who wrote a message and when, in the list: the first message of a run shows the avatar and the
         header, the others their time in place of the avatar ===== -->
    <Style Selector="Border.msg-root :is(Control).msg-avatar">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style Selector="Border.msg-root.seq-start :is(Control).msg-avatar">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.msg-root StackPanel.msg-header">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.msg-root.seq-start StackPanel.msg-header">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- As wide as the avatar, so the time sits under its center -->
    <Style Selector="Border.msg-root Panel.msg-continuation-time">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style Selector="Border.msg-root.seq-start Panel.msg-continuation-time">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.msg-root StackPanel.msg-trailing">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <!-- The parts of a bubble are not drawn in the list -->
    <Style Selector="Border.msg-root StackPanel.msg-bubble-meta, Border.msg-root Path.msg-tail">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- ===== Bubbles, as in Telegram: the list of the chat carries the class "bubbles" ===== -->
    <Style Selector=".bubbles Border.msg-root">
        <Setter Property="Padding" Value="6,1,14,1"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.seq-start">
        <Setter Property="Padding" Value="6,6,14,1"/>
    </Style>
    <!-- A bubble needs no row highlight under the pointer or the menu; a jump to it still shows where it is -->
    <Style Selector=".bubbles Border.msg-root, .bubbles Border.msg-root:pointerover, .bubbles Border.msg-root:pressed, .bubbles Border.msg-root.has-opened-flyout, .bubbles Border.msg-root.mentioned">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.highlighted">
        <Setter Property="Background" Value="{DynamicResource MsgHighlightBrush}"/>
    </Style>

    <!-- The avatar of the others stands at the last bubble of their run; a direct chat has none -->
    <Style Selector=".bubbles Border.msg-root :is(Control).msg-avatar">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.seq-end:not(.mine):not(.direct) :is(Control).msg-avatar">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- Keeps the room of the avatar under the bubbles of a run of the others, unseen -->
    <Style Selector=".bubbles Border.msg-root Panel.msg-continuation-time">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root:not(.mine):not(.direct) Panel.msg-continuation-time">
        <Setter Property="IsVisible" Value="True"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- The name of the others opens their run, in groups and channels; the time is in the bubble -->
    <Style Selector=".bubbles Border.msg-root StackPanel.msg-header">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.seq-start:not(.mine):not(.direct) StackPanel.msg-header">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=".bubbles StackPanel.msg-header TextBlock.msg-time">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".bubbles Panel.msg-status-column">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- The bubble: the user's own on the right -->
    <Style Selector=".bubbles Panel.msg-bubble-host">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="MaxWidth" Value="560"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Panel.msg-bubble-host">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector=".bubbles Border.msg-bubble">
        <Setter Property="Padding" Value="10,6,10,5"/>
        <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="6,16,16,6"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.seq-start Border.msg-bubble">
        <Setter Property="CornerRadius" Value="16,16,16,6"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.seq-end Border.msg-bubble">
        <Setter Property="CornerRadius" Value="6,16,16,0"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.seq-start.seq-end Border.msg-bubble">
        <Setter Property="CornerRadius" Value="16,16,16,0"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Border.msg-bubble">
        <Setter Property="Background" Value="{DynamicResource MsgBubbleMineBrush}"/>
        <Setter Property="CornerRadius" Value="16,6,6,16"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine.seq-start Border.msg-bubble">
        <Setter Property="CornerRadius" Value="16,16,6,16"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine.seq-end Border.msg-bubble">
        <Setter Property="CornerRadius" Value="16,6,0,16"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine.seq-start.seq-end Border.msg-bubble">
        <Setter Property="CornerRadius" Value="16,16,0,16"/>
    </Style>
    <!-- On its way: the bubble is dimmed, its text a little less -->
    <Style Selector=".bubbles Border.msg-root.mine.pending Border.msg-bubble">
        <Setter Property="Background" Value="{DynamicResource MsgBubbleMinePendingBrush}"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.pending :is(TextBlock).msg-body">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine :is(TextBlock).msg-body">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- A quote in the own bubble: a light plate with a white bar, as the accent bar would vanish in the accent bubble -->
    <Style Selector=".bubbles Border.msg-root.mine Button.msg-reply /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#26FFFFFF"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Button.msg-reply:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#38FFFFFF"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Button.msg-reply:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1AFFFFFF"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Border.msg-reply-body">
        <Setter Property="BorderBrush" Value="White"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Button.msg-reply TextBlock.msg-reply-username, .bubbles Border.msg-root.mine Button.msg-reply TextBlock.msg-reply-text">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- The tail of the last bubble of a run, on the side of its author -->
    <Style Selector=".bubbles Border.msg-root.seq-end Path.msg-tail">
        <Setter Property="IsVisible" Value="True"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="-8,0,0,0"/>
        <Setter Property="RenderTransform" Value="scale(-1, 1)"/>
        <Setter Property="Fill" Value="{DynamicResource DarkBackgroundBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine.seq-end Path.msg-tail">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,-8,0"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Fill" Value="{DynamicResource MsgBubbleMineBrush}"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine.pending.seq-end Path.msg-tail">
        <Setter Property="Fill" Value="{DynamicResource MsgBubbleMinePendingBrush}"/>
    </Style>

    <!-- The time and mark inside the bubble: after the last word, or on a line of their own without text -->
    <Style Selector=".bubbles StackPanel.msg-bubble-meta">
        <Setter Property="IsVisible" Value="True"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="3"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="4,0,0,-1"/>
    </Style>
    <Style Selector=".bubbles StackPanel.msg-meta-row">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.has-text StackPanel.msg-meta-row">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="StackPanel.msg-bubble-meta TextBlock.msg-bubble-time">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorOverlayGray}"/>
    </Style>
    <Style Selector="StackPanel.msg-bubble-meta Viewbox.msg-bubble-receipt">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.msg-bubble-meta Path.msg-bubble-check">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorOverlayGray}"/>
        <Setter Property="StrokeThickness" Value="2.2"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
    </Style>
    <Style Selector="StackPanel.msg-bubble-meta Button.msg-send-status.in-bubble">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.msg-bubble-meta :is(UserControl).msg-bubble-status">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorOverlayGray}"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine StackPanel.msg-bubble-meta TextBlock.msg-bubble-time">
        <Setter Property="Foreground" Value="{DynamicResource MsgBubbleMineMetaBrush}"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine StackPanel.msg-bubble-meta Path.msg-bubble-check, .bubbles Border.msg-root.mine Path.msg-edited">
        <Setter Property="Stroke" Value="{DynamicResource MsgBubbleMineMetaBrush}"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine StackPanel.msg-bubble-meta :is(UserControl).msg-bubble-status">
        <Setter Property="Foreground" Value="{DynamicResource MsgBubbleMineMetaBrush}"/>
    </Style>
    <!-- Read: the second check in full white on the own bubble -->
    <Style Selector=".bubbles Border.msg-root.mine StackPanel.msg-bubble-meta Viewbox.msg-bubble-receipt:nth-child(3) Path.msg-bubble-check">
        <Setter Property="Stroke" Value="White"/>
    </Style>

    <!-- The date between the messages: two lines in the list, a pill among bubbles -->
    <Style Selector="Border.date-pill">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,10"/>
        <Setter Property="Padding" Value="10,3,10,4"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}"/>
    </Style>
    <Style Selector=".bubbles Border.date-pill">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=".bubbles Grid.date-lines">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- ===== Pictures, files and players in a bubble ===== -->
    <!-- The album meets the side edges of the bubble, and its top edge when nothing stands above it: no quote,
         and no name, which only the first bubble of a run of the others in a group has -->
    <Style Selector=".bubbles Border.msg-media-frame">
        <Setter Property="Margin" Value="-10,0,-10,0"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.media-lead.mine Border.msg-media-frame, .bubbles Border.msg-root.media-lead.direct Border.msg-media-frame, .bubbles Border.msg-root.media-lead:not(.seq-start) Border.msg-media-frame">
        <Setter Property="Margin" Value="-10,-6,-10,0"/>
    </Style>
    <!-- ... and its bottom edge when nothing follows it -->
    <Style Selector=".bubbles Border.msg-root.media-end:not(.has-reactions):not(.pinned) Panel.msg-media">
        <Setter Property="Margin" Value="0,0,0,-5"/>
    </Style>
    <!-- The bubble rounds the album with its own corners -->
    <Style Selector=".bubbles Border.msg-root.has-album Border.msg-bubble">
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector=".bubbles Border.msg-album">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- Only pictures or videos: no tail, and the corner it grew from is rounded as the others -->
    <Style Selector=".bubbles Border.msg-root.media-only Path.msg-tail">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.media-only.seq-end Border.msg-bubble">
        <Setter Property="CornerRadius" Value="6,16,16,16"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.media-only.seq-start.seq-end Border.msg-bubble">
        <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.media-only.mine.seq-end Border.msg-bubble">
        <Setter Property="CornerRadius" Value="16,6,16,16"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.media-only.mine.seq-start.seq-end Border.msg-bubble">
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- Nothing after the pictures: the time and mark lie on them, white on a dark plate, instead of a line
         of their own -->
    <Style Selector=".bubbles Border.msg-root.media-end :is(Control).msg-meta-row">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.media-end Border.msg-media-meta">
        <Setter Property="IsVisible" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="6,1,6,2"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="#80000000"/>
    </Style>
    <Style Selector=".bubbles Border.msg-media-meta StackPanel.msg-bubble-meta">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector=".bubbles Border.msg-media-meta TextBlock.msg-bubble-time">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector=".bubbles Border.msg-media-meta Path.msg-bubble-check">
        <Setter Property="Stroke" Value="White"/>
    </Style>
    <Style Selector=".bubbles Border.msg-media-meta :is(UserControl).msg-bubble-status">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Files: no plate of their own on the bubble, a round icon in the accent; on the own bubble in white -->
    <Style Selector=".bubbles Button.msg-file">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="Width" Value="NaN"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="MaxWidth" Value="320"/>
    </Style>
    <Style Selector=".bubbles Button.msg-file:pointerover">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector=".bubbles Button.msg-file:pointerover TextBlock.msg-file-name">
        <Setter Property="TextDecorations" Value="Underline"/>
    </Style>
    <Style Selector=".bubbles Button.msg-file Border.msg-file-icon">
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Button.msg-file Border.msg-file-icon">
        <Setter Property="Background" Value="#33FFFFFF"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Button.msg-file TextBlock.msg-file-name">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Button.msg-file TextBlock.msg-file-size">
        <Setter Property="Foreground" Value="{DynamicResource MsgBubbleMineMetaBrush}"/>
    </Style>

    <!-- Players: the bubble is their plate, and a video goes without its name, as a picture does -->
    <Style Selector=".bubbles Border.msg-audio-card, .bubbles Border.msg-video-card">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector=".bubbles Grid.msg-video-title">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".bubbles Border.msg-root.mine Border.msg-audio-card TextBlock, .bubbles Border.msg-root.mine Border.msg-video-card TextBlock">
        <Setter Property="Foreground" Value="White"/>
    </Style>
</Styles>
